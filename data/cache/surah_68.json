[{"number": 68, "name": "سُورَةُ القَلَمِ", "englishName": "Al-Qalam", "englishNameTranslation": "The Pen", "revelationType": "Meccan", "numberOfAyahs": 52, "ayahs": [{"number": 5272, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5273, "text": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5274, "text": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5275, "text": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5276, "text": "فَسَتُبْصِرُ وَيُبْصِرُونَ", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5277, "text": "بِأَييِّكُمُ ٱلْمَفْتُونُ", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5278, "text": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5279, "text": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5280, "text": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5281, "text": "وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5282, "text": "هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5283, "text": "مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5284, "text": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5285, "text": "أَن كَانَ ذَا مَالٍۢ وَبَنِينَ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5286, "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5287, "text": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5288, "text": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5289, "text": "وَلَا يَسْتَثْنُونَ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5290, "text": "فَطَافَ عَلَيْهَا طَآئِفٌۭ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5291, "text": "فَأَصْبَحَتْ كَٱلصَّرِيمِ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5292, "text": "فَتَنَادَوْا۟ مُصْبِحِينَ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5293, "text": "أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5294, "text": "فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5295, "text": "أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌۭ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5296, "text": "وَغَدَوْا۟ عَلَىٰ حَرْدٍۢ قَٰدِرِينَ", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5297, "text": "فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5298, "text": "بَلْ نَحْنُ مَحْرُومُونَ", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5299, "text": "قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5300, "text": "قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5301, "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَلَٰوَمُونَ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5302, "text": "قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5303, "text": "عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًۭا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5304, "text": "كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5305, "text": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5306, "text": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5307, "text": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5308, "text": "أَمْ لَكُمْ كِتَٰبٌۭ فِيهِ تَدْرُسُونَ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5309, "text": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5310, "text": "أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5311, "text": "سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5312, "text": "أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5313, "text": "يَوْمَ يُكْشَفُ عَن سَاقٍۢ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5314, "text": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5315, "text": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5316, "text": "وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5317, "text": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5318, "text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5319, "text": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌۭ", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5320, "text": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌۭ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌۭ", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5321, "text": "فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5322, "text": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌۭ", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5323, "text": "وَمَا هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 68, "name": "سُورَةُ القَلَمِ", "englishName": "Al-Qalam", "englishNameTranslation": "The Pen", "revelationType": "Meccan", "numberOfAyahs": 52, "ayahs": [{"number": 5272, "text": "نٓ۔ قلم کی اور جو (اہل قلم) لکھتے ہیں اس کی قسم", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5273, "text": "کہ (اے محمدﷺ) تم اپنے پروردگار کے فضل سے دیوانے نہیں ہو", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5274, "text": "اور تمہارے لئے بے انتہا اجر ہے", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5275, "text": "اور اخلاق تمہارے بہت (عالی) ہیں", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5276, "text": "سو عنقریب تم بھی دیکھ لو گے اور یہ (کافر) بھی دیکھ لیں گے", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5277, "text": "کہ تم میں سے کون دیوانہ ہے", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5278, "text": "تمہارا پروردگار اس کو بھی خوب جانتا ہے جو اس کے رستے سے بھٹک گیا اور ان کو بھی خوب جانتا ہے جو سیدھے راستے پر چل رہے ہیں", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5279, "text": "تو تم جھٹلانے والوں کا کہا نہ ماننا", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5280, "text": "یہ لوگ چاہتے ہیں کہ تم نرمی اختیار کرو تو یہ بھی نرم ہوجائیں", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5281, "text": "اور کسی ایسے شخص کے کہے میں نہ آجانا جو بہت قسمیں کھانے والا ذلیل اوقات ہے", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5282, "text": "طعن آمیز اشارتیں کرنے والا چغلیاں لئے پھرنے والا", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5283, "text": "مال میں بخل کرنے والا حد سے بڑھا ہوا بدکار", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5284, "text": "سخت خو اور اس کے علاوہ بدذات ہے", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5285, "text": "اس سبب سے کہ مال اور بیٹے رکھتا ہے", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5286, "text": "جب اس کو ہماری آیتیں پڑھ کر سنائی جاتی ہیں تو کہتا ہے کہ یہ اگلے لوگوں کے افسانے ہیں", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5287, "text": "ہم عنقریب اس کی ناک پر داغ لگائیں گے", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5288, "text": "ہم نے ان لوگوں کی اسی طرح آزمائش کی ہے جس طرح باغ والوں کی آزمائش کی تھی۔ جب انہوں نے قسمیں کھا کھا کر کہا کہ صبح ہوتے ہوتے ہم اس کا میوہ توڑ لیں گے", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5289, "text": "اور انشاء الله نہ کہا", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5290, "text": "سو وہ ابھی سو ہی رہے تھے کہ تمہارے پروردگار کی طرف سے (راتوں رات) اس پر ایک آفت پھر گئی", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5291, "text": "تو وہ ایسا ہوگیا جیسے کٹی ہوئی کھیتی", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5292, "text": "جب صبح ہوئی تو وہ لوگ ایک دوسرے کو پکارنے لگے", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5293, "text": "اگر تم کو کاٹنا ہے تو اپنی کھیتی پر سویرے ہی جا پہنچو", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5294, "text": "تو وہ چل پڑے اور آپس میں چپکے چپکے کہتے جاتے تھے", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5295, "text": "آج یہاں تمہارے پاس کوئی فقیر نہ آنے پائے", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5296, "text": "اور کوشش کے ساتھ سویرے ہی جا پہنچے (گویا کھیتی پر) قادر ہیں", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5297, "text": "جب باغ کو دیکھا تو (ویران) کہنے لگے کہ ہم رستہ بھول گئے ہیں", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5298, "text": "نہیں بلکہ ہم (برگشتہ نصیب) بےنصیب ہیں", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5299, "text": "ایک جو اُن میں فرزانہ تھا بولا کہ کیا میں نے تم سے نہیں کہا تھا کہ تم تسبیح کیوں نہیں کرتے؟", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5300, "text": "(تب) وہ کہنے لگے کہ ہمارا پروردگار پاک ہے بےشک ہم ہی قصوروار تھے", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5301, "text": "پھر لگے ایک دوسرے کو رو در رو ملامت کرنے", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5302, "text": "کہنے لگے ہائے شامت ہم ہی حد سے بڑھ گئے تھے", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5303, "text": "امید ہے کہ ہمارا پروردگار اس کے بدلے میں ہمیں اس سے بہتر باغ عنایت کرے ہم اپنے پروردگار کی طرف سے رجوع لاتے ہیں", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5304, "text": "(دیکھو) عذاب یوں ہوتا ہے۔ اور آخرت کا عذاب اس سے کہیں بڑھ کر ہے۔ کاش! یہ لوگ جانتے ہوتے", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5305, "text": "پرہیزگاروں کے لئے ان کے پروردگار کے ہاں نعمت کے باغ ہیں", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5306, "text": "کیا ہم فرمانبرداروں کو نافرمانوں کی طرف (نعمتوں سے) محروم کردیں گے؟", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5307, "text": "تمہیں کیا ہوگیا ہے کیسی تجویزیں کرتے ہو؟", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5308, "text": "کیا تمہارے پاس کوئی کتاب ہے جس میں (یہ) پڑھتے ہو", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5309, "text": "کہ جو چیز تم پسند کرو گے وہ تم کو ضرور ملے گی", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5310, "text": "یا تم نے ہم سے قسمیں لے رکھی ہیں جو قیامت کے دن تک چلی جائیں گی کہ جس شے کا تم حکم کرو گے وہ تمہارے لئے حاضر ہوگی", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5311, "text": "ان سے پوچھو کہ ان میں سے اس کا کون ذمہ لیتا ہے؟", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5312, "text": "کیا (اس قول میں) ان کے اور بھی شریک ہیں؟ اگر یہ سچے ہیں تو اپنے شریکوں کو لا سامنے کریں", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5313, "text": "جس دن پنڈلی سے کپڑا اٹھا دیا جائے گا اور کفار سجدے کے لئے بلائے جائیں گے تو سجدہ نہ کرسکیں گے", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5314, "text": "ان کی آنکھیں جھکی ہوئی ہوں گی اور ان پر ذلت چھا رہی ہوگی حالانکہ پہلے (اُس وقت) سجدے کے لئے بلاتے جاتے تھے جب کہ صحیح وسالم تھے", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5315, "text": "تو مجھ کو اس کلام کے جھٹلانے والوں سے سمجھ لینے دو۔ ہم ان کو آہستہ آہستہ ایسے طریق سے پکڑیں گے کہ ان کو خبر بھی نہ ہوگی", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5316, "text": "اور میں ان کو مہلت دیئے جاتا ہوں میری تدبیر قوی ہے", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5317, "text": "کیا تم ان سے کچھ اجر مانگتے ہو کہ ان پر تاوان کا بوجھ پڑ رہا ہے", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5318, "text": "یا ان کے پاس غیب کی خبر ہے کہ (اسے) لکھتے جاتے ہیں", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5319, "text": "تو اپنے پروردگار کے حکم کے انتظار میں صبر کئے رہو اور مچھلی (کا لقمہ ہونے) والے یونس کی طرح رہو نا کہ انہوں نے (خدا) کو پکارا اور وہ (غم و) غصے میں بھرے ہوئے تھے", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5320, "text": "اگر تمہارے پروردگار کی مہربانی ان کی یاوری نہ کرتی تو وہ چٹیل میدان میں ڈال دیئے جاتے اور ان کا حال ابتر ہوجاتا", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5321, "text": "پھر پروردگار نے ان کو برگزیدہ کرکے نیکوکاروں میں کرلیا", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5322, "text": "اور کافر جب (یہ) نصیحت (کی کتاب) سنتے ہیں تو یوں لگتے ہیں کہ تم کو اپنی نگاہوں سے پھسلا دیں گے اور کہتے یہ تو دیوانہ ہے", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5323, "text": "اور (لوگو) یہ (قرآن) اہل عالم کے لئے نصیحت ہے", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 68, "name": "سُورَةُ القَلَمِ", "englishName": "Al-Qalam", "englishNameTranslation": "The Pen", "revelationType": "Meccan", "numberOfAyahs": 52, "ayahs": [{"number": 5272, "text": "Noon; walqalami wa maa yasturoon", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5273, "text": "Maa anta bini'mati Rabbika bimajnoon", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5274, "text": "Wa inna laka la ajran ghaira mamnoon", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5275, "text": "Wa innaka la'alaa khuluqin 'azeem", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5276, "text": "Fasatubsiru wa yubsiroon", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5277, "text": "Bi ayyikumul maftoon", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5278, "text": "Innaa Rabbaka Huwa a'lamu biman dalla 'an sabeelihee wa Huwa a'lamu bilmuhtadeen", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5279, "text": "Falaa tuti'il mukazzibeen", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5280, "text": "Waddoo law tudhinu fa-yudhinoon", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5281, "text": "Wa laa tuti' kulla hallaa fim maheen", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5282, "text": "Hammaazim mash shaaa'im binameem", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5283, "text": "Mannaa'il lilkhairi mu'tadin aseem", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5284, "text": "'Utullim ba'da zaalika zaneem", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5285, "text": "An kaana zaa maalinw-wa baneen", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5286, "text": "Izaa tutlaa 'alaihi aayaatunaa qaala asaateerul awwaleen", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5287, "text": "Sanasimuhoo 'alal khurtoom", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5288, "text": "Innaa balawnaahum kamaa balawnaaa As-haabal jannati iz 'aqsamoo la-yasri munnahaa musbiheen", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5289, "text": "Wa laa yastasnoon", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5290, "text": "Fataafa 'alaihaa taaa'i fum mir rabbika wa hum naaa'imoon", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5291, "text": "Fa asbahat kassareem", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5292, "text": "Fatanaadaw musbiheen", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5293, "text": "Anighdoo 'alaa harsikum in kuntum saarimeen", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5294, "text": "Fantalaqoo wa hum yatakhaafatoon", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5295, "text": "Al laa yadkhulannahal yawma 'alaikum miskeen", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5296, "text": "Wa ghadaw 'alaa hardin qaadireen", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5297, "text": "Falammaa ra awhaa qaalooo innaa ladaaalloon", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5298, "text": "Bal nahnu mahroomoon", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5299, "text": "Qaala awsatuhum alam aqul lakum law laa tusabbihoon", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5300, "text": "Qaaloo subhaana rabbinaaa innaa kunnaa zaalimeen", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5301, "text": "Fa aqbala ba'duhum 'alaa ba'diny yatalaawamoon", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5302, "text": "Qaaloo yaa wailanaaa innaa kunnaa taagheen", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5303, "text": "'Asaa rabbunaaa any yubdilanaa khairam minhaaa innaaa ilaa rabbinaa raaghiboon", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5304, "text": "Kazaalikal azaab, wa la'azaabul aakhirati akbar; law kaanoo ya'lamoon", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5305, "text": "Inna lilmuttaqeena 'inda rabbihim jannaatin na'eem", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5306, "text": "Afanaj'alul muslimeena kalmujrimeen", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5307, "text": "Maa lakum kaifa tahhkumoon", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5308, "text": "Am lakum kitaabun feehi tadrusoon", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5309, "text": "Inna lakum feehi lamaa takhaiyaroon", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5310, "text": "Am lakum aymaanun 'alainaa baalighatun ilaa yawmil qiyaamati inna lakum lamaa tahkumoon", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5311, "text": "Salhum ayyuhum bizaa lika za'eem", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5312, "text": "Am lahum shurakaaa'u falyaatoo bishurakaaa 'ihim in kaanoo saadiqeen", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5313, "text": "Yawma yukshafu 'am saaqinw wa yud'awna ilas sujoodi falaa yastatee'oon", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5314, "text": "Khaashi'atan absaaruhum tarhaquhum zillatunw wa qad kaanoo yud'awna ilassujoodi wa hum saalimoon", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5315, "text": "Fazarnee wa many yukazzibu bihaazal hadeesi sanastad rijuhum min haisu laa ya'lamoon", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5316, "text": "Wa umlee lahum; inna kaidee mateen", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5317, "text": "Am tas'aluhum ajran fahum mim maghramim musqaloon", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5318, "text": "Am 'indahumul ghaibu fahum yaktuboon", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5319, "text": "Fasbir lihkmi rabbika wa laa takun kasaahibil boot; iz naadaa wa huwa makzoom", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5320, "text": "Law laaa an tadaara kahoo ni'matum mir rabbihee lanubiza bil'araaa'i wa huwa mazmoom", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5321, "text": "Fajtabaahu rabbuhoo faja'alahoo minas saaliheen", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5322, "text": "Wa iny-yakaadul lazeena kafaroo la-yuzliqoonaka biabsaarihim lammaa saml'uz-Zikra wa yaqooloona innahoo lamajnoon", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5323, "text": "Wa maa huwa illaa zikrul lil'aalameen", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]