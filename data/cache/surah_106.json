[{"number": 106, "name": "سُورَةُ قُرَيۡشٍ", "englishName": "Quraish", "englishNameTranslation": "Quraysh", "revelationType": "Meccan", "numberOfAyahs": 4, "ayahs": [{"number": 6194, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}, {"number": 6195, "text": "إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}, {"number": 6196, "text": "فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}, {"number": 6197, "text": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 106, "name": "سُورَةُ قُرَيۡشٍ", "englishName": "Quraish", "englishNameTranslation": "Quraysh", "revelationType": "Meccan", "numberOfAyahs": 4, "ayahs": [{"number": 6194, "text": "قریش کے مانوس کرنے کے سبب", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}, {"number": 6195, "text": "(یعنی) ان کو جاڑے اور گرمی کے سفر سے مانوس کرنے کے سبب", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}, {"number": 6196, "text": "لوگوں کو چاہیئے کہ (اس نعمت کے شکر میں) اس گھر کے مالک کی عبادت کریں", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}, {"number": 6197, "text": "جس نے ان کو بھوک میں کھانا کھلایا اور خوف سے امن بخشا", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 106, "name": "سُورَةُ قُرَيۡشٍ", "englishName": "Quraish", "englishNameTranslation": "Quraysh", "revelationType": "Meccan", "numberOfAyahs": 4, "ayahs": [{"number": 6194, "text": "Li-ilaafi quraish", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}, {"number": 6195, "text": "Elaafihim rihlatash shitaa-i wass saif", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}, {"number": 6196, "text": "Fal y'abudu rabba haazal-bait", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}, {"number": 6197, "text": "Allazi at'amahum min ju'inw-wa-aamana hum min khawf", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 602, "ruku": 548, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]