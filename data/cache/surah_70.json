[{"number": 70, "name": "سُورَةُ المَعَارِجِ", "englishName": "Al-Ma'aarij", "englishNameTranslation": "The Ascending Stairways", "revelationType": "Meccan", "numberOfAyahs": 44, "ayahs": [{"number": 5376, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5377, "text": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5378, "text": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5379, "text": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5380, "text": "فَٱصْبِرْ صَبْرًۭا جَمِيلًا", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5381, "text": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5382, "text": "وَنَرَىٰهُ قَرِيبًۭا", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5383, "text": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5384, "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5385, "text": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5386, "text": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5387, "text": "وَصَٰحِبَتِهِۦ وَأَخِيهِ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5388, "text": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5389, "text": "وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5390, "text": "كَلَّآ ۖ إِنَّهَا لَظَىٰ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5391, "text": "نَزَّاعَةًۭ لِّلشَّوَىٰ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5392, "text": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5393, "text": "وَجَمَعَ فَأَوْعَىٰٓ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5394, "text": "۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5395, "text": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5396, "text": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5397, "text": "إِلَّا ٱلْمُصَلِّينَ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5398, "text": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5399, "text": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5400, "text": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5401, "text": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5402, "text": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5403, "text": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5404, "text": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5405, "text": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5406, "text": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5407, "text": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5408, "text": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5409, "text": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5410, "text": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5411, "text": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5412, "text": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5413, "text": "أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5414, "text": "كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5415, "text": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5416, "text": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًۭا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5417, "text": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5418, "text": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًۭا كَأَنَّهُمْ إِلَىٰ نُصُبٍۢ يُوفِضُونَ", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5419, "text": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 70, "name": "سُورَةُ المَعَارِجِ", "englishName": "Al-Ma'aarij", "englishNameTranslation": "The Ascending Stairways", "revelationType": "Meccan", "numberOfAyahs": 44, "ayahs": [{"number": 5376, "text": "ایک طلب کرنے والے نے عذاب طلب کیا جو نازل ہو کر رہے گا", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5377, "text": "(یعنی) کافروں پر (اور) کوئی اس کو ٹال نہ سکے گا", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5378, "text": "(اور وہ) خدائے صاحب درجات کی طرف سے (نازل ہوگا)", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5379, "text": "جس کی طرف روح (الامین) اور فرشتے پڑھتے ہیں (اور) اس روز (نازل ہوگا) جس کا اندازہ پچاس ہزار برس کا ہوگا", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5380, "text": "(تو تم کافروں کی باتوں کو) قوت کے ساتھ برداشت کرتے رہو", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5381, "text": "وہ ان لوگوں کی نگاہ میں دور ہے", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5382, "text": "اور ہماری نظر میں نزدیک", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5383, "text": "جس دن آسمان ایسا ہو جائے گا جیسے پگھلا ہوا تانبا", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5384, "text": "اور پہاڑ (ایسے) جیسے (دھنکی ہوئی) رنگین اون", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5385, "text": "اور کوئی دوست کسی دوست کا پرسان نہ ہوگا", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5386, "text": "ایک دوسرے کو سامنے دیکھ رہے ہوں گے (اس روز) گنہگار خواہش کرے گا کہ کسی طرح اس دن کے عذاب کے بدلے میں (سب کچھ) دے دے یعنی اپنے بیٹے", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5387, "text": "اور اپنی بیوی اور اپنے بھائی", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5388, "text": "اور اپنا خاندان جس میں وہ رہتا تھا", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5389, "text": "اور جتنے آدمی زمین میں ہیں (غرض) سب (کچھ دے دے) اور اپنے تئیں عذاب سے چھڑا لے", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5390, "text": "(لیکن) ایسا ہرگز نہیں ہوگا وہ بھڑکتی ہوئی آگ ہے", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5391, "text": "کھال ادھیڑ ڈالنے والی", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5392, "text": "ان لوگوں کو اپنی طرف بلائے گی جنہوں نے (دین حق سے) اعراض کیا", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5393, "text": "اور (مال) جمع کیا اور بند کر رکھا", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5394, "text": "کچھ شک نہیں کہ انسان کم حوصلہ پیدا ہوا ہے", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5395, "text": "جب اسے تکلیف پہنچتی ہے تو گھبرا اٹھتا ہے", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5396, "text": "اور جب آسائش حاصل ہوتی ہے تو بخیل بن جاتا ہے", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5397, "text": "مگر نماز گزار", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5398, "text": "جو نماز کا التزام رکھتے (اور بلاناغہ پڑھتے) ہیں", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5399, "text": "اور جن کے مال میں حصہ مقرر ہے", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5400, "text": "(یعنی) مانگنے والے کا۔ اور نہ مانگے والے والا کا", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5401, "text": "اور جو روز جزا کو سچ سمجھتے ہیں", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5402, "text": "اور جو اپنے پروردگار کے عذاب سے خوف رکھتے ہیں", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5403, "text": "بےشک ان کے پروردگار کا عذاب ہے ہی ایسا کہ اس سے بےخوف نہ ہوا جائے", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5404, "text": "اور جو اپنی شرمگاہوں کی حفاظت کرتے ہیں", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5405, "text": "مگر اپنی بیویوں یا لونڈیوں سے کہ (ان کے پاس جانے پر) انہیں کچھ ملامت نہیں", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5406, "text": "اور جو لوگ ان کے سوا اور کے خواستگار ہوں وہ حد سے نکل جانے والے ہیں", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5407, "text": "اور جو اپنی امانتوں اور اقراروں کا پاس کرتے ہیں", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5408, "text": "اور جو اپنی شہادتوں پر قائم رہتے ہیں", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5409, "text": "اور جو اپنی نماز کی خبر رکھتے ہیں", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5410, "text": "یہی لوگ باغہائے بہشت میں عزت واکرام سے ہوں گے", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5411, "text": "تو ان کافروں کو کیا ہوا ہے کہ تمہاری طرف دوڑے چلے آتے ہیں", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5412, "text": "اور) دائیں بائیں سے گروہ گروہ ہو کر (جمع ہوتے جاتے ہیں)", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5413, "text": "کیا ان میں سے ہر شخص یہ توقع رکھتا ہے کہ نعمت کے باغ میں داخل کیا جائے گا", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5414, "text": "ہرگز نہیں۔ ہم نے ان کو اس چیز سے پیدا کیا ہے جسے وہ جانتے ہیں", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5415, "text": "ہمیں مشرقوں اور مغربوں کے مالک کی قسم کہ ہم طاقت رکھتے ہیں", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5416, "text": "(یعنی) اس بات پر (قادر ہیں) کہ ان سے بہتر لوگ بدل لائیں اور ہم عاجز نہیں ہیں", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5417, "text": "تو (اے پیغمبر) ان کو باطل میں پڑے رہنے اور کھیل لینے دو یہاں تک کہ جس دن کا ان سے وعدہ کیا جاتا ہے وہ ان کے سامنے آ موجود ہو", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5418, "text": "اس دن یہ قبر سے نکل کر (اس طرح) دوڑیں گے جیسے (شکاری) شکار کے جال کی طرف دوڑتے ہیں", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5419, "text": "ان کی آنکھیں جھک رہی ہوں گی اور ذلت ان پر چھا رہی ہوگی۔ یہی وہ دن ہے جس کا ان سے وعدہ کیا جاتا تھا", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 70, "name": "سُورَةُ المَعَارِجِ", "englishName": "Al-Ma'aarij", "englishNameTranslation": "The Ascending Stairways", "revelationType": "Meccan", "numberOfAyahs": 44, "ayahs": [{"number": 5376, "text": "Sa ala saaa'ilum bi'azaa binw-waaqi'", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5377, "text": "Lilkaafireen laisa lahoo daafi'", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5378, "text": "Minal laahi zil ma'aarij", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5379, "text": "Ta'rujul malaaa'ikatu war Roohu ilaihi fee yawmin kaana miqdaaruhoo khamseena alfa sanah", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5380, "text": "Fasbir ssabran jameelaa", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5381, "text": "Inaahum yarawnahoo ba'eedaa", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5382, "text": "Wa naraahu qareebaa", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5383, "text": "Yawma takoonus samaaa'u kalmuhl", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5384, "text": "Wa takoonul jibaalu kal'ihn", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5385, "text": "Wa laa yas'alu hameemun hameemaa", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 568, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5386, "text": "Yubassaroonahum; ya waddul mujrimu law yaftadee min 'azaabi yawma'izim bibaneeh", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5387, "text": "Wa saahibatihee wa akheeh", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5388, "text": "Wa faseelathil latee tu'weeh", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5389, "text": "Wa man fil ardi jamee'an summa yunjeeh", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5390, "text": "Kallaa innahaa lazaa", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5391, "text": "Nazzaa'atal lishshawaa", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5392, "text": "Tad'oo man adbara wa tawallaa", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5393, "text": "W jama'a fa aw'aa", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 227, "sajda": false}, {"number": 5394, "text": "Innal insaana khuliqa haloo'aa", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5395, "text": "Izaa massahush sharru jazoo'aa", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5396, "text": "Wa izaa massahul khairu manoo'aa", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5397, "text": "Illal musalleen", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5398, "text": "Allazeena hum 'alaa Salaatihim daaa'imoon", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5399, "text": "Wallazeena feee amwaalihim haqqum ma'loom", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5400, "text": "Lissaaa 'ili walmahroom", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5401, "text": "Wallazeena yusaddiqoona bi yawmid Deen", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5402, "text": "Wallazeena hum min 'azaabi Rabbihim mushfiqoon", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5403, "text": "Inna 'azaaba Rabbihim ghairu maamoon", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5404, "text": "Wallazeena hum lifuroo jihim haafizoon", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5405, "text": "Illaa 'alaaa azwaajihim aw maa malakat aymaanuhum fainnahum ghairu maloomeen", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5406, "text": "Famanib taghaa waraaa'a zaalika fa ulaaa'ika humul 'aadoon", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5407, "text": "Wallazeena hum li amaa naatihim wa 'ahdihim raa'oon", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5408, "text": "Wallazeena hum bishahaadaatihim qaaa'imoon", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5409, "text": "Wallazeena hum 'alaa salaatihim yuhaafizoon", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5410, "text": "Ulaaa'ika fee jannaatim mukramoon", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 569, "ruku": 502, "hizbQuarter": 228, "sajda": false}, {"number": 5411, "text": "Famaa lil lazeena kafaroo qibalaka muhti'een", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5412, "text": "'Anil yameeni wa 'anish shimaali 'izeen", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5413, "text": "Ayatma'u kullum ri'im minhum anyyudkhala jannata Na'eem", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5414, "text": "Kallaaa innaa khalaq nahum mimmaa ya'lamoon", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 569, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5415, "text": "Falaaa uqsimu bi Rabbil mashaariqi wal maghaaribi innaa laqaadiroon", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5416, "text": "'Alaaa an nubaddila khairam minhum wa maa Nahnu bimasbooqeen", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5417, "text": "Fazarhum yakhoodoo wa yal'aboo hattaa yulaaqoo yaw mahumul lazee yoo'adoon", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5418, "text": "Yawma yakhrujoona minal ajdaasi siraa'an ka anna hum ilaa nusubiny yoofidoon", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}, {"number": 5419, "text": "Khaashi'atan absaaruhum tarhaquhum zillah; zaalikal yawmul lazee kaanoo yoo'adoon", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 570, "ruku": 503, "hizbQuarter": 228, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]