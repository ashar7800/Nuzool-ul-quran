[{"number": 81, "name": "سُورَةُ التَّكۡوِيرِ", "englishName": "At-Takwir", "englishNameTranslation": "The Overthrowing", "revelationType": "Meccan", "numberOfAyahs": 29, "ayahs": [{"number": 5801, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5802, "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5803, "text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5804, "text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5805, "text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5806, "text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5807, "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5808, "text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5809, "text": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5810, "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5811, "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5812, "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5813, "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5814, "text": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5815, "text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5816, "text": "ٱلْجَوَارِ ٱلْكُنَّسِ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5817, "text": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5818, "text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5819, "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5820, "text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5821, "text": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5822, "text": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5823, "text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5824, "text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5825, "text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5826, "text": "فَأَيْنَ تَذْهَبُونَ", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5827, "text": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5828, "text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5829, "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 81, "name": "سُورَةُ التَّكۡوِيرِ", "englishName": "At-Takwir", "englishNameTranslation": "The Overthrowing", "revelationType": "Meccan", "numberOfAyahs": 29, "ayahs": [{"number": 5801, "text": "جب سورج لپیٹ لیا جائے گا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5802, "text": "جب تارے بےنور ہو جائیں گے", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5803, "text": "اور جب پہاڑ چلائے جائیں گے", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5804, "text": "اور جب بیانے والی اونٹنیاں بےکار ہو جائیں گی", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5805, "text": "اور جب وحشی جانور جمع اکٹھے ہو جائیں گے", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5806, "text": "اور جب دریا آگ ہو جائیں گے", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5807, "text": "اور جب روحیں (بدنوں سے) ملا دی جائیں گی", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5808, "text": "اور جب لڑکی سے جو زندہ دفنا دی گئی ہو پوچھا جائے گا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5809, "text": "کہ وہ کس گناہ پرماری گئی", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5810, "text": "اور جب (عملوں کے) دفتر کھولے جائیں گے", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5811, "text": "اور جب آسمانوں کی کھال کھینچ لی جائے گی", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5812, "text": "اور جب دوزخ (کی آگ) بھڑکائی جائے گی", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5813, "text": "اور بہشت جب قریب لائی جائے گی", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5814, "text": "تب ہر شخص معلوم کر لے گا کہ وہ کیا لے کر آیا ہے", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5815, "text": "ہم کو ان ستاروں کی قسم جو پیچھے ہٹ جاتے ہیں", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5816, "text": "(اور) جو سیر کرتے اور غائب ہو جاتے ہیں", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5817, "text": "اور رات کی قسم جب ختم ہونے لگتی ہے", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5818, "text": "اور صبح کی قسم جب نمودار ہوتی ہے", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5819, "text": "کہ بےشک یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5820, "text": "جو صاحب قوت مالک عرش کے ہاں اونچے درجے والا ہے", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5821, "text": "سردار (اور) امانت دار ہے", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5822, "text": "اور (مکے والو) تمہارے رفیق (یعنی محمدﷺ) دیوانے نہیں ہیں", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5823, "text": "بےشک انہوں نے اس (فرشتے) کو (آسمان کے کھلے یعنی) مشرقی کنارے پر دیکھا ہے", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5824, "text": "اور وہ پوشیدہ باتوں (کے ظاہر کرنے) میں بخیل نہیں", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5825, "text": "اور یہ شیطان مردود کا کلام نہیں", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5826, "text": "پھر تم کدھر جا رہے ہو", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5827, "text": "یہ تو جہان کے لوگوں کے لیے نصیحت ہے", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5828, "text": "(یعنی) اس کے لیے جو تم میں سے سیدھی چال چلنا چاہے", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5829, "text": "اور تم کچھ بھی نہیں چاہ سکتے مگر وہی جو خدائے رب العالمین چاہے", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 81, "name": "سُورَةُ التَّكۡوِيرِ", "englishName": "At-Takwir", "englishNameTranslation": "The Overthrowing", "revelationType": "Meccan", "numberOfAyahs": 29, "ayahs": [{"number": 5801, "text": "Izash shamsu kuwwirat", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5802, "text": "Wa izan nujoomun kadarat", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5803, "text": "Wa izal jibaalu suyyirat", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5804, "text": "Wa izal 'ishaaru 'uttilat", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5805, "text": "Wa izal wuhooshu hushirat", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5806, "text": "Wa izal bihaaru sujjirat", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5807, "text": "Wa izan nufoosu zuwwijat", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5808, "text": "Wa izal maw'oodatu su'ilat", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5809, "text": "Bi ayyi zambin qutilat", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5810, "text": "Wa izas suhufu nushirat", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5811, "text": "Wa izas samaaa'u kushitat", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5812, "text": "Wa izal jaheemu su'-'irat", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5813, "text": "Wa izal jannatu uzlifat", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5814, "text": "'Alimat nafsum maaa ahdarat", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5815, "text": "Falaaa uqsimu bil khunnas", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5816, "text": "Al jawaaril kunnas", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5817, "text": "Wallaili izaa 'as'as", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5818, "text": "Wassubhi izaa tanaffas", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5819, "text": "Innahoo laqawlu rasoolin kareem", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5820, "text": "Zee quwwatin 'inda zil 'arshi makeen", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5821, "text": "Mutaa'in samma ameen", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5822, "text": "Wa maa saahibukum bimajnoon", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5823, "text": "Wa laqad ra aahu bilufuqil mubeen", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5824, "text": "Wa maa huwa 'alal ghaibi bidaneen", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5825, "text": "Wa maa huwa biqawli shaitaanir rajeem", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5826, "text": "Fa ayna tazhaboon", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5827, "text": "In huwa illaa zikrul lil'aalameen", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5828, "text": "Liman shaaa'a minkum ai yastaqeem", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5829, "text": "Wa maa tashaaa'oona illaaa ai yashaaa 'al laahu Rabbul 'Aalameen", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]