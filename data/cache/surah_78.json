[{"number": 78, "name": "سُورَةُ النَّبَإِ", "englishName": "An-Naba", "englishNameTranslation": "The Announcement", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5673, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5674, "text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5675, "text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5676, "text": "كَلَّا سَيَعْلَمُونَ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5677, "text": "ثُمَّ كَلَّا سَيَعْلَمُونَ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5678, "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5679, "text": "وَٱلْجِبَالَ أَوْتَادًۭا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5680, "text": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5681, "text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5682, "text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5683, "text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5684, "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5685, "text": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5686, "text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5687, "text": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5688, "text": "وَجَنَّٰتٍ أَلْفَافًا", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5689, "text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5690, "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5691, "text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5692, "text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5693, "text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5694, "text": "لِّلطَّٰغِينَ مَـَٔابًۭا", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5695, "text": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5696, "text": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5697, "text": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5698, "text": "جَزَآءًۭ وِفَاقًا", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5699, "text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5700, "text": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5701, "text": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5702, "text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5703, "text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5704, "text": "حَدَآئِقَ وَأَعْنَٰبًۭا", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5705, "text": "وَكَوَاعِبَ أَتْرَابًۭا", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5706, "text": "وَكَأْسًۭا دِهَاقًۭا", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5707, "text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5708, "text": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5709, "text": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5710, "text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5711, "text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5712, "text": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 78, "name": "سُورَةُ النَّبَإِ", "englishName": "An-Naba", "englishNameTranslation": "The Announcement", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5673, "text": "(یہ) لوگ کس چیز کی نسبت پوچھتے ہیں؟", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5674, "text": "(کیا) بڑی خبر کی نسبت؟", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5675, "text": "جس میں یہ اختلاف کر رہے ہیں", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5676, "text": "دیکھو یہ عنقریب جان لیں گے", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5677, "text": "پھر دیکھو یہ عنقریب جان لیں گے", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5678, "text": "کیا ہم نے زمین کو بچھونا نہیں بنایا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5679, "text": "اور پہاڑوں کو (ا س کی) میخیں (نہیں ٹھہرایا؟)", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5680, "text": "(بے شک بنایا) اور تم کو جوڑا جوڑابھی پیدا کیا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5681, "text": "اور نیند کو تمہارے لیے (موجب) آرام بنایا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5682, "text": "اور رات کو پردہ مقرر کیا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5683, "text": "اور دن کو معاش (کا وقت) قرار دیا", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5684, "text": "اور تمہارے اوپر سات مضبوط (آسمان) بنائے", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5685, "text": "اور (آفتاب کا) روشن چراغ بنایا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5686, "text": "اور نچڑتے بادلوں سے موسلا دھار مینہ برسایا", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5687, "text": "تاکہ اس سے اناج اور سبزہ پیدا کریں", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5688, "text": "اور گھنے گھنے باغ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5689, "text": "بےشک فیصلہ کا دن مقرر ہے", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5690, "text": "جس دن صور پھونکا جائے گا تو تم لوگ غٹ کے غٹ آ موجود ہو گے", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5691, "text": "اور آسمان کھولا جائے گا تو (اس میں) دروازے ہو جائیں گے", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5692, "text": "اور پہاڑ چلائے جائیں گے تو وہ ریت ہو کر رہ جائیں گے", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5693, "text": "بےشک دوزخ گھات میں ہے", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5694, "text": "(یعنی) سرکشوں کا وہی ٹھکانہ ہے", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5695, "text": "اس میں وہ مدتوں پڑے رہیں گے", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5696, "text": "وہاں نہ ٹھنڈک کا مزہ چکھیں گے۔ نہ (کچھ) پینا (نصیب ہو گا)", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5697, "text": "مگر گرم پانی اور بہتی پیپ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5698, "text": "(یہ) بدلہ ہے پورا پورا", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5699, "text": "یہ لوگ حساب (آخرت) کی امید ہی نہیں رکھتے تھے", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5700, "text": "اور ہماری آیتوں کو جھوٹ سمجھ کر جھٹلاتے رہتے تھے", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5701, "text": "اور ہم نے ہر چیز کو لکھ کر ضبط کر رکھا ہے", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5702, "text": "سو (اب) مزہ چکھو۔ ہم تم پر عذاب ہی بڑھاتے جائیں گے", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5703, "text": "بے شک پرہیز گاروں کے لیے کامیابی ہے", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5704, "text": "(یعنی) باغ اور انگور", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5705, "text": "اور ہم عمر نوجوان عورتیں", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5706, "text": "اور شراب کے چھلکتے ہوئے گلاس", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5707, "text": "وہاں نہ بیہودہ بات سنیں گے نہ جھوٹ (خرافات)", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5708, "text": "یہ تمہارے پروردگار کی طرف سے صلہ ہے انعام کثیر", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5709, "text": "وہ جو آسمانوں اور زمین اور جو ان دونوں میں ہے سب کا مالک ہے بڑا مہربان کسی کو اس سے بات کرنے کا یارا نہیں ہوگا", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5710, "text": "جس دن روح (الامین) اور فرشتے صف باندھ کر کھڑے ہوں گے تو کوئی بول نہ سکے گا مگر جس کو (خدائے رحمٰن) اجازت بخشے اور اس نے بات بھی درست کہی ہو", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5711, "text": "یہ دن برحق ہے۔ پس جو شخص چاہے اپنے پروردگار کے پاس ٹھکانہ بنا ئے", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5712, "text": "ہم نے تم کو عذاب سے جو عنقریب آنے والا ہے آگاہ کر دیا ہے جس دن ہر شخص ان (اعمال) کو جو اس نے آگے بھیجے ہوں گے دیکھ لے گا اور کافر کہے گا کہ اے کاش میں مٹی ہوتا", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 78, "name": "سُورَةُ النَّبَإِ", "englishName": "An-Naba", "englishNameTranslation": "The Announcement", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5673, "text": "'Amma Yatasaa-aloon", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5674, "text": "'Anin-nabaa-il 'azeem", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5675, "text": "Allazi hum feehi mukh talifoon", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5676, "text": "Kallaa sa y'alamoon", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5677, "text": "Thumma kallaa sa y'alamoon", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5678, "text": "Alam naj'alil arda mihaa da", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5679, "text": "Wal jibaala au taada", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5680, "text": "Wa khalaq naakum azwaaja", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5681, "text": "Waja'alnan naumakum subata", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5682, "text": "Waja'alnal laila libasa", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5683, "text": "Waja'alnan nahara ma 'aasha", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5684, "text": "Wa banaina fauqakum sab 'an shi daada", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5685, "text": "Waja'alna siraajaw wah haaja", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5686, "text": "Wa anzalna minal m'usiraati maa-an saj-jaaja", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5687, "text": "Linukh rija bihee habbaw wana baata", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5688, "text": "Wa jan naatin alfafa", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5689, "text": "Inna yaumal-fasli kana miqaata", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5690, "text": "Yauma yun fakhu fis-soori fataa toona afwaaja", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5691, "text": "Wa futiha tis samaa-u fakaanat abwaaba", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5692, "text": "Wa suyyi raatil jibaalu fa kaanat saraaba", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5693, "text": "Inna jahan nama kaanat mirsaada", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5694, "text": "Lit taa gheena ma aaba", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5695, "text": "Laa bitheena feehaa ahqaaba", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5696, "text": "Laa ya zooqoona feeha bar daw walaa sharaaba", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5697, "text": "Illa hamee maw-wa ghas saaqa", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5698, "text": "Jazaa-aw wi faaqa", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5699, "text": "Innahum kaanu laa yarjoona hisaaba", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5700, "text": "Wa kazzabu bi aayaa tina kizzaba", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5701, "text": "Wa kulla shai-in ahsai naahu kitaa ba", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5702, "text": "Fa zooqoo falan-nazee dakum ill-laa azaaba", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5703, "text": "Inna lil mutta qeena mafaaza", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5704, "text": "Hadaa-iqa wa a'anaa ba", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5705, "text": "Wa kaawa 'iba at raaba", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5706, "text": "Wa ka'san di haaqa", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5707, "text": "Laa yasma'oona fiha lagh waw walaa kizzaba", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5708, "text": "Jazaa-am mir-rabbika ataa-an hisaaba", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5709, "text": "Rabbis samaa waati wal ardi wa maa baina humar rahmaani laa yam likoona minhu khi taaba", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5710, "text": "Yauma yaqoo mur roohu wal malaa-ikatu saf-fal laa yata kalla moona illa man azina lahur rahmaanu wa qaala sawaaba", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5711, "text": "Zaalikal yaumul haqqu faman shaa-at ta khaaza ill-laa rabbihi ma-aaba", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5712, "text": "In naa anzar naakum azaaban qareebaiy-yauma yan zurul marr-u maa qaddamat yadaahu wa ya qoolul-kaafiru yaa lai tanee kuntu turaaba", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]