[{"number": 85, "name": "سُورَةُ البُرُوجِ", "englishName": "Al-Burooj", "englishNameTranslation": "The Constellations", "revelationType": "Meccan", "numberOfAyahs": 22, "ayahs": [{"number": 5910, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5911, "text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5912, "text": "وَشَاهِدٍۢ وَمَشْهُودٍۢ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5913, "text": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5914, "text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5915, "text": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5916, "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5917, "text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5918, "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5919, "text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5920, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5921, "text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5922, "text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5923, "text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5924, "text": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5925, "text": "فَعَّالٌۭ لِّمَا يُرِيدُ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5926, "text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5927, "text": "فِرْعَوْنَ وَثَمُودَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5928, "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5929, "text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5930, "text": "بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5931, "text": "فِى لَوْحٍۢ مَّحْفُوظٍۭ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 85, "name": "سُورَةُ البُرُوجِ", "englishName": "Al-Burooj", "englishNameTranslation": "The Constellations", "revelationType": "Meccan", "numberOfAyahs": 22, "ayahs": [{"number": 5910, "text": "آسمان کی قسم جس میں برج ہیں", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5911, "text": "اور اس دن کی جس کا وعدہ ہے", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5912, "text": "اور حاضر ہونے والے کی اور جو اس کے پاس حاضر کیا جائے اسکی", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5913, "text": "کہ خندقوں (کے کھودنے) والے ہلاک کر دیئے گئے", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5914, "text": "(یعنی) آگ (کی خندقیں) جس میں ایندھن (جھونک رکھا) تھا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5915, "text": "جب کہ وہ ان (کے کناروں) پر بیٹھے ہوئے تھے", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5916, "text": "اور جو (سختیاں) اہل ایمان پر کر رہے تھے ان کو سامنے دیکھ رہے تھے", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5917, "text": "ان کو مومنوں کی یہی بات بری لگتی تھی کہ وہ خدا پر ایمان لائے ہوئے تھے جو غالب (اور) قابل ستائش ہے", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5918, "text": "وہی جس کی آسمانوں اور زمین میں بادشاہت ہے۔ اور خدا ہر چیز سے واقف ہے", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5919, "text": "جن لوگوں نے مومن مردوں اور مومن عورتوں کو تکلیفیں دیں اور توبہ نہ کی ان کو دوزخ کا (اور) عذاب بھی ہوگا اور جلنے کا عذاب بھی ہوگا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5920, "text": "(اور) جو لوگ ایمان لائے اور نیک کام کرتے رہے ان کے لیے باغات ہیں جن کے نیچے نہریں بہہ رہی ہیں۔ یہ ہی بڑی کامیابی ہے", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5921, "text": "بےشک تمہارے پروردگار کی پکڑ بڑی سخت ہے", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5922, "text": "وہی پہلی دفعہ پیدا کرتا ہے اور وہی دوبارہ (زندہ) کرے گا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5923, "text": "اور وہ بخشنے والا اور محبت کرنے والا ہے", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5924, "text": "عرش کا مالک بڑی شان والا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5925, "text": "جو چاہتا ہے کر دیتا ہے", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5926, "text": "بھلا تم کو لشکروں کا حال معلوم ہوا ہے", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5927, "text": "(یعنی) فرعون اور ثمود کا", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5928, "text": "لیکن کافر (جان بوجھ کر) تکذیب میں (گرفتار) ہیں", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5929, "text": "اور خدا (بھی) ان کو گردا گرد سے گھیرے ہوئے ہے", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5930, "text": "(یہ کتاب ہزل و بطلان نہیں) بلکہ یہ قرآن عظیم الشان ہے", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5931, "text": "لوح محفوظ میں (لکھا ہوا)", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 85, "name": "سُورَةُ البُرُوجِ", "englishName": "Al-Burooj", "englishNameTranslation": "The Constellations", "revelationType": "Meccan", "numberOfAyahs": 22, "ayahs": [{"number": 5910, "text": "Wassamaaa'i zaatil burooj", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5911, "text": "Wal yawmil maw'ood", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5912, "text": "Wa shaahidinw wa mashhood", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5913, "text": "Qutila as haabul ukhdood", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5914, "text": "Annaari zaatil waqood", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5915, "text": "Iz hum 'alaihaa qu'ood", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5916, "text": "Wa hum 'alaa maa yaf'aloona bilmu 'mineena shuhood", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5917, "text": "Wa maa naqamoo minhum illaaa aiyu'minoo billaahil 'azeezil Hameed", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5918, "text": "Allazee lahoo mulkus samaawaati wal ard; wallaahu 'alaa kulli shai 'in Shaheed", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5919, "text": "Innal lazeena fatanul mu'mineena wal mu'minaati summa lam yatooboo falahum 'azaabu Jahannama wa lahum 'azaabul hareeq", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5920, "text": "Innal lazeena aamanoo wa 'amilus saalihaati lahum Jannaatun tajree min tahtihal anhaar; zaalikal fawzul kabeer", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5921, "text": "Inna batsha Rabbika lashadeed", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5922, "text": "Innahoo Huwa yubdi'u wa yu'eed", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5923, "text": "Wa Huwal Ghafoorul Wadood", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5924, "text": "Zul 'Arshil Majeed", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5925, "text": "Fa' 'aalul limaa yureed", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5926, "text": "Hal ataaka hadeesul junood", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5927, "text": "Fir'awna wa Samood", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5928, "text": "Balil lazeena kafaroo fee takzeeb", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5929, "text": "Wallaahu minw waraaa'ihim muheet", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5930, "text": "Bal huwa Quraanum Majeed", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5931, "text": "Fee Lawhim Mahfooz", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]