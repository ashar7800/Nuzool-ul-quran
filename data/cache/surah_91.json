[{"number": 91, "name": "سُورَةُ الشَّمۡسِ", "englishName": "Ash-Shams", "englishNameTranslation": "The Sun", "revelationType": "Meccan", "numberOfAyahs": 15, "ayahs": [{"number": 6044, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6045, "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6046, "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6047, "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6048, "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6049, "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6050, "text": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6051, "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6052, "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6053, "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6054, "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6055, "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6056, "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6057, "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6058, "text": "وَلَا يَخَافُ عُقْبَٰهَا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 91, "name": "سُورَةُ الشَّمۡسِ", "englishName": "Ash-Shams", "englishNameTranslation": "The Sun", "revelationType": "Meccan", "numberOfAyahs": 15, "ayahs": [{"number": 6044, "text": "سورج کی قسم اور اس کی روشنی کی", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6045, "text": "اور چاند کی جب اس کے پیچھے نکلے", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6046, "text": "اور دن کی جب اُسے چمکا دے", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6047, "text": "اور رات کی جب اُسے چھپا لے", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6048, "text": "اور آسمان کی اور اس ذات کی جس نے اسے بنایا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6049, "text": "اور زمین کی اور اس کی جس نے اسے پھیلایا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6050, "text": "اور انسان کی اور اس کی جس نے اس (کے اعضا) کو برابر کیا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6051, "text": "پھر اس کو بدکاری (سے بچنے) اور پرہیزگاری کرنے کی سمجھ دی", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6052, "text": "کہ جس نے (اپنے) نفس (یعنی روح) کو پاک رکھا وہ مراد کو پہنچا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6053, "text": "اور جس نے اسے خاک میں ملایا وہ خسارے میں رہا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6054, "text": "(قوم) ثمود نے اپنی سرکشی کے سبب (پیغمبر کو) جھٹلایا", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6055, "text": "جب ان میں سے ایک نہایت بدبخت اٹھا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6056, "text": "تو خدا کے پیغمبر (صالح) نے ان سے کہا کہ خدا کی اونٹنی اور اس کے پانی پینے کی باری سے عذر کرو", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6057, "text": "مگر انہوں نے پیغمبر کو جھٹلایا اور اونٹنی کی کونچیں کاٹ دیں تو خدا نے ان کےگناہ کے سبب ان پر عذاب نازل کیا اور سب کو (ہلاک کر کے) برابر کر دیا", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6058, "text": "اور اس کو ان کے بدلہ لینے کا کچھ بھی ڈر نہیں", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 91, "name": "سُورَةُ الشَّمۡسِ", "englishName": "Ash-Shams", "englishNameTranslation": "The Sun", "revelationType": "Meccan", "numberOfAyahs": 15, "ayahs": [{"number": 6044, "text": "Wash shamsi wa duhaa haa", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6045, "text": "Wal qamari izaa talaa haa", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6046, "text": "Wannahaari izaa jallaa haa", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6047, "text": "Wallaili izaa yaghshaa haa", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6048, "text": "Wassamaaa'i wa maa banaahaa", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6049, "text": "Wal ardi wa maa tahaahaa", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6050, "text": "Wa nafsinw wa maa sawwaahaa", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6051, "text": "Fa-alhamahaa fujoorahaa wa taqwaahaa", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6052, "text": "Qad aflaha man zakkaahaa", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6053, "text": "Wa qad khaaba man dassaahaa", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6054, "text": "Kazzabat Samoodu bi taghwaahaaa", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6055, "text": "Izim ba'asa ashqaahaa", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6056, "text": "Faqaala lahum Rasoolul laahi naaqatal laahi wa suqiyaahaa", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6057, "text": "Fakazzaboohu fa'aqaroohaa fadamdama 'alaihim Rabbuhum bizambihim fasaw waahaa", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6058, "text": "Wa laa yakhaafu'uqbaahaa", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]