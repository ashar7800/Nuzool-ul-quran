[{"number": 82, "name": "سُورَةُ الانفِطَارِ", "englishName": "Al-Infitaar", "englishNameTranslation": "The Cleaving", "revelationType": "Meccan", "numberOfAyahs": 19, "ayahs": [{"number": 5830, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5831, "text": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5832, "text": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5833, "text": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5834, "text": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5835, "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5836, "text": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5837, "text": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5838, "text": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5839, "text": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5840, "text": "كِرَامًۭا كَٰتِبِينَ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5841, "text": "يَعْلَمُونَ مَا تَفْعَلُونَ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5842, "text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5843, "text": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5844, "text": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5845, "text": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5846, "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5847, "text": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5848, "text": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 82, "name": "سُورَةُ الانفِطَارِ", "englishName": "Al-Infitaar", "englishNameTranslation": "The Cleaving", "revelationType": "Meccan", "numberOfAyahs": 19, "ayahs": [{"number": 5830, "text": "جب آسمان پھٹ جائے گا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5831, "text": "اور جب تارے جھڑ پڑیں گے", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5832, "text": "اور جب دریا بہہ (کر ایک دوسرے سے مل) جائیں گے", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5833, "text": "اور جب قبریں اکھیڑ دی جائیں گی", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5834, "text": "تب ہر شخص معلوم کرلے گا کہ اس نے آگے کیا بھیجا تھا اور پیچھے کیا چھوڑا تھا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5835, "text": "اے انسان تجھ کو اپنے پروردگار کرم گستر کے باب میں کس چیز نے دھوکا دیا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5836, "text": "(وہی تو ہے) جس نے تجھے بنایا اور (تیرے اعضا کو) ٹھیک کیا اور (تیرے قامت کو) معتدل رکھا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5837, "text": "اور جس صورت میں چاہا تجھے جوڑ دیا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5838, "text": "مگر ہیہات تم لوگ جزا کو جھٹلاتے ہو", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5839, "text": "حالانکہ تم پر نگہبان مقرر ہیں", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5840, "text": "عالی قدر (تمہاری باتوں کے) لکھنے والے", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5841, "text": "جو تم کرتے ہو وہ اسے جانتے ہیں", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5842, "text": "بے شک نیکوکار نعمتوں (کی بہشت) میں ہوں گے۔", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5843, "text": "اور بدکردار دوزخ میں", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5844, "text": "(یعنی) جزا کے دن اس میں داخل ہوں گے", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5845, "text": "اور اس سے چھپ نہیں سکیں گے", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5846, "text": "اور تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5847, "text": "پھر تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5848, "text": "جس روز کوئی کسی کا بھلا نہ کر سکے گا اور حکم اس روز خدا ہی کا ہو گا", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 82, "name": "سُورَةُ الانفِطَارِ", "englishName": "Al-Infitaar", "englishNameTranslation": "The Cleaving", "revelationType": "Meccan", "numberOfAyahs": 19, "ayahs": [{"number": 5830, "text": "Izas samaaa'un fatarat", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5831, "text": "Wa izal kawaakibun tasarat", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5832, "text": "Wa izal bihaaru fujjirat", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5833, "text": "Wa izal qubooru bu'sirat", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5834, "text": "'Alimat nafsum maa qaddamat wa akhkharat", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5835, "text": "Yaaa ayyuhal insaaanu maa gharraka bi Rabbikal kareem", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5836, "text": "Allazee khalaqaka fasaw waaka fa'adalak", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5837, "text": "Feee ayye sooratim maa shaaa'a rakkabak", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5838, "text": "Kalla bal tukazziboona bid deen", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5839, "text": "Wa inna 'alaikum lahaa fizeen", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5840, "text": "Kiraaman kaatibeen", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5841, "text": "Ya'lamoona ma taf'aloon", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5842, "text": "Innal abraara lafee na'eem", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5843, "text": "Wa innal fujjaara lafee jaheem", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5844, "text": "Yaslawnahaa Yawmad Deen", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5845, "text": "Wa maa hum 'anhaa bighaaa 'ibeen", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5846, "text": "Wa maaa adraaka maa Yawmud Deen", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5847, "text": "Summa maaa adraaka maa Yawmud Deen", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}, {"number": 5848, "text": "Yawma laa tamliku nafsul linafsin shai'anw walamru yawma'izil lillaah", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 587, "ruku": 524, "hizbQuarter": 235, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]