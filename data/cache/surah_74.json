[{"number": 74, "name": "سُورَةُ المُدَّثِّرِ", "englishName": "Al-Muddaththir", "englishNameTranslation": "The Cloaked One", "revelationType": "Meccan", "numberOfAyahs": 56, "ayahs": [{"number": 5496, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5497, "text": "قُمْ فَأَنذِرْ", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5498, "text": "وَرَبَّكَ فَكَبِّرْ", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5499, "text": "وَثِيَابَكَ فَطَهِّرْ", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5500, "text": "وَٱلرُّجْزَ فَٱهْجُرْ", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5501, "text": "وَلَا تَمْنُن تَسْتَكْثِرُ", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5502, "text": "وَلِرَبِّكَ فَٱصْبِرْ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5503, "text": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5504, "text": "فَذَٰلِكَ يَوْمَئِذٍۢ يَوْمٌ عَسِيرٌ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5505, "text": "عَلَى ٱلْكَٰفِرِينَ غَيْرُ يَسِيرٍۢ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5506, "text": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًۭا", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5507, "text": "وَجَعَلْتُ لَهُۥ مَالًۭا مَّمْدُودًۭا", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5508, "text": "وَبَنِينَ شُهُودًۭا", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5509, "text": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًۭا", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5510, "text": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5511, "text": "كَلَّآ ۖ إِنَّهُۥ كَانَ لِءَايَٰتِنَا عَنِيدًۭا", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5512, "text": "سَأُرْهِقُهُۥ صَعُودًا", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5513, "text": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5514, "text": "فَقُتِلَ كَيْفَ قَدَّرَ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5515, "text": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5516, "text": "ثُمَّ نَظَرَ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5517, "text": "ثُمَّ عَبَسَ وَبَسَرَ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5518, "text": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5519, "text": "فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ يُؤْثَرُ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5520, "text": "إِنْ هَٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5521, "text": "سَأُصْلِيهِ سَقَرَ", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5522, "text": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5523, "text": "لَا تُبْقِى وَلَا تَذَرُ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5524, "text": "لَوَّاحَةٌۭ لِّلْبَشَرِ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5525, "text": "عَلَيْهَا تِسْعَةَ عَشَرَ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5526, "text": "وَمَا جَعَلْنَآ أَصْحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةًۭ ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَٰنًۭا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌۭ وَٱلْكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلًۭا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5527, "text": "كَلَّا وَٱلْقَمَرِ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5528, "text": "وَٱلَّيْلِ إِذْ أَدْبَرَ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5529, "text": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5530, "text": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5531, "text": "نَذِيرًۭا لِّلْبَشَرِ", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5532, "text": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5533, "text": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5534, "text": "إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5535, "text": "فِى جَنَّٰتٍۢ يَتَسَآءَلُونَ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5536, "text": "عَنِ ٱلْمُجْرِمِينَ", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5537, "text": "مَا سَلَكَكُمْ فِى سَقَرَ", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5538, "text": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5539, "text": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5540, "text": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5541, "text": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5542, "text": "حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5543, "text": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5544, "text": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5545, "text": "كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5546, "text": "فَرَّتْ مِن قَسْوَرَةٍۭ", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5547, "text": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5548, "text": "كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ", "numberInSurah": 53, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5549, "text": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ", "numberInSurah": 54, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5550, "text": "فَمَن شَآءَ ذَكَرَهُۥ", "numberInSurah": 55, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5551, "text": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ", "numberInSurah": 56, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 74, "name": "سُورَةُ المُدَّثِّرِ", "englishName": "Al-Muddaththir", "englishNameTranslation": "The Cloaked One", "revelationType": "Meccan", "numberOfAyahs": 56, "ayahs": [{"number": 5496, "text": "اے (محمدﷺ) جو کپڑا لپیٹے پڑے ہو", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5497, "text": "اُٹھو اور ہدایت کرو", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5498, "text": "اور اپنے پروردگار کی بڑائی کرو", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5499, "text": "اور اپنے کپڑوں کو پاک رکھو", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5500, "text": "اور ناپاکی سے دور رہو", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5501, "text": "اور (اس نیت سے) احسان نہ کرو کہ اس سے زیادہ کے طالب ہو", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5502, "text": "اور اپنے پروردگار کے لئے صبر کرو", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5503, "text": "جب صور پھونکا جائے گا", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5504, "text": "وہ دن کا مشکل دن ہوگا", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5505, "text": "(یعنی) کافروں پر آسان نہ ہوگا", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5506, "text": "ہمیں اس شخص سے سمجھ لینے دو جس کو ہم نے اکیلا پیدا کیا", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5507, "text": "اور مال کثیر دیا", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5508, "text": "اور (ہر وقت اس کے پاس) حاضر رہنے والے بیٹے دیئے", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5509, "text": "اور ہر طرح کے سامان میں وسعت دی", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5510, "text": "ابھی خواہش رکھتا ہے کہ اور زیادہ دیں", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5511, "text": "ایسا ہرگز نہیں ہوگا۔ یہ ہماری آیتیں کا دشمن رہا ہے", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5512, "text": "ہم اسے صعود پر چڑھائیں گے", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5513, "text": "اس نے فکر کیا اور تجویز کی", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5514, "text": "یہ مارا جائے اس نے کیسی تجویز کی", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5515, "text": "پھر یہ مارا جائے اس نے کیسی تجویز کی", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5516, "text": "پھر تامل کیا", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5517, "text": "پھر تیوری چڑھائی اور منہ بگاڑ لیا", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5518, "text": "پھر پشت پھیر کر چلا اور (قبول حق سے) غرور کیا", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5519, "text": "پھر کہنے لگا کہ یہ تو جادو ہے جو (اگلوں سے) منتقل ہوتا آیا ہے", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5520, "text": "(پھر بولا) یہ (خدا کا کلام نہیں بلکہ) بشر کا کلام ہے", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5521, "text": "ہم عنقریب اس کو سقر میں داخل کریں گے", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5522, "text": "اور تم کیا سمجھے کہ سقر کیا ہے؟", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5523, "text": "(وہ آگ ہے کہ) نہ باقی رکھے گی اور نہ چھوڑے گی", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5524, "text": "اور بدن جھلس کر سیاہ کردے گی", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5525, "text": "اس پر اُنیس داروغہ ہیں", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5526, "text": "اور ہم نے دوزخ کے داروغہ فرشتے بنائے ہیں۔ اور ان کا شمار کافروں کی آزمائش کے لئے مقرر کیا ہے (اور) اس لئے کہ اہل کتاب یقین کریں اور مومنوں کا ایمان اور زیادہ ہو اور اہل کتاب اور مومن شک نہ لائیں۔ اور اس لئے کہ جن لوگوں کے دلوں میں (نفاق کا) مرض ہے اور (جو) کافر (ہیں) کہیں کہ اس مثال (کے بیان کرنے) سے خدا کا مقصد کیا ہے؟ اسی طرح خدا جس کو چاہتا ہے گمراہ کرتا ہے اور جس کو چاہتا ہے ہدایت کرتا ہے اور تمہارے پروردگار کے لشکروں کو اس کے سوا کوئی نہیں جانتا۔ اور یہ تو بنی آدم کے لئے نصیحت ہے", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5527, "text": "ہاں ہاں (ہمیں) چاند کی قسم", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5528, "text": "اور رات کی جب پیٹھ پھیرنے لگے", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5529, "text": "اور صبح کی جب روشن ہو", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5530, "text": "کہ وہ (آگ) ایک بہت بڑی (آفت) ہے", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5531, "text": "(اور) بنی آدم کے لئے مؤجب خوف", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5532, "text": "جو تم میں سے آگے بڑھنا چاہے یا پیچھے رہنا چاہے", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5533, "text": "ہر شخص اپنے اعمال کے بدلے گرو ہے", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5534, "text": "مگر داہنی طرف والے (نیک لوگ)", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5535, "text": "(کہ) وہ باغہائے بہشت میں (ہوں گے اور) پوچھتے ہوں گے", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5536, "text": "(یعنی آگ میں جلنے والے) گنہگاروں سے", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5537, "text": "کہ تم دوزخ میں کیوں پڑے؟", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5538, "text": "وہ جواب دیں گے کہ ہم نماز نہیں پڑھتے تھے", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5539, "text": "اور نہ فقیروں کو کھانا کھلاتے تھے", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5540, "text": "اور اہل باطل کے ساتھ مل کر (حق سے) انکار کرتے تھے", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5541, "text": "اور روز جزا کو جھٹلاتے تھے", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5542, "text": "یہاں تک کہ ہمیں موت آگئی", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5543, "text": "(تو اس حال میں) سفارش کرنے والوں کی سفارش ان کے حق میں کچھ فائدہ نہ دے گی", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5544, "text": "ان کو کیا ہوا ہے کہ نصیحت سے روگرداں ہو رہے ہیں", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5545, "text": "گویا گدھے ہیں کہ بدک جاتے ہیں", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5546, "text": "(یعنی) شیر سے ڈر کر بھاگ جاتے ہیں", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5547, "text": "اصل یہ ہے کہ ان میں سے ہر شخص یہ چاہتا ہے کہ اس کے پاس کھلی ہوئی کتاب آئے", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5548, "text": "ایسا ہرگز نہیں ہوگا۔ حقیقت یہ ہے کہ ان کو آخرت کا خوف ہی نہیں", "numberInSurah": 53, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5549, "text": "کچھ شک نہیں کہ یہ نصیحت ہے", "numberInSurah": 54, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5550, "text": "تو جو چاہے اسے یاد رکھے", "numberInSurah": 55, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5551, "text": "اور یاد بھی تب ہی رکھیں گے جب خدا چاہے۔ وہی ڈرنے کے لائق اور بخشش کا مالک ہے", "numberInSurah": 56, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 74, "name": "سُورَةُ المُدَّثِّرِ", "englishName": "Al-Muddaththir", "englishNameTranslation": "The Cloaked One", "revelationType": "Meccan", "numberOfAyahs": 56, "ayahs": [{"number": 5496, "text": "Yaaa ayyuhal muddassir", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5497, "text": "Qum fa anzir", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5498, "text": "Wa rabbaka fakabbir", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5499, "text": "Wa siyaabaka fatahhir", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5500, "text": "Warrujza fahjur", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5501, "text": "Wa laa tamnun tastaksir", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5502, "text": "Wa li Rabbika fasbir", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5503, "text": "Fa izaa nuqira fin naaqoor", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5504, "text": "Fazaalika yawma 'iziny yawmun 'aseer", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5505, "text": "'Alal kaafireena ghayru yaseer", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5506, "text": "Zamee wa man khalaqtu waheedaa", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5507, "text": "Wa ja'altu lahoo maalam mamdoodaa", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5508, "text": "Wa baneena shuhoodaa", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5509, "text": "Wa mahhattu lahoo tamheeda", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5510, "text": "Summa yat ma'u an azeed", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5511, "text": "Kallaaa innahoo kaana li Aayaatinaa 'aneedaa", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5512, "text": "Sa urhiquhoo sa'oodaa", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 575, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5513, "text": "Innahoo fakkara wa qaddar", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5514, "text": "Faqutila kayfa qaddar", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5515, "text": "Summa qutila kaifa qaddar", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5516, "text": "Summa nazar", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5517, "text": "Summa 'abasa wa basar", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5518, "text": "Summaa adbara wastakbar", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5519, "text": "Faqaala in haazaaa illaa sihruny yu'sar", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5520, "text": "In haazaaa illaa qawlul bashar", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5521, "text": "Sa usleehi saqar", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5522, "text": "Wa maaa adraaka maa saqar", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5523, "text": "Laa tubqee wa laa tazar", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5524, "text": "Lawwaahatul lilbashar", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5525, "text": "'Alaihaa tis'ata 'ashar", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5526, "text": "Wa maaja''alnaaa As haaban naari illaa malaaa 'ikatanw wa maa ja'alnaa 'iddatahum illaa fitnatal lillazeena kafaroo liyastayqinal lazeena ootul kitaaba wa yazdaadal lazeena aamanooo eemaananw wa laa yartaabal lazeena ootul kitaaba walmu'minoona wa liyaqoolal lazeena fee quloo bihim maradunw walkaafiroona maazaaa araadal laahu bihaazaa masalaa; kazaalika yudillul laahu many yashaaa'u wa yahdee many yashaaa'; wa maa ya'lamu junooda rabbika illaa hoo; wa maa hiya illaa zikraa lil bashar", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 576, "ruku": 510, "hizbQuarter": 230, "sajda": false}, {"number": 5527, "text": "Kallaa walqamar", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5528, "text": "Wallaili adbar", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5529, "text": "Wassub hi izaaa asfar", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5530, "text": "Innahaa la ihdal kubar", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5531, "text": "Nazeeral lilbashar", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5532, "text": "Liman shaaa'a minkum any yataqaddama aw yata akhkhar", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5533, "text": "Kullu nafsim bim kasabat raheenah", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5534, "text": "Illaaa as haabal yameen", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5535, "text": "Fee jannaatiny yata saaa'aloon", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5536, "text": "'Anil mujrimeen", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5537, "text": "Maa salakakum fee saqar", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5538, "text": "Qaaloo lam naku minal musalleen", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5539, "text": "Wa lam naku nut'imul miskeen", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5540, "text": "Wa kunnaa nakhoodu ma'al khaaa'ideen", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5541, "text": "Wa kunnaa nukazzibu bi yawmid Deen", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5542, "text": "Hattaaa ataanal yaqeen", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 576, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5543, "text": "Famaa tanfa'uhum shafaa'atush shaafi'een", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5544, "text": "Famaa lahum 'anittazkirati mu'rideen", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5545, "text": "Ka annahum humurum mustanfirah", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5546, "text": "Farrat min qaswarah", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5547, "text": "Bal yureedu kullum ri'im minhum any yu'taa suhufam munashsharah", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5548, "text": "Kallaa bal laa yakhaafoonal aakhirah", "numberInSurah": 53, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5549, "text": "Kallaaa innahoo tazkirah", "numberInSurah": 54, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5550, "text": "Fa man shaaa'a zakarah", "numberInSurah": 55, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}, {"number": 5551, "text": "Wa maa yazkuroona illaaa any yashaaa'al laah; Huwa ahlut taqwaa wa ahlul maghfirah", "numberInSurah": 56, "juz": 29, "manzil": 7, "page": 577, "ruku": 511, "hizbQuarter": 230, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]