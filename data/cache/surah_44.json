[{"number": 44, "name": "سُورَةُ الدُّخَانِ", "englishName": "Ad-Dukhaan", "englishNameTranslation": "The Smoke", "revelationType": "Meccan", "numberOfAyahs": 59, "ayahs": [{"number": 4415, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ حمٓ", "numberInSurah": 1, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4416, "text": "وَٱلْكِتَٰبِ ٱلْمُبِينِ", "numberInSurah": 2, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4417, "text": "إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةٍۢ مُّبَٰرَكَةٍ ۚ إِنَّا كُنَّا مُنذِرِينَ", "numberInSurah": 3, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4418, "text": "فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ", "numberInSurah": 4, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4419, "text": "أَمْرًۭا مِّنْ عِندِنَآ ۚ إِنَّا كُنَّا مُرْسِلِينَ", "numberInSurah": 5, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4420, "text": "رَحْمَةًۭ مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ", "numberInSurah": 6, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4421, "text": "رَبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ", "numberInSurah": 7, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4422, "text": "لَآ إِلَٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ", "numberInSurah": 8, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4423, "text": "بَلْ هُمْ فِى شَكٍّۢ يَلْعَبُونَ", "numberInSurah": 9, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4424, "text": "فَٱرْتَقِبْ يَوْمَ تَأْتِى ٱلسَّمَآءُ بِدُخَانٍۢ مُّبِينٍۢ", "numberInSurah": 10, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4425, "text": "يَغْشَى ٱلنَّاسَ ۖ هَٰذَا عَذَابٌ أَلِيمٌۭ", "numberInSurah": 11, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4426, "text": "رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ", "numberInSurah": 12, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4427, "text": "أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌۭ مُّبِينٌۭ", "numberInSurah": 13, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4428, "text": "ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌۭ مَّجْنُونٌ", "numberInSurah": 14, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4429, "text": "إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ", "numberInSurah": 15, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4430, "text": "يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ", "numberInSurah": 16, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4431, "text": "۞ وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌۭ كَرِيمٌ", "numberInSurah": 17, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4432, "text": "أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ", "numberInSurah": 18, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4433, "text": "وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَٰنٍۢ مُّبِينٍۢ", "numberInSurah": 19, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4434, "text": "وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ", "numberInSurah": 20, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4435, "text": "وَإِن لَّمْ تُؤْمِنُوا۟ لِى فَٱعْتَزِلُونِ", "numberInSurah": 21, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4436, "text": "فَدَعَا رَبَّهُۥٓ أَنَّ هَٰٓؤُلَآءِ قَوْمٌۭ مُّجْرِمُونَ", "numberInSurah": 22, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4437, "text": "فَأَسْرِ بِعِبَادِى لَيْلًا إِنَّكُم مُّتَّبَعُونَ", "numberInSurah": 23, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4438, "text": "وَٱتْرُكِ ٱلْبَحْرَ رَهْوًا ۖ إِنَّهُمْ جُندٌۭ مُّغْرَقُونَ", "numberInSurah": 24, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4439, "text": "كَمْ تَرَكُوا۟ مِن جَنَّٰتٍۢ وَعُيُونٍۢ", "numberInSurah": 25, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4440, "text": "وَزُرُوعٍۢ وَمَقَامٍۢ كَرِيمٍۢ", "numberInSurah": 26, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4441, "text": "وَنَعْمَةٍۢ كَانُوا۟ فِيهَا فَٰكِهِينَ", "numberInSurah": 27, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4442, "text": "كَذَٰلِكَ ۖ وَأَوْرَثْنَٰهَا قَوْمًا ءَاخَرِينَ", "numberInSurah": 28, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4443, "text": "فَمَا بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ وَمَا كَانُوا۟ مُنظَرِينَ", "numberInSurah": 29, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4444, "text": "وَلَقَدْ نَجَّيْنَا بَنِىٓ إِسْرَٰٓءِيلَ مِنَ ٱلْعَذَابِ ٱلْمُهِينِ", "numberInSurah": 30, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4445, "text": "مِن فِرْعَوْنَ ۚ إِنَّهُۥ كَانَ عَالِيًۭا مِّنَ ٱلْمُسْرِفِينَ", "numberInSurah": 31, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4446, "text": "وَلَقَدِ ٱخْتَرْنَٰهُمْ عَلَىٰ عِلْمٍ عَلَى ٱلْعَٰلَمِينَ", "numberInSurah": 32, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4447, "text": "وَءَاتَيْنَٰهُم مِّنَ ٱلْءَايَٰتِ مَا فِيهِ بَلَٰٓؤٌۭا۟ مُّبِينٌ", "numberInSurah": 33, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4448, "text": "إِنَّ هَٰٓؤُلَآءِ لَيَقُولُونَ", "numberInSurah": 34, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4449, "text": "إِنْ هِىَ إِلَّا مَوْتَتُنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُنشَرِينَ", "numberInSurah": 35, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4450, "text": "فَأْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَٰدِقِينَ", "numberInSurah": 36, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4451, "text": "أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍۢ وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ أَهْلَكْنَٰهُمْ ۖ إِنَّهُمْ كَانُوا۟ مُجْرِمِينَ", "numberInSurah": 37, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4452, "text": "وَمَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَٰعِبِينَ", "numberInSurah": 38, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4453, "text": "مَا خَلَقْنَٰهُمَآ إِلَّا بِٱلْحَقِّ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ", "numberInSurah": 39, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4454, "text": "إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَٰتُهُمْ أَجْمَعِينَ", "numberInSurah": 40, "juz": 25, "manzil": 6, "page": 498, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4455, "text": "يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًۭى شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ", "numberInSurah": 41, "juz": 25, "manzil": 6, "page": 498, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4456, "text": "إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ", "numberInSurah": 42, "juz": 25, "manzil": 6, "page": 498, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4457, "text": "إِنَّ شَجَرَتَ ٱلزَّقُّومِ", "numberInSurah": 43, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4458, "text": "طَعَامُ ٱلْأَثِيمِ", "numberInSurah": 44, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4459, "text": "كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ", "numberInSurah": 45, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4460, "text": "كَغَلْىِ ٱلْحَمِيمِ", "numberInSurah": 46, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4461, "text": "خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ", "numberInSurah": 47, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4462, "text": "ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ", "numberInSurah": 48, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4463, "text": "ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ", "numberInSurah": 49, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4464, "text": "إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ", "numberInSurah": 50, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4465, "text": "إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍۢ", "numberInSurah": 51, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4466, "text": "فِى جَنَّٰتٍۢ وَعُيُونٍۢ", "numberInSurah": 52, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4467, "text": "يَلْبَسُونَ مِن سُندُسٍۢ وَإِسْتَبْرَقٍۢ مُّتَقَٰبِلِينَ", "numberInSurah": 53, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4468, "text": "كَذَٰلِكَ وَزَوَّجْنَٰهُم بِحُورٍ عِينٍۢ", "numberInSurah": 54, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4469, "text": "يَدْعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ", "numberInSurah": 55, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4470, "text": "لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ", "numberInSurah": 56, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4471, "text": "فَضْلًۭا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ", "numberInSurah": 57, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4472, "text": "فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ", "numberInSurah": 58, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4473, "text": "فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ", "numberInSurah": 59, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 44, "name": "سُورَةُ الدُّخَانِ", "englishName": "Ad-Dukhaan", "englishNameTranslation": "The Smoke", "revelationType": "Meccan", "numberOfAyahs": 59, "ayahs": [{"number": 4415, "text": "حٰم", "numberInSurah": 1, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4416, "text": "اس کتاب روشن کی قسم", "numberInSurah": 2, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4417, "text": "کہ ہم نے اس کو مبارک رات میں نازل فرمایا ہم تو رستہ دکھانے والے ہیں", "numberInSurah": 3, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4418, "text": "اسی رات میں تمام حکمت کے کام فیصل کئے جاتے ہیں", "numberInSurah": 4, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4419, "text": "(یعنی) ہمارے ہاں سے حکم ہو کر۔ بےشک ہم ہی (پیغمبر کو) بھیجتے ہیں", "numberInSurah": 5, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4420, "text": "(یہ) تمہارے پروردگار کی رحمت ہے۔ وہ تو سننے والا جاننے والا ہے", "numberInSurah": 6, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4421, "text": "آسمانوں اور زمین کا اور جو کچھ ان دونوں میں ہے سب کا مالک۔ بشرطیکہ تم لوگ یقین کرنے والے ہو", "numberInSurah": 7, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4422, "text": "اس کے سوا کوئی معبود نہیں۔ (وہی) جِلاتا ہے اور (وہی) مارتا ہے۔ وہی تمہارا اور تمہارے باپ دادا کا پروردگار ہے", "numberInSurah": 8, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4423, "text": "لیکن یہ لوگ شک میں کھیل رہے ہیں", "numberInSurah": 9, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4424, "text": "تو اس دن کا انتظار کرو کہ آسمان سے صریح دھواں نکلے گا", "numberInSurah": 10, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4425, "text": "جو لوگوں پر چھا جائے گا۔ یہ درد دینے والا عذاب ہے", "numberInSurah": 11, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4426, "text": "اے پروردگار ہم سے اس عذاب کو دور کر ہم ایمان لاتے ہیں", "numberInSurah": 12, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4427, "text": "(اس وقت) ان کو نصیحت کہاں مفید ہوگی جب کہ ان کے پاس پیغمبر آچکے جو کھول کھول کر بیان کر دیتے ہیں", "numberInSurah": 13, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4428, "text": "پھر انہوں نے ان سے منہ پھیر لیا اور کہنے لگے (یہ تو) پڑھایا ہوا (اور) دیوانہ ہے", "numberInSurah": 14, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4429, "text": "ہم تو تھوڑے دنوں عذاب ٹال دیتے ہیں (مگر) تم پھر کفر کرنے لگتے ہو", "numberInSurah": 15, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4430, "text": "جس دن ہم بڑی سخت پکڑ پکڑیں گے تو بےشک انتقام لے کر چھوڑیں گے", "numberInSurah": 16, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4431, "text": "اور ان سے پہلے ہم نے قوم فرعون کی آزمائش کی اور ان کے پاس ایک عالی قدر پیغمبر آئے", "numberInSurah": 17, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4432, "text": "(جنہوں نے) یہ (کہا) کہ خدا کے بندوں (یعنی بنی اسرائیل) کو میرے حوالے کردو میں تمہارا امانت دار پیغمبر ہوں", "numberInSurah": 18, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4433, "text": "اور خدا کے سامنے سرکشی نہ کرو۔ میں تمہارے پاس کھلی دلیل لے کر آیا ہوں", "numberInSurah": 19, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4434, "text": "اور اس (بات) سے کہ تم مجھے سنگسار کرو اپنے اور تمہارے پروردگار کی پناہ مانگتا ہوں", "numberInSurah": 20, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4435, "text": "اور اگر تم مجھ پر ایمان نہیں لاتے تو مجھ سے الگ ہو جاؤ", "numberInSurah": 21, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4436, "text": "تب موسیٰ نے اپنے پروردگار سے دعا کی کہ یہ نافرمان لوگ ہیں", "numberInSurah": 22, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4437, "text": "(خدا نے فرمایا کہ) میرے بندوں کو راتوں رات لے کر چلے جاؤ اور (فرعونی) ضرور تمہارا تعاقب کریں گے", "numberInSurah": 23, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4438, "text": "اور دریا سے (کہ) خشک (ہو رہا ہوگا) پار ہو جاؤ (تمہارے بعد) ان کا تمام لشکر ڈبو دیا جائے گا", "numberInSurah": 24, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4439, "text": "وہ لوگ بہت سے باغ اور چشمے چھوڑ گئے", "numberInSurah": 25, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4440, "text": "اور کھیتیاں اور نفیس مکان", "numberInSurah": 26, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4441, "text": "اور آرام کی چیزیں جن میں عیش کیا کرتے تھے", "numberInSurah": 27, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4442, "text": "اسی طرح (ہوا) اور ہم نے دوسرے لوگوں کو ان چیزوں کا مالک بنا دیا", "numberInSurah": 28, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4443, "text": "پھر ان پر نہ تو آسمان کو اور زمین کو رونا آیا اور نہ ان کو مہلت ہی دی گئی", "numberInSurah": 29, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4444, "text": "اور ہم نے بنی اسرائیل کو ذلت کے عذاب سے نجات دی", "numberInSurah": 30, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4445, "text": "(یعنی) فرعون سے۔ بےشک وہ سرکش (اور) حد سے نکلا ہوا تھا", "numberInSurah": 31, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4446, "text": "اور ہم نے بنی اسرائیل کو اہل عالم سے دانستہ منتخب کیا تھا", "numberInSurah": 32, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4447, "text": "اور ان کو ایسی نشانیاں دی تھیں جن میں صریح آزمائش تھی", "numberInSurah": 33, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4448, "text": "یہ لوگ یہ کہتے ہیں", "numberInSurah": 34, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4449, "text": "کہ ہمیں صرف پہلی دفعہ (یعنی ایک بار) مرنا ہے اور (پھر) اُٹھنا نہیں", "numberInSurah": 35, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4450, "text": "پس اگر تم سچے ہو تو ہمارے باپ دادا کو (زندہ کر) لاؤ", "numberInSurah": 36, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4451, "text": "بھلا یہ اچھے ہیں یا تُبّع کی قوم اور وہ لوگ جو تم سے پہلے ہوچکے ہیں۔ ہم نے ان (سب) کو ہلاک کردیا۔ بےشک وہ گنہگار تھے", "numberInSurah": 37, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4452, "text": "اور ہم نے آسمانوں اور زمین کو اور جو کچھ ان میں ہے ان کو کھیلتے ہوئے نہیں بنایا", "numberInSurah": 38, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4453, "text": "ان کو ہم نے تدبیر سے پیدا کیا ہے لیکن اکثر لوگ نہیں جانتے", "numberInSurah": 39, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4454, "text": "کچھ شک نہیں کہ فیصلے کا دن ان سب (کے اُٹھنے) کا وقت ہے", "numberInSurah": 40, "juz": 25, "manzil": 6, "page": 498, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4455, "text": "جس دن کوئی دوست کسی دوست کے کچھ کام نہ آئے گا اور نہ ان کو مدد ملے گی", "numberInSurah": 41, "juz": 25, "manzil": 6, "page": 498, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4456, "text": "مگر جس پر خدا مہربانی کرے۔ وہ تو غالب اور مہربان ہے", "numberInSurah": 42, "juz": 25, "manzil": 6, "page": 498, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4457, "text": "بلاشبہ تھوہر کا درخت", "numberInSurah": 43, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4458, "text": "گنہگار کا کھانا ہے", "numberInSurah": 44, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4459, "text": "جیسے پگھلا ہوا تانبا۔ پیٹوں میں (اس طرح) کھولے گا", "numberInSurah": 45, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4460, "text": "جس طرح گرم پانی کھولتا ہے", "numberInSurah": 46, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4461, "text": "(حکم دیا جائے گا کہ) اس کو پکڑ لو اور کھینچتے ہوئے دوزخ کے بیچوں بیچ لے جاؤ", "numberInSurah": 47, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4462, "text": "پھر اس کے سر پر کھولتا ہوا پانی انڈیل دو (کہ عذاب پر) عذاب (ہو)", "numberInSurah": 48, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4463, "text": "(اب) مزہ چکھ۔ تو بڑی عزت والا (اور) سردار ہے", "numberInSurah": 49, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4464, "text": "یہ وہی (دوزخ) ہے جس میں تم لوگ شک کیا کرتے تھے", "numberInSurah": 50, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4465, "text": "بےشک پرہیزگار لوگ امن کے مقام میں ہوں گے", "numberInSurah": 51, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4466, "text": "(یعنی) باغوں اور چشموں میں", "numberInSurah": 52, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4467, "text": "حریر کا باریک اور دبیز لباس پہن کر ایک دوسرے کے سامنے بیٹھے ہوں گے", "numberInSurah": 53, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4468, "text": "اس طرح (کا حال ہوگا) اور ہم بڑی بڑی آنکھوں والی سفید رنگ کی عورتوں سے ان کے جوڑے لگائیں گے", "numberInSurah": 54, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4469, "text": "وہاں خاطر جمع سے ہر قسم کے میوے منگوائیں گے (اور کھائیں گے)", "numberInSurah": 55, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4470, "text": "(اور) پہلی دفعہ کے مرنے کے سوا (کہ مرچکے تھے) موت کا مزہ نہیں چکھیں گے۔ اور خدا ان کو دوزخ کے عذاب سے بچا لے گا", "numberInSurah": 56, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4471, "text": "یہ تمہارے پروردگار کا فضل ہے۔ یہی تو بڑی کامیابی ہے", "numberInSurah": 57, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4472, "text": "ہم نے اس (قرآن) کو تمہاری زبان میں آسان کردیا ہے تاکہ یہ لوگ نصیحت پکڑیں", "numberInSurah": 58, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4473, "text": "پس تم بھی انتظار کرو یہ بھی انتظار کر رہے ہیں", "numberInSurah": 59, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 44, "name": "سُورَةُ الدُّخَانِ", "englishName": "Ad-Dukhaan", "englishNameTranslation": "The Smoke", "revelationType": "Meccan", "numberOfAyahs": 59, "ayahs": [{"number": 4415, "text": "Haa Meeem", "numberInSurah": 1, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4416, "text": "Wal Kitaabil Mubeen", "numberInSurah": 2, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4417, "text": "Innaaa anzalnaahu fee lailatim mubaarakah; innaa kunnaa munzireen", "numberInSurah": 3, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4418, "text": "Feehaa yufraqu kullu amrin hakeem", "numberInSurah": 4, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4419, "text": "Amram min 'indinaaa; innaa kunnaa mursileen", "numberInSurah": 5, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4420, "text": "Rahmatam mir rabbik; innahoo Huwas Samee'ul 'Aleem", "numberInSurah": 6, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4421, "text": "Rabbis samaawaati wal ardi wa maa bainahumaa; in kuntum mooqineen", "numberInSurah": 7, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4422, "text": "Laaa ilaaha illaa Huwa yuhyee wa yumeetu Rabbukum wa Rabbu aabaaa'ikumul awwaleen", "numberInSurah": 8, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4423, "text": "Bal hum fee shakkiny yal'aboon", "numberInSurah": 9, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4424, "text": "Fartaqib Yawma taatis samaaa'u bidukhaanim mubeen", "numberInSurah": 10, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4425, "text": "Yaghshan naasa haazaa 'azaabun aleem", "numberInSurah": 11, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4426, "text": "Rabbanak shif 'annal 'azaaba innaa mu'minoon", "numberInSurah": 12, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4427, "text": "Annaa lahumuz zikraa wa qad jaaa'ahum Rasoolum mubeen", "numberInSurah": 13, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4428, "text": "Summaa tawallaw 'anhu wa qaaloo mu'allamum majnoon", "numberInSurah": 14, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4429, "text": "Innaa kaashiful 'azaabi qaleelaa; innakum 'aaa'indoon", "numberInSurah": 15, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4430, "text": "Yawma nabtishul batsha tal kubraa innaa muntaqimoon", "numberInSurah": 16, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 198, "sajda": false}, {"number": 4431, "text": "Wa laqad fatannaa qablahum qawma Fir'awna wa jaaa'ahum Rasoolun kareem", "numberInSurah": 17, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4432, "text": "An addooo ilaiya 'ibaadal laahi innee lakum Rasoolun ameen", "numberInSurah": 18, "juz": 25, "manzil": 6, "page": 496, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4433, "text": "Wa al laa ta'loo 'alal laahi innee aateekum bisultaanim mubeen", "numberInSurah": 19, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4434, "text": "Wa innee 'uztu bi Rabbee wa rabbikum an tarjumoon", "numberInSurah": 20, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4435, "text": "Wa il lam tu'minoo lee fa'taziloon", "numberInSurah": 21, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4436, "text": "Fada'aa rabbahooo anna haaa'ulaaa'i qawmum mujrimoon", "numberInSurah": 22, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4437, "text": "Fa asri bi'ibaadee lailan innakum muttaba'oon", "numberInSurah": 23, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4438, "text": "Watrukil bahra rahwan innahum jundum mughraqoon", "numberInSurah": 24, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4439, "text": "Kam tarakoo min jannaatinw wa 'uyoon", "numberInSurah": 25, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4440, "text": "Wa zuroo'inw wa maqaa min kareem", "numberInSurah": 26, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4441, "text": "Wa na'matin kaanoo feehaa faakiheen", "numberInSurah": 27, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4442, "text": "Kazaalika wa awrasnaahaa qawman aakhareen", "numberInSurah": 28, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4443, "text": "Famaa bakat 'alaihimus samaaa'u wal ardu wa maa kaanoo munzareen", "numberInSurah": 29, "juz": 25, "manzil": 6, "page": 497, "ruku": 431, "hizbQuarter": 199, "sajda": false}, {"number": 4444, "text": "Wa laqad najjainaa Baneee Israaa'eela minal'azaabil muheen", "numberInSurah": 30, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4445, "text": "Min Fir'awn; innahoo kaana 'aaliyam minal musrifeen", "numberInSurah": 31, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4446, "text": "Wa laqadikh tarnaahum 'alaa 'ilmin 'alal 'aalameen", "numberInSurah": 32, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4447, "text": "Wa aatainaahum minal aayaati maa feehi balaaa'um mubeen", "numberInSurah": 33, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4448, "text": "Inna haaa'ulaaa'i la yaqooloon", "numberInSurah": 34, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4449, "text": "In hiya illaa mawtatunal oolaa wa maa nahnu bimun shareen", "numberInSurah": 35, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4450, "text": "Faatoo bi aabaaa'inaaa inkuntum saadiqeen", "numberInSurah": 36, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4451, "text": "Ahum khayrun am qawmu Tubba'inw wallazeena min qablihim; ahlaknaahum innahum kaanoo mujrimeen", "numberInSurah": 37, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4452, "text": "Wa maa khalaqnas samaawaati wal arda wa maa baina humaa laa'ibeen", "numberInSurah": 38, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4453, "text": "Maa khalaqnaahumaaa illaa bilhaqqi wa laakinna aksarahum laa ya'lamoon", "numberInSurah": 39, "juz": 25, "manzil": 6, "page": 497, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4454, "text": "Inna yawmal fasli meeqaatuhum ajma'een", "numberInSurah": 40, "juz": 25, "manzil": 6, "page": 498, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4455, "text": "Yawma laa yughnee mawlan 'am mawlan shai'anw wa laa hum yunsaroon", "numberInSurah": 41, "juz": 25, "manzil": 6, "page": 498, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4456, "text": "Illaa mar rahimal laah' innahoo huwal 'azeezur raheem", "numberInSurah": 42, "juz": 25, "manzil": 6, "page": 498, "ruku": 432, "hizbQuarter": 199, "sajda": false}, {"number": 4457, "text": "Inna shajarataz zaqqoom", "numberInSurah": 43, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4458, "text": "Ta'aamul aseem", "numberInSurah": 44, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4459, "text": "Kalmuhli yaghlee filbutoon", "numberInSurah": 45, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4460, "text": "Kaghalyil hameem", "numberInSurah": 46, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4461, "text": "Khuzoohu fa'tiloohu ilaa sawaaa'il Jaheem", "numberInSurah": 47, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4462, "text": "Summa subboo fawqa raasihee min 'azaabil hameem", "numberInSurah": 48, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4463, "text": "Zuq innaka antal 'azeezul kareem", "numberInSurah": 49, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4464, "text": "Inna haazaa maa kuntum bihee tamtaroon", "numberInSurah": 50, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4465, "text": "Innal muttaqeena fee maqaamin ameen", "numberInSurah": 51, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4466, "text": "Fee jannaatinw wa 'uyoon", "numberInSurah": 52, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4467, "text": "Yalbasoona min sundusinw wa istbraqim mutaqaabileen", "numberInSurah": 53, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4468, "text": "Kazaalika wa zawwajnaahum bihoorin 'een", "numberInSurah": 54, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4469, "text": "Yad'oona feehaa bikulli faakihatin aamineen", "numberInSurah": 55, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4470, "text": "Laa yazooqoona feehal mawtaa illal mawtatal oolaa wa qaqaahum 'azaabal jaheem", "numberInSurah": 56, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4471, "text": "Fadlam mir rabbik; zaalika huwal fawzul 'azeem", "numberInSurah": 57, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4472, "text": "Fa innamaa yassarnaahu bilisaanika la'allahum yatazakkaroon", "numberInSurah": 58, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}, {"number": 4473, "text": "Fartaqib innahum murta qiboon", "numberInSurah": 59, "juz": 25, "manzil": 6, "page": 498, "ruku": 433, "hizbQuarter": 199, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]