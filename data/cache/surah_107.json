[{"number": 107, "name": "سُورَةُ المَاعُونِ", "englishName": "Al-Maa'un", "englishNameTranslation": "Almsgiving", "revelationType": "Meccan", "numberOfAyahs": 7, "ayahs": [{"number": 6198, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6199, "text": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6200, "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6201, "text": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6202, "text": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6203, "text": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6204, "text": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 107, "name": "سُورَةُ المَاعُونِ", "englishName": "Al-Maa'un", "englishNameTranslation": "Almsgiving", "revelationType": "Meccan", "numberOfAyahs": 7, "ayahs": [{"number": 6198, "text": "بھلا تم نے اس شخص کو دیکھا جو (روزِ) جزا کو جھٹلاتا ہے؟", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6199, "text": "یہ وہی (بدبخت) ہے، جو یتیم کو دھکے دیتا ہے", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6200, "text": "اور فقیر کو کھانا کھلانے کے لیے (لوگوں کو) ترغیب نہیں دیتا", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6201, "text": "تو ایسے نمازیوں کی خرابی ہے", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6202, "text": "جو نماز کی طرف سے غافل رہتے ہیں", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6203, "text": "جو ریا کاری کرتے ہیں", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6204, "text": "اور برتنے کی چیزیں عاریتہً نہیں دیتے", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 107, "name": "سُورَةُ المَاعُونِ", "englishName": "Al-Maa'un", "englishNameTranslation": "Almsgiving", "revelationType": "Meccan", "numberOfAyahs": 7, "ayahs": [{"number": 6198, "text": "Ara-aital lazee yu kazzibu bid deen", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6199, "text": "Fa zaalikal lazi yadu'ul-yateem", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6200, "text": "Wa la ya huddu 'alaa ta'amil miskeen", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6201, "text": "Fa wai lul-lil mu salleen", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6202, "text": "Al lazeena hum 'an salaatihim sahoon", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6203, "text": "Al lazeena hum yuraa-oon", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}, {"number": 6204, "text": "Wa yamna'oonal ma'oon", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 602, "ruku": 549, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]