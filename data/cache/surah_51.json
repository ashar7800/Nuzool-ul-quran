[{"number": 51, "name": "سُورَةُ الذَّارِيَاتِ", "englishName": "Adh-Dhaariyat", "englishNameTranslation": "The Winnowing Winds", "revelationType": "Meccan", "numberOfAyahs": 60, "ayahs": [{"number": 4676, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلذَّٰرِيَٰتِ ذَرْوًۭا", "numberInSurah": 1, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4677, "text": "فَٱلْحَٰمِلَٰتِ وِقْرًۭا", "numberInSurah": 2, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4678, "text": "فَٱلْجَٰرِيَٰتِ يُسْرًۭا", "numberInSurah": 3, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4679, "text": "فَٱلْمُقَسِّمَٰتِ أَمْرًا", "numberInSurah": 4, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4680, "text": "إِنَّمَا تُوعَدُونَ لَصَادِقٌۭ", "numberInSurah": 5, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4681, "text": "وَإِنَّ ٱلدِّينَ لَوَٰقِعٌۭ", "numberInSurah": 6, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4682, "text": "وَٱلسَّمَآءِ ذَاتِ ٱلْحُبُكِ", "numberInSurah": 7, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4683, "text": "إِنَّكُمْ لَفِى قَوْلٍۢ مُّخْتَلِفٍۢ", "numberInSurah": 8, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4684, "text": "يُؤْفَكُ عَنْهُ مَنْ أُفِكَ", "numberInSurah": 9, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4685, "text": "قُتِلَ ٱلْخَرَّٰصُونَ", "numberInSurah": 10, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4686, "text": "ٱلَّذِينَ هُمْ فِى غَمْرَةٍۢ سَاهُونَ", "numberInSurah": 11, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4687, "text": "يَسْـَٔلُونَ أَيَّانَ يَوْمُ ٱلدِّينِ", "numberInSurah": 12, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4688, "text": "يَوْمَ هُمْ عَلَى ٱلنَّارِ يُفْتَنُونَ", "numberInSurah": 13, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4689, "text": "ذُوقُوا۟ فِتْنَتَكُمْ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تَسْتَعْجِلُونَ", "numberInSurah": 14, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4690, "text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَعُيُونٍ", "numberInSurah": 15, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4691, "text": "ءَاخِذِينَ مَآ ءَاتَىٰهُمْ رَبُّهُمْ ۚ إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُحْسِنِينَ", "numberInSurah": 16, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4692, "text": "كَانُوا۟ قَلِيلًۭا مِّنَ ٱلَّيْلِ مَا يَهْجَعُونَ", "numberInSurah": 17, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4693, "text": "وَبِٱلْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ", "numberInSurah": 18, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4694, "text": "وَفِىٓ أَمْوَٰلِهِمْ حَقٌّۭ لِّلسَّآئِلِ وَٱلْمَحْرُومِ", "numberInSurah": 19, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4695, "text": "وَفِى ٱلْأَرْضِ ءَايَٰتٌۭ لِّلْمُوقِنِينَ", "numberInSurah": 20, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4696, "text": "وَفِىٓ أَنفُسِكُمْ ۚ أَفَلَا تُبْصِرُونَ", "numberInSurah": 21, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4697, "text": "وَفِى ٱلسَّمَآءِ رِزْقُكُمْ وَمَا تُوعَدُونَ", "numberInSurah": 22, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4698, "text": "فَوَرَبِّ ٱلسَّمَآءِ وَٱلْأَرْضِ إِنَّهُۥ لَحَقٌّۭ مِّثْلَ مَآ أَنَّكُمْ تَنطِقُونَ", "numberInSurah": 23, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4699, "text": "هَلْ أَتَىٰكَ حَدِيثُ ضَيْفِ إِبْرَٰهِيمَ ٱلْمُكْرَمِينَ", "numberInSurah": 24, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4700, "text": "إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَٰمًۭا ۖ قَالَ سَلَٰمٌۭ قَوْمٌۭ مُّنكَرُونَ", "numberInSurah": 25, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4701, "text": "فَرَاغَ إِلَىٰٓ أَهْلِهِۦ فَجَآءَ بِعِجْلٍۢ سَمِينٍۢ", "numberInSurah": 26, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4702, "text": "فَقَرَّبَهُۥٓ إِلَيْهِمْ قَالَ أَلَا تَأْكُلُونَ", "numberInSurah": 27, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4703, "text": "فَأَوْجَسَ مِنْهُمْ خِيفَةًۭ ۖ قَالُوا۟ لَا تَخَفْ ۖ وَبَشَّرُوهُ بِغُلَٰمٍ عَلِيمٍۢ", "numberInSurah": 28, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4704, "text": "فَأَقْبَلَتِ ٱمْرَأَتُهُۥ فِى صَرَّةٍۢ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوزٌ عَقِيمٌۭ", "numberInSurah": 29, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4705, "text": "قَالُوا۟ كَذَٰلِكِ قَالَ رَبُّكِ ۖ إِنَّهُۥ هُوَ ٱلْحَكِيمُ ٱلْعَلِيمُ", "numberInSurah": 30, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4706, "text": "۞ قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4707, "text": "قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍۢ مُّجْرِمِينَ", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4708, "text": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةًۭ مِّن طِينٍۢ", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4709, "text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَ", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4710, "text": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ ٱلْمُؤْمِنِينَ", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4711, "text": "فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتٍۢ مِّنَ ٱلْمُسْلِمِينَ", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4712, "text": "وَتَرَكْنَا فِيهَآ ءَايَةًۭ لِّلَّذِينَ يَخَافُونَ ٱلْعَذَابَ ٱلْأَلِيمَ", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4713, "text": "وَفِى مُوسَىٰٓ إِذْ أَرْسَلْنَٰهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَٰنٍۢ مُّبِينٍۢ", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4714, "text": "فَتَوَلَّىٰ بِرُكْنِهِۦ وَقَالَ سَٰحِرٌ أَوْ مَجْنُونٌۭ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4715, "text": "فَأَخَذْنَٰهُ وَجُنُودَهُۥ فَنَبَذْنَٰهُمْ فِى ٱلْيَمِّ وَهُوَ مُلِيمٌۭ", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4716, "text": "وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ ٱلرِّيحَ ٱلْعَقِيمَ", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4717, "text": "مَا تَذَرُ مِن شَىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَٱلرَّمِيمِ", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4718, "text": "وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُوا۟ حَتَّىٰ حِينٍۢ", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4719, "text": "فَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ ٱلصَّٰعِقَةُ وَهُمْ يَنظُرُونَ", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4720, "text": "فَمَا ٱسْتَطَٰعُوا۟ مِن قِيَامٍۢ وَمَا كَانُوا۟ مُنتَصِرِينَ", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4721, "text": "وَقَوْمَ نُوحٍۢ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ قَوْمًۭا فَٰسِقِينَ", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4722, "text": "وَٱلسَّمَآءَ بَنَيْنَٰهَا بِأَيْي۟دٍۢ وَإِنَّا لَمُوسِعُونَ", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4723, "text": "وَٱلْأَرْضَ فَرَشْنَٰهَا فَنِعْمَ ٱلْمَٰهِدُونَ", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4724, "text": "وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4725, "text": "فَفِرُّوٓا۟ إِلَى ٱللَّهِ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4726, "text": "وَلَا تَجْعَلُوا۟ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4727, "text": "كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4728, "text": "أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌۭ طَاغُونَ", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4729, "text": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍۢ", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4730, "text": "وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4731, "text": "وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ", "numberInSurah": 56, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4732, "text": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍۢ وَمَآ أُرِيدُ أَن يُطْعِمُونِ", "numberInSurah": 57, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4733, "text": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ", "numberInSurah": 58, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4734, "text": "فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًۭا مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِ", "numberInSurah": 59, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4735, "text": "فَوَيْلٌۭ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ", "numberInSurah": 60, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 51, "name": "سُورَةُ الذَّارِيَاتِ", "englishName": "Adh-Dhaariyat", "englishNameTranslation": "The Winnowing Winds", "revelationType": "Meccan", "numberOfAyahs": 60, "ayahs": [{"number": 4676, "text": "بکھیرنے والیوں کی قسم جو اُڑا کر بکھیر دیتی ہیں", "numberInSurah": 1, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4677, "text": "پھر (پانی کا) بوجھ اٹھاتی ہیں", "numberInSurah": 2, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4678, "text": "پھر آہستہ آہستہ چلتی ہیں", "numberInSurah": 3, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4679, "text": "پھر چیزیں تقسیم کرتی ہیں", "numberInSurah": 4, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4680, "text": "کہ جس چیز کا تم سے وعدہ کیا جاتا ہے وہ سچا ہے", "numberInSurah": 5, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4681, "text": "اور انصاف (کا دن) ضرور واقع ہوگا", "numberInSurah": 6, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4682, "text": "اور آسمان کی قسم جس میں رسے ہیں", "numberInSurah": 7, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4683, "text": "کہ (اے اہل مکہ) تم ایک متناقض بات میں (پڑے ہوئے) ہو", "numberInSurah": 8, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4684, "text": "اس سے وہی پھرتا ہے جو (خدا کی طرف سے) پھیرا جائے", "numberInSurah": 9, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4685, "text": "اٹکل دوڑانے والے ہلاک ہوں", "numberInSurah": 10, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4686, "text": "جو بےخبری میں بھولے ہوئے ہیں", "numberInSurah": 11, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4687, "text": "پوچھتے ہیں کہ جزا کا دن کب ہوگا؟", "numberInSurah": 12, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4688, "text": "اُس دن (ہوگا) جب ان کو آگ میں عذاب دیا جائے گا", "numberInSurah": 13, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4689, "text": "اب اپنی شرارت کا مزہ چکھو۔ یہ وہی ہے جس کے لئے تم جلدی مچایا کرتے تھے", "numberInSurah": 14, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4690, "text": "بےشک پرہیزگار بہشتوں اور چشموں میں (عیش کر رہے) ہوں گے", "numberInSurah": 15, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4691, "text": "اور) جو جو (نعمتیں) ان کا پروردگار انہیں دیتا ہوگا ان کو لے رہے ہوں گے۔ بےشک وہ اس سے پہلے نیکیاں کرتے تھے", "numberInSurah": 16, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4692, "text": "رات کے تھوڑے سے حصے میں سوتے تھے", "numberInSurah": 17, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4693, "text": "اور اوقات سحر میں بخشش مانگا کرتے تھے", "numberInSurah": 18, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4694, "text": "اور ان کے مال میں مانگنے والے اور نہ مانگنے والے (دونوں) کا حق ہوتا تھا", "numberInSurah": 19, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4695, "text": "اور یقین کرنے والوں کے لئے زمین میں (بہت سی) نشانیاں ہیں", "numberInSurah": 20, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4696, "text": "اور خود تمہارے نفوس میں تو کیا تم دیکھتے نہیں؟", "numberInSurah": 21, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4697, "text": "اور تمہارا رزق اور جس چیز کا تم سے وعدہ کیا جاتا ہے آسمان میں ہے", "numberInSurah": 22, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4698, "text": "تو آسمانوں اور زمین کے مالک کی قسم! یہ (اسی طرح) قابل یقین ہے جس طرح تم بات کرتے ہو", "numberInSurah": 23, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4699, "text": "بھلا تمہارے پاس ابراہیمؑ کے معزز مہمانوں کی خبر پہنچی ہے؟", "numberInSurah": 24, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4700, "text": "جب وہ ان کے پاس آئے تو سلام کہا۔ انہوں نے بھی (جواب میں) سلام کہا (دیکھا تو) ایسے لوگ کہ نہ جان نہ پہچان", "numberInSurah": 25, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4701, "text": "تو اپنے گھر جا کر ایک (بھنا ہوا) موٹا بچھڑا لائے", "numberInSurah": 26, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4702, "text": "(اور کھانے کے لئے) ان کے آگے رکھ دیا۔ کہنے لگے کہ آپ تناول کیوں نہیں کرتے؟", "numberInSurah": 27, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4703, "text": "اور دل میں ان سے خوف معلوم کیا۔ (انہوں نے) کہا کہ خوف نہ کیجیئے۔ اور ان کو ایک دانشمند لڑکے کی بشارت بھی سنائی", "numberInSurah": 28, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4704, "text": "تو ابراہیمؑ کی بیوی چلاّتی آئی اور اپنا منہ پیٹ کر کہنے لگی کہ (اے ہے ایک تو) بڑھیا اور (دوسرے) بانجھ", "numberInSurah": 29, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4705, "text": "(انہوں نے) کہا (ہاں) تمہارے پروردگار نے یوں ہی فرمایا ہے۔ وہ بےشک صاحبِ حکمت (اور) خبردار ہے", "numberInSurah": 30, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4706, "text": "ابراہیمؑ نے کہا کہ فرشتو! تمہارا مدعا کیا ہے؟", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4707, "text": "انہوں نے کہا کہ ہم گنہگار لوگوں کی طرف بھیجے گئے ہیں", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4708, "text": "تاکہ ان پر کھنگر برسائیں", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4709, "text": "جن پر حد سے بڑھ جانے والوں کے لئے تمہارے پروردگار کے ہاں سے نشان کردیئے گئے ہیں", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4710, "text": "تو وہاں جتنے مومن تھے ان کو ہم نے نکال لیا", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4711, "text": "اور اس میں ایک گھر کے سوا مسلمانوں کا کوئی گھر نہ پایا", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4712, "text": "اور جو لوگ عذاب الیم سے ڈرتے ہیں ان کے لئے وہاں نشانی چھوڑ دی", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4713, "text": "اور موسیٰ (کے حال) میں (بھی نشانی ہے) جب ہم نے ان کو فرعون کی طرف کھلا ہوا معجزہ دے کر بھیجا", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4714, "text": "تو اس نے اپنی جماعت (کے گھمنڈ) پر منہ موڑ لیا اور کہنے لگا یہ تو جادوگر ہے یا دیوانہ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4715, "text": "تو ہم نے اس کو اور اس کے لشکروں کو پکڑ لیا اور ان کو دریا میں پھینک دیا اور وہ کام ہی قابل ملامت کرتا تھا", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4716, "text": "اور عاد (کی قوم کے حال) میں بھی (نشانی ہے) جب ہم نے ان پر نامبارک ہوا چلائی", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4717, "text": "وہ جس چیز پر چلتی اس کو ریزہ ریزہ کئے بغیر نہ چھوڑتی", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4718, "text": "اور (قوم) ثمود (کے حال) میں (نشانی ہے) جب ان سے کہا گیا کہ ایک وقت تک فائدہ اٹھالو", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4719, "text": "تو انہوں نے اپنے پروردگار کے حکم سے سرکشی کی۔ سو ان کو کڑک نے آ پکڑا اور وہ دیکھ رہے تھے", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4720, "text": "پھر وہ نہ تو اُٹھنے کی طاقت رکھتے تھے اور نہ مقابلہ ہی کرسکتے تھے", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4721, "text": "اور اس سے پہلے (ہم) نوح کی قوم کو (ہلاک کرچکے تھے) بےشک وہ نافرمان لوگ تھے", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4722, "text": "اور آسمانوں کو ہم ہی نے ہاتھوں سے بنایا اور ہم کو سب مقدور ہے", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4723, "text": "اور زمین کو ہم ہی نے بچھایا تو (دیکھو) ہم کیا خوب بچھانے والے ہیں", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4724, "text": "اور ہر چیز کی ہم نے دو قسمیں بنائیں تاکہ تم نصیحت پکڑو", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4725, "text": "تو تم لوگ خدا کی طرف بھاگ چلو میں اس کی طرف سے تم کو صریح رستہ بتانے والا ہوں", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4726, "text": "اور خدا کے ساتھ کسی اَور کو معبود نہ بناؤ۔ میں اس کی طرف سے تم کو صریح رستہ بتانے والا ہوں", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4727, "text": "اسی طرح ان سے پہلے لوگوں کے پاس جو پیغمبر آتا وہ اس کو جادوگر یا دیوانہ کہتے", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4728, "text": "کیا یہ کہ ایک دوسرے کو اسی بات کی وصیت کرتے آئے ہیں بلکہ یہ شریر لوگ ہیں", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4729, "text": "تو ان سے اعراض کرو۔ تم کو (ہماری) طرف سے ملامت نہ ہوگی", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4730, "text": "اور نصیحت کرتے رہو کہ نصیحت مومنوں کو نفع دیتی ہے", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4731, "text": "اور میں نے جنوں اور انسانوں کو اس لئے پیدا کیا ہے کہ میری عبادت کریں", "numberInSurah": 56, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4732, "text": "میں ان سے طالب رزق نہیں اور نہ یہ چاہتا ہوں کہ مجھے (کھانا) کھلائیں", "numberInSurah": 57, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4733, "text": "خدا ہی تو رزق دینے والا زور آور اور مضبوط ہے", "numberInSurah": 58, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4734, "text": "کچھ شک نہیں کہ ان ظالموں کے لئے بھی (عذاب کی) نوبت مقرر ہے جس طرح ان کے ساتھیوں کی نوبت تھی تو ان کو مجھ سے (عذاب) جلدی نہیں طلب کرنا چاہیئے", "numberInSurah": 59, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4735, "text": "جس دن کا ان کافروں سے وعدہ کیا جاتا ہے اس سے ان کے لئے خرابی ہے", "numberInSurah": 60, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 51, "name": "سُورَةُ الذَّارِيَاتِ", "englishName": "Adh-Dhaariyat", "englishNameTranslation": "The Winnowing Winds", "revelationType": "Meccan", "numberOfAyahs": 60, "ayahs": [{"number": 4676, "text": "Waz-zaariyaati zarwaa", "numberInSurah": 1, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4677, "text": "Falhaamilaati wiqraa", "numberInSurah": 2, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4678, "text": "Faljaariyaati yusraa", "numberInSurah": 3, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4679, "text": "Falmuqassimaati amraa", "numberInSurah": 4, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4680, "text": "Innamaa too'adoona la-saadiq", "numberInSurah": 5, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4681, "text": "Wa innad deena la waaqi'", "numberInSurah": 6, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4682, "text": "Wassamaaa'i zaatil hubuk", "numberInSurah": 7, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4683, "text": "Innakum lafee qawlim mukhtalif", "numberInSurah": 8, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4684, "text": "Yu'faku 'anhu man ufik", "numberInSurah": 9, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4685, "text": "Qutilal kharraasoon", "numberInSurah": 10, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4686, "text": "Allazeena hum fee ghamratin saahoon", "numberInSurah": 11, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4687, "text": "Yas'aloona ayyaana yawmud Deen", "numberInSurah": 12, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4688, "text": "Yawma hum 'alan naari yuftanoon", "numberInSurah": 13, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4689, "text": "Zooqoo fitnatakum haa zal lazee kuntum bihee tas ta'jiloon", "numberInSurah": 14, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4690, "text": "Innal muttaqeena fee jannaatinw wa 'uyoon", "numberInSurah": 15, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4691, "text": "Aakhizeena maaa aataahum Rabbuhum; innahum kaanoo qabla zaalika muhsineen", "numberInSurah": 16, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4692, "text": "kaanoo qaleelam minal laili maa yahja'oon", "numberInSurah": 17, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4693, "text": "Wa bilashaari hum yastaghfiroon", "numberInSurah": 18, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4694, "text": "Wa feee amwaalihim haqqul lissaaa'ili walmahroom", "numberInSurah": 19, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4695, "text": "Wa fil ardi aayaatul lilmooqineen", "numberInSurah": 20, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4696, "text": "Wa feee anfusikum; afalaa tubsiroon", "numberInSurah": 21, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4697, "text": "Wa fissamaaa'i rizqukum wa maa too'adoon", "numberInSurah": 22, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4698, "text": "Fawa Rabbis samaaa'i wal ardi innahoo lahaqqum misla maa annakum tantiqoon", "numberInSurah": 23, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4699, "text": "Hal ataaka hadeesu daifi Ibraaheemal mukrameen", "numberInSurah": 24, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4700, "text": "Iz dakhaloo 'alaihi faqaaloo salaaman qaala salaamun qawmum munkaroon", "numberInSurah": 25, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4701, "text": "Faraagha ilaaa ahlihee fajaaa'a bi'ijlin sameen", "numberInSurah": 26, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4702, "text": "Faqarrabahooo ilaihim qaala alaa taakuloon", "numberInSurah": 27, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4703, "text": "Fa awjasa minhm khee fatan qaaloo laa takhaf wa bashsharoohu bighulaamin 'aleem", "numberInSurah": 28, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4704, "text": "Fa aqbalatim ra-atuhoo fee sarratin fasakkat wajhahaa wa qaalat 'ajoozun 'aqeem", "numberInSurah": 29, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4705, "text": "Qaaloo kazaaliki qaala Rabbuki innahoo huwal hakeemul 'aleem", "numberInSurah": 30, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4706, "text": "Qaala famaa khatbukum ayyuhal mursaloon", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4707, "text": "Qaalooo innaaa ursilnaaa ilaa qawmim mujrimeen", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4708, "text": "Linursila 'alaihim hijaa ratam min teen", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4709, "text": "Musawwamatan 'inda rabbika lilmusrifeen", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4710, "text": "Fa akhrajnaa man kaana feehaa minal mu'mineen", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4711, "text": "Famaa wajadnaa feehaa ghaira baitim minal muslimeen", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4712, "text": "Wa taraknaa feehaaa aayatal lillazeena yakhaafoonal 'azaabal aleem", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4713, "text": "Wa fee Moosaaa iz arsalnaahu ilaa Fir'wna bisultaa nim mubeen", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4714, "text": "Fatawalla biruknihee wa qaala saahirun aw majnoon", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4715, "text": "Fa akhaznaahu wa junoo dahoo fanabaznaahum fil yammi wa huwa muleem", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4716, "text": "Wa fee 'Aadin iz arsalnaa 'alaihimur reehal'aqeem", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4717, "text": "Maa tazaru min shai'in atat 'alaihi illaa ja'alat hu karrameem", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4718, "text": "Wa fee Samooda iz qeela lahum tamatta''oo hattaa heen", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4719, "text": "Fa'ataw 'an amri Rabbihim fa akhazal humus saa'iqatu wa hum yanzuroon", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4720, "text": "Famas tataa'oo min qiyaaminw wa maa kaanoo muntasireen", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4721, "text": "Wa qawma Noohim min qablu innahum kaano qawman faasiqeen", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4722, "text": "Wassamaaa'a banainaa haa bi aydinw wa innaa lamoosi'oon", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4723, "text": "Wal arda farashnaahaa fani'mal maahidoon", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4724, "text": "Wa min kulli shai'in khalaqnaa zawjaini la'allakum tazakkaroon", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4725, "text": "Fafirrooo ilal laahi innee lakum minhu nazeerum mubeen", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4726, "text": "Wa laa taj'aloo ma'al laahi ilaahan aakhara innee lakum minhu nazeerum mubeen", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4727, "text": "Kazaalika maaa atal lazeena min qablihim mir Rasoolin illaa qaaloo saahirun aw majnoon", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4728, "text": "Atawaasaw bih; bal hum qawmun taaghoon", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4729, "text": "Fatawalla 'anhum famaaa anta bimaloom", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4730, "text": "Wa zakkir fa innaz zikraa tanfa'ul mu'mineen", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4731, "text": "Wa maa khalaqtul jinna wal insa illaa liya'budoon", "numberInSurah": 56, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4732, "text": "Maaa ureedu minhum mir rizqinw wa maaa ureedu anyyut'imoon", "numberInSurah": 57, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4733, "text": "Innal laaha Huwar Razzaaqu Zul Quwwatil Mateen", "numberInSurah": 58, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4734, "text": "Fa inna lillazeena zalamoo zanoobam misla zanoobi ashaabihim falaa yasta'jiloon", "numberInSurah": 59, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4735, "text": "Fawailul lillazeena kafaroo miny yawmihimul lazee yoo'adoon", "numberInSurah": 60, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]