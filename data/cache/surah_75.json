[{"number": 75, "name": "سُورَةُ القِيَامَةِ", "englishName": "Al-Qiyaama", "englishNameTranslation": "The Resurrection", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5552, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5553, "text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5554, "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5555, "text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5556, "text": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5557, "text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5558, "text": "فَإِذَا بَرِقَ ٱلْبَصَرُ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5559, "text": "وَخَسَفَ ٱلْقَمَرُ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5560, "text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5561, "text": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5562, "text": "كَلَّا لَا وَزَرَ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5563, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5564, "text": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5565, "text": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5566, "text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5567, "text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5568, "text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5569, "text": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5570, "text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5571, "text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5572, "text": "وَتَذَرُونَ ٱلْءَاخِرَةَ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5573, "text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5574, "text": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5575, "text": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5576, "text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5577, "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5578, "text": "وَقِيلَ مَنْ ۜ رَاقٍۢ", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5579, "text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5580, "text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5581, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5582, "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5583, "text": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5584, "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5585, "text": "أَوْلَىٰ لَكَ فَأَوْلَىٰ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5586, "text": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5587, "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5588, "text": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5589, "text": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5590, "text": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5591, "text": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 75, "name": "سُورَةُ القِيَامَةِ", "englishName": "Al-Qiyaama", "englishNameTranslation": "The Resurrection", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5552, "text": "ہم کو روز قیامت کی قسم", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5553, "text": "اور نفس لوامہ کی (کہ سب لوگ اٹھا کر) کھڑے کئے جائیں گے", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5554, "text": "کیا انسان یہ خیال کرتا ہے کہ ہم اس کی (بکھری ہوئی) ہڈیاں اکٹھی نہیں کریں گے؟", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5555, "text": "ضرور کریں گے (اور) ہم اس بات پر قادر ہیں کہ اس کی پور پور درست کردیں", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5556, "text": "مگر انسان چاہتا ہے کہ آگے کو خود سری کرتا جائے", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5557, "text": "پوچھتا ہے کہ قیامت کا دن کب ہوگا؟", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5558, "text": "جب آنکھیں چندھیا جائیں", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5559, "text": "اور چاند گہنا جائے", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5560, "text": "اور سورج اور چاند جمع کردیئے جائیں", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5561, "text": "اس دن انسان کہے گا کہ (اب) کہاں بھاگ جاؤں؟", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5562, "text": "بےشک کہیں پناہ نہیں", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5563, "text": "اس روز پروردگار ہی کے پاس ٹھکانا ہے", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5564, "text": "اس دن انسان کو جو (عمل) اس نے آگے بھیجے اور پیچھے چھوڑے ہوں گے سب بتا دیئے جائیں گے", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5565, "text": "بلکہ انسان آپ اپنا گواہ ہے", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5566, "text": "اگرچہ عذر ومعذرت کرتا رہے", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5567, "text": "اور (اے محمدﷺ) وحی کے پڑھنے کے لئے اپنی زبان نہ چلایا کرو کہ اس کو جلد یاد کرلو", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5568, "text": "اس کا جمع کرنا اور پڑھانا ہمارے ذمے ہے", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5569, "text": "جب ہم وحی پڑھا کریں تو تم (اس کو سنا کرو اور) پھر اسی طرح پڑھا کرو", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5570, "text": "پھر اس (کے معانی) کا بیان بھی ہمارے ذمے ہے", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5571, "text": "مگر (لوگو) تم دنیا کو دوست رکھتے ہو", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5572, "text": "اور آخرت کو ترک کئے دیتے ہو", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5573, "text": "اس روز بہت سے منہ رونق دار ہوں گے", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5574, "text": "اور) اپنے پروردگار کے محو دیدار ہوں گے", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5575, "text": "اور بہت سے منہ اس دن اداس ہوں گے", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5576, "text": "خیال کریں گے کہ ان پر مصیبت واقع ہونے کو ہے", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5577, "text": "دیکھو جب جان گلے تک پہنچ جائے", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5578, "text": "اور لوگ کہنے لگیں (اس وقت) کون جھاڑ پھونک کرنے والا ہے", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5579, "text": "اور اس (جان بلب) نے سمجھا کہ اب سب سے جدائی ہے", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5580, "text": "اور پنڈلی سے پنڈلی لپٹ جائے", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5581, "text": "اس دن تجھ کو اپنے پروردگار کی طرف چلنا ہے", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5582, "text": "تو اس (ناعاقبت) اندیش نے نہ تو (کلام خدا) کی تصدیق کی نہ نماز پڑھی", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5583, "text": "بلکہ جھٹلایا اور منہ پھیر لیا", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5584, "text": "پھر اپنے گھر والوں کے پاس اکڑتا ہوا چل دیا", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5585, "text": "افسوس ہے تجھ پر پھر افسوس ہے", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5586, "text": "پھر افسوس ہے تجھ پر پھر افسوس ہے", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5587, "text": "کیا انسان خیال کرتا ہے کہ یوں ہی چھوڑ دیا جائے گا؟", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5588, "text": "کیا وہ منی کا جو رحم میں ڈالی جاتی ہے ایک قطرہ نہ تھا؟", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5589, "text": "پھر لوتھڑا ہوا پھر (خدا نے) اس کو بنایا پھر (اس کے اعضا کو) درست کیا", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5590, "text": "پھر اس کی دو قسمیں بنائیں (ایک) مرد اور (ایک) عورت", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5591, "text": "کیا اس خالق کو اس بات پر قدرت نہیں کہ مردوں کو جلا اُٹھائے؟", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 75, "name": "سُورَةُ القِيَامَةِ", "englishName": "Al-Qiyaama", "englishNameTranslation": "The Resurrection", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5552, "text": "Laaa uqsimu bi yawmil qiyaamah", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5553, "text": "Wa laaa uqsimu bin nafsil lawwaamah", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5554, "text": "Ayahsabul insaanu al lan najm'a 'izaamah", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5555, "text": "Balaa qaadireena 'alaaa an nusawwiya banaanah", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5556, "text": "Bal yureedul insaanu liyafjura amaamah", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5557, "text": "Yas'alu ayyyaana yawmul qiyaamah", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5558, "text": "Fa izaa bariqal basar", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5559, "text": "We khasafal qamar", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5560, "text": "Wa jumi'ash shamusu wal qamar", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5561, "text": "Yaqoolul insaanu yaw ma 'izin aynal mafarr", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5562, "text": "Kallaa laa wazar", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5563, "text": "Ilaa rabbika yawma 'izinil mustaqarr", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5564, "text": "Yunabba 'ul insaanu yawma 'izim bimaa qaddama wa akhkhar", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5565, "text": "Balil insaanu 'alaa nafsihee baseerah", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5566, "text": "Wa law alqaa ma'aazeerah", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5567, "text": "Laa tuharrik bihee lisaa naka lita'jala bih", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5568, "text": "Inna 'alainaa jam'ahoo wa qur aanah", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5569, "text": "Fa izaa qaraanaahu fattabi' qur aanah", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5570, "text": "Summa inna 'alainaa bayaanah", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5571, "text": "Kallaa bal tuhibboonal 'aajilah", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5572, "text": "Wa tazaroonal Aakhirah", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5573, "text": "Wujoohuny yawma 'izin naadirah", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5574, "text": "Ilaa rabbihaa naazirah", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5575, "text": "Wa wujoohuny yawma 'izim baasirah", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5576, "text": "Tazunnu any yuf'ala bihaa faaqirah", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5577, "text": "Kallaaa izaa balaghatit taraaqee", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5578, "text": "Wa qeela man raaq", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5579, "text": "Wa zanna annahul firaaq", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5580, "text": "Waltaffatis saaqu bissaaq", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5581, "text": "Ilaa rabbika yawma'izinil masaaq", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5582, "text": "Falaa saddaqa wa laa sallaa", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5583, "text": "Wa laakin kazzaba wa tawalla", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5584, "text": "Summa zahaba ilaaa ahlihee yatamatta", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5585, "text": "Awlaa laka fa awlaa", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5586, "text": "Summa awlaa laka fa awla", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5587, "text": "Ayahsabul insaanu anyytraka sudaa", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5588, "text": "Alam yaku nutfatam mim maniyyiny yumnaa", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5589, "text": "Summa kaana 'alaqata fakhalaq fasawwaa", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5590, "text": "Faja'ala minhuz zawjayniz zakara wal unsaa", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5591, "text": "Alaisa zaalika biqaadirin 'alaaa any yuhyiyal mawtaa", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]