[{"number": 96, "name": "سُورَةُ العَلَقِ", "englishName": "Al-Alaq", "englishNameTranslation": "The Clot", "revelationType": "Meccan", "numberOfAyahs": 19, "ayahs": [{"number": 6107, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6108, "text": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6109, "text": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6110, "text": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6111, "text": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6112, "text": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6113, "text": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6114, "text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6115, "text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6116, "text": "عَبْدًا إِذَا صَلَّىٰٓ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6117, "text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6118, "text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6119, "text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6120, "text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6121, "text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6122, "text": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6123, "text": "فَلْيَدْعُ نَادِيَهُۥ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6124, "text": "سَنَدْعُ ٱلزَّبَانِيَةَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6125, "text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": {"id": 15, "recommended": false, "obligatory": true}}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 96, "name": "سُورَةُ العَلَقِ", "englishName": "Al-Alaq", "englishNameTranslation": "The Clot", "revelationType": "Meccan", "numberOfAyahs": 19, "ayahs": [{"number": 6107, "text": "(اے محمدﷺ) اپنے پروردگار کا نام لے کر پڑھو جس نے (عالم کو) پیدا کیا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6108, "text": "جس نے انسان کو خون کی پھٹکی سے بنایا", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6109, "text": "پڑھو اور تمہارا پروردگار بڑا کریم ہے", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6110, "text": "جس نے قلم کے ذریعے سے علم سکھایا", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6111, "text": "اور انسان کو وہ باتیں سکھائیں جس کا اس کو علم نہ تھا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6112, "text": "مگر انسان سرکش ہو جاتا ہے", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6113, "text": "جب کہ اپنے تیئں غنی دیکھتا ہے", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6114, "text": "کچھ شک نہیں کہ (اس کو) تمہارے پروردگار ہی کی طرف لوٹ کر جانا ہے", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6115, "text": "بھلا تم نے اس شخص کو دیکھا جو منع کرتا ہے", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6116, "text": "(یعنی) ایک بندے کو جب وہ نماز پڑھنے لگتا ہے", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6117, "text": "بھلا دیکھو تو اگر یہ راہِ راست پر ہو", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6118, "text": "یا پرہیز گاری کا حکم کرے (تو منع کرنا کیسا)", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6119, "text": "اور دیکھو تو اگر اس نے دین حق کو جھٹلایا اور اس سے منہ موڑا (تو کیا ہوا)", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6120, "text": "کیااس کو معلوم نہیں کہ خدا دیکھ رہا ہے", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6121, "text": "دیکھو اگر وہ باز نہ آئے گا تو ہم (اس کی) پیشانی کے بال پکڑ گھسیٹیں گے", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6122, "text": "یعنی اس جھوٹے خطاکار کی پیشانی کے بال", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6123, "text": "تو وہ اپنے یاروں کی مجلس کو بلالے", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6124, "text": "ہم بھی اپنے موکلانِ دوزخ کو بلا لیں گے", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6125, "text": "دیکھو اس کا کہا نہ ماننا اور قربِ (خدا) حاصل کرتے رہنا", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": {"id": 15, "recommended": false, "obligatory": true}}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 96, "name": "سُورَةُ العَلَقِ", "englishName": "Al-Alaq", "englishNameTranslation": "The Clot", "revelationType": "Meccan", "numberOfAyahs": 19, "ayahs": [{"number": 6107, "text": "Iqra bismi rab bikal lazee khalaq", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6108, "text": "Khalaqal insaana min 'alaq", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6109, "text": "Iqra wa rab bukal akram", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6110, "text": "Al lazee 'allama bil qalam", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6111, "text": "'Al lamal insaana ma lam y'alam", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6112, "text": "Kallaa innal insaana layatghaa", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6113, "text": "Ar-ra aahus taghnaa", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6114, "text": "Innna ilaa rabbikar ruj'aa", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6115, "text": "Ara-aital lazee yanhaa", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6116, "text": "'Abdan iza sallaa", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6117, "text": "Ara-aita in kana 'alal hudaa", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6118, "text": "Au amara bit taqwaa", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6119, "text": "Ara-aita in kaz zaba wa ta walla", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6120, "text": "Alam y'alam bi-an nal lahaa yaraa", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6121, "text": "Kalla la illam yantahi la nasfa'am bin nasiyah", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6122, "text": "Nasiyatin kazi batin khaatiyah", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6123, "text": "Fal yad'u naadiyah", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6124, "text": "Sanad 'uz zabaaniyah", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6125, "text": "Kalla; la tuti'hu wasjud waqtarib", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": {"id": 15, "recommended": false, "obligatory": true}}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]