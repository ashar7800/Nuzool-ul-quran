[{"number": 110, "name": "سُورَةُ النَّصۡرِ", "englishName": "An-Nasr", "englishNameTranslation": "Divine Support", "revelationType": "Medinan", "numberOfAyahs": 3, "ayahs": [{"number": 6214, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 603, "ruku": 552, "hizbQuarter": 240, "sajda": false}, {"number": 6215, "text": "وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًۭا", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 603, "ruku": 552, "hizbQuarter": 240, "sajda": false}, {"number": 6216, "text": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 603, "ruku": 552, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 110, "name": "سُورَةُ النَّصۡرِ", "englishName": "An-Nasr", "englishNameTranslation": "Divine Support", "revelationType": "Medinan", "numberOfAyahs": 3, "ayahs": [{"number": 6214, "text": "جب خدا کی مدد آ پہنچی اور فتح (حاصل ہو گئی)", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 603, "ruku": 552, "hizbQuarter": 240, "sajda": false}, {"number": 6215, "text": "اور تم نے دیکھ لیا کہ لوگ غول کے غول خدا کے دین میں داخل ہو رہے ہیں", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 603, "ruku": 552, "hizbQuarter": 240, "sajda": false}, {"number": 6216, "text": "تو اپنے پروردگار کی تعریف کے ساتھ تسبیح کرو اور اس سے مغفرت مانگو، بے شک وہ معاف کرنے والا ہے", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 603, "ruku": 552, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 110, "name": "سُورَةُ النَّصۡرِ", "englishName": "An-Nasr", "englishNameTranslation": "Divine Support", "revelationType": "Medinan", "numberOfAyahs": 3, "ayahs": [{"number": 6214, "text": "Iza jaa-a nas rullahi walfath", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 603, "ruku": 552, "hizbQuarter": 240, "sajda": false}, {"number": 6215, "text": "Wa ra-aitan naasa yadkhuloona fee deenil laahi afwajah", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 603, "ruku": 552, "hizbQuarter": 240, "sajda": false}, {"number": 6216, "text": "Fa sab bih bihamdi rabbika was taghfir, innahu kaana tawwaaba", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 603, "ruku": 552, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]