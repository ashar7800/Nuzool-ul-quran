[{"number": 97, "name": "سُورَةُ القَدۡرِ", "englishName": "Al-Qadr", "englishNameTranslation": "The Power, Fate", "revelationType": "Meccan", "numberOfAyahs": 5, "ayahs": [{"number": 6126, "text": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6127, "text": "وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6128, "text": "لَيْلَةُ ٱلْقَدْرِ خَيْرٌۭ مِّنْ أَلْفِ شَهْرٍۢ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6129, "text": "تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍۢ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6130, "text": "سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 97, "name": "سُورَةُ القَدۡرِ", "englishName": "Al-Qadr", "englishNameTranslation": "The Power, Fate", "revelationType": "Meccan", "numberOfAyahs": 5, "ayahs": [{"number": 6126, "text": "ہم نے اس (قرآن) کو شب قدر میں نازل (کرنا شروع) کیا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6127, "text": "اور تمہیں کیا معلوم کہ شب قدر کیا ہے؟", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6128, "text": "شب قدر ہزار مہینے سے بہتر ہے", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6129, "text": "اس میں روح (الامین) اور فرشتے ہر کام کے (انتظام کے) لیے اپنے پروردگار کے حکم سے اترتے ہیں", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6130, "text": "یہ (رات) طلوع صبح تک (امان اور) سلامتی ہے", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 97, "name": "سُورَةُ القَدۡرِ", "englishName": "Al-Qadr", "englishNameTranslation": "The Power, Fate", "revelationType": "Meccan", "numberOfAyahs": 5, "ayahs": [{"number": 6126, "text": "Innaa anzalnaahu fee lailatil qadr", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6127, "text": "Wa maa adraaka ma lailatul qadr", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6128, "text": "Lailatul qadri khairum min alfee shahr", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6129, "text": "Tanaz zalul malaa-ikatu war roohu feeha bi izni-rab bihim min kulli amr", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}, {"number": 6130, "text": "Salaamun hiya hattaa mat la'il fajr", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 598, "ruku": 539, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]