[{"number": 95, "name": "سُورَةُ التِّينِ", "englishName": "At-Tin", "englishNameTranslation": "The Fig", "revelationType": "Meccan", "numberOfAyahs": 8, "ayahs": [{"number": 6099, "text": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6100, "text": "وَطُورِ سِينِينَ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6101, "text": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6102, "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6103, "text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6104, "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6105, "text": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6106, "text": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 95, "name": "سُورَةُ التِّينِ", "englishName": "At-Tin", "englishNameTranslation": "The Fig", "revelationType": "Meccan", "numberOfAyahs": 8, "ayahs": [{"number": 6099, "text": "انجیر کی قسم اور زیتون کی", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6100, "text": "اور طور سینین کی", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6101, "text": "اور اس امن والے شہر کی", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6102, "text": "کہ ہم نے انسان کو بہت اچھی صورت میں پیدا کیا ہے", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6103, "text": "پھر (رفتہ رفتہ) اس (کی حالت) کو (بدل کر) پست سے پست کر دیا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6104, "text": "مگر جو لوگ ایمان لائے اور نیک عمل کرتے رہے انکے لیے بےانتہا اجر ہے", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6105, "text": "تو (اے آدم زاد) پھر تو جزا کے دن کو کیوں جھٹلاتا ہے؟", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6106, "text": "کیا خدا سب سے بڑا حاکم نہیں ہے؟", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 95, "name": "سُورَةُ التِّينِ", "englishName": "At-Tin", "englishNameTranslation": "The Fig", "revelationType": "Meccan", "numberOfAyahs": 8, "ayahs": [{"number": 6099, "text": "Wat teeni waz zaitoon", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6100, "text": "Wa toori sineen", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6101, "text": "Wa haazal balad-il ameen", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6102, "text": "Laqad khalaqnal insaana fee ahsani taqweem", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6103, "text": "Thumma ra dad naahu asfala saafileen", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6104, "text": "Ill-lal lazeena aamanoo wa 'amilus saalihaati; falahum ajrun ghairu mamnoon", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6105, "text": "Fama yu kaz zibuka b'adu bid deen", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6106, "text": "Alai sal laahu bi-ahkamil haakimeen", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]