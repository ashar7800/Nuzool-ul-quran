[{"number": 88, "name": "سُورَةُ الغَاشِيَةِ", "englishName": "Al-Ghaashiya", "englishNameTranslation": "The Overwhelming", "revelationType": "Meccan", "numberOfAyahs": 26, "ayahs": [{"number": 5968, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5969, "text": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5970, "text": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5971, "text": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5972, "text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5973, "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5974, "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5975, "text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5976, "text": "لِّسَعْيِهَا رَاضِيَةٌۭ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5977, "text": "فِى جَنَّةٍ عَالِيَةٍۢ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5978, "text": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5979, "text": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5980, "text": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5981, "text": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5982, "text": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5983, "text": "وَزَرَابِىُّ مَبْثُوثَةٌ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5984, "text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5985, "text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5986, "text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5987, "text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5988, "text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5989, "text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5990, "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5991, "text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5992, "text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5993, "text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 88, "name": "سُورَةُ الغَاشِيَةِ", "englishName": "Al-Ghaashiya", "englishNameTranslation": "The Overwhelming", "revelationType": "Meccan", "numberOfAyahs": 26, "ayahs": [{"number": 5968, "text": "بھلا تم کو ڈھانپ لینے والی (یعنی قیامت کا) حال معلوم ہوا ہے", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5969, "text": "اس روز بہت سے منہ (والے) ذلیل ہوں گے", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5970, "text": "سخت محنت کرنے والے تھکے ماندے", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5971, "text": "دہکتی آگ میں داخل ہوں گے", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5972, "text": "ایک کھولتے ہوئے چشمے کا ان کو پانی پلایا جائے گا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5973, "text": "اور خار دار جھاڑ کے سوا ان کے لیے کوئی کھانا نہیں (ہو گا)", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5974, "text": "جو نہ فربہی لائے اور نہ بھوک میں کچھ کام آئے", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5975, "text": "اور بہت سے منہ (والے) اس روز شادماں ہوں گے", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5976, "text": "اپنے اعمال (کی جزا) سے خوش دل", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5977, "text": "بہشت بریں میں", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5978, "text": "وہاں کسی طرح کی بکواس نہیں سنیں گے", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5979, "text": "اس میں چشمے بہ رہے ہوں گے", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5980, "text": "وہاں تخت ہوں گے اونچے بچھے ہوئے", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5981, "text": "اور آبخورے (قرینے سے) رکھے ہوئے", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5982, "text": "اور گاؤ تکیے قطار کی قطار لگے ہوئے", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5983, "text": "اور نفیس مسندیں بچھی ہوئی", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5984, "text": "یہ لوگ اونٹوں کی طرف نہیں دیکھتے کہ کیسے (عجیب) پیدا کیے گئے ہیں", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5985, "text": "اور آسمان کی طرف کہ کیسا بلند کیا گیا ہے", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5986, "text": "اور پہاڑوں کی طرف کہ کس طرح کھڑے کیے گئے ہیں", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5987, "text": "اور زمین کی طرف کہ کس طرح بچھائی گئی", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5988, "text": "تو تم نصیحت کرتے رہو کہ تم نصیحت کرنے والے ہی ہو", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5989, "text": "تم ان پر داروغہ نہیں ہو", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5990, "text": "ہاں جس نے منہ پھیرا اور نہ مانا", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5991, "text": "تو خدا اس کو بڑا عذاب دے گا", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5992, "text": "بےشک ان کو ہمارے پاس لوٹ کر آنا ہے", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5993, "text": "پھر ہم ہی کو ان سے حساب لینا ہے", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 88, "name": "سُورَةُ الغَاشِيَةِ", "englishName": "Al-Ghaashiya", "englishNameTranslation": "The Overwhelming", "revelationType": "Meccan", "numberOfAyahs": 26, "ayahs": [{"number": 5968, "text": "Hal ataaka hadeesul ghaashiyah", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5969, "text": "Wujoohuny yawma 'izin khaashi'ah", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5970, "text": "'Aamilatun naasibah", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5971, "text": "Taslaa naaran haamiyah", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5972, "text": "Tusqaa min 'aynin aaniyah", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5973, "text": "Laisa lahum ta'aamun illaa min daree'", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5974, "text": "Laa yusminu wa laa yughnee min joo'", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5975, "text": "Wujoohuny yawma 'izin naa'imah", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5976, "text": "Lisa'yihaa raadiyah", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5977, "text": "Fee jannatin 'aaliyah", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5978, "text": "Laa tasma'u feehaa laaghiyah", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5979, "text": "Feehaa 'aynun jaariyah", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5980, "text": "Feehaa sururum marfoo'ah", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5981, "text": "Wa akwaabum mawdoo 'ah", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5982, "text": "Wa namaariqu masfoofah", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5983, "text": "Wa zaraabiyyu mabsoosah", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5984, "text": "Afalaa yanzuroona ilalibili kaifa khuliqat", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5985, "text": "Wa ilas samaaa'i kaifa rufi'at", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5986, "text": "Wa ilal jibaali kaifa nusibat", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5987, "text": "Wa ilal ardi kaifa sutihat", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5988, "text": "Fazakkir innama anta Muzakkir", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5989, "text": "Lasta 'alaihim bimusaitir", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5990, "text": "Illaa man tawallaa wa kafar", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5991, "text": "Fa yu'azzibuhul laahul 'azaabal akbar", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5992, "text": "Innaa ilainaaa iyaabahum", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5993, "text": "Summa inna 'alainaa hisaabahum", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]