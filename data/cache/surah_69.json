[{"number": 69, "name": "سُورَةُ الحَاقَّةِ", "englishName": "Al-Haaqqa", "englishNameTranslation": "The Reality", "revelationType": "Meccan", "numberOfAyahs": 52, "ayahs": [{"number": 5324, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5325, "text": "مَا ٱلْحَآقَّةُ", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5326, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5327, "text": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5328, "text": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5329, "text": "وَأَمَّا عَادٌۭ فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ عَاتِيَةٍۢ", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5330, "text": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍۢ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًۭا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5331, "text": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍۢ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5332, "text": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5333, "text": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ رَّابِيَةً", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5334, "text": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5335, "text": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5336, "text": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌۭ وَٰحِدَةٌۭ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5337, "text": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ وَٰحِدَةًۭ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5338, "text": "فَيَوْمَئِذٍۢ وَقَعَتِ ٱلْوَاقِعَةُ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5339, "text": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍۢ وَاهِيَةٌۭ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5340, "text": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍۢ ثَمَٰنِيَةٌۭ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5341, "text": "يَوْمَئِذٍۢ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌۭ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5342, "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5343, "text": "إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5344, "text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5345, "text": "فِى جَنَّةٍ عَالِيَةٍۢ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5346, "text": "قُطُوفُهَا دَانِيَةٌۭ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5347, "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5348, "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5349, "text": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5350, "text": "يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5351, "text": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5352, "text": "هَلَكَ عَنِّى سُلْطَٰنِيَهْ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5353, "text": "خُذُوهُ فَغُلُّوهُ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5354, "text": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5355, "text": "ثُمَّ فِى سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5356, "text": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5357, "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5358, "text": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 568, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5359, "text": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 568, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5360, "text": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 568, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5361, "text": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5362, "text": "وَمَا لَا تُبْصِرُونَ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5363, "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5364, "text": "وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5365, "text": "وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5366, "text": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5367, "text": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5368, "text": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5369, "text": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5370, "text": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5371, "text": "وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5372, "text": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5373, "text": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5374, "text": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5375, "text": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 69, "name": "سُورَةُ الحَاقَّةِ", "englishName": "Al-Haaqqa", "englishNameTranslation": "The Reality", "revelationType": "Meccan", "numberOfAyahs": 52, "ayahs": [{"number": 5324, "text": "سچ مچ ہونے والی", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5325, "text": "وہ سچ مچ ہونے والی کیا ہے؟", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5326, "text": "اور تم کو کیا معلوم ہے کہ سچ مچ ہونے والی کیا ہے؟", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5327, "text": "کھڑکھڑانے والی (جس) کو ثمود اور عاد (دونوں) نے جھٹلایا", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5328, "text": "سو ثمود تو کڑک سے ہلاک کردیئے گئے", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5329, "text": "رہے عاد تو ان کا نہایت تیز آندھی سے ستیاناس کردیا گیا", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5330, "text": "خدا نے اس کو سات رات اور آٹھ دن لگاتار ان پر چلائے رکھا تو (اے مخاطب) تو لوگوں کو اس میں (اس طرح) ڈھئے (اور مرے) پڑے دیکھے جیسے کھجوروں کے کھوکھلے تنے", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5331, "text": "بھلا تو ان میں سے کسی کو بھی باقی دیکھتا ہے؟", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5332, "text": "اور فرعون اور جو لوگ اس سے پہلے تھے اور وہ جو الٹی بستیوں میں رہتے تھے سب گناہ کے کام کرتے تھے", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5333, "text": "انہوں نے اپنے پروردگار کے پیغمبر کی نافرمانی کی تو خدا نے بھی ان کو بڑا سخت پکڑا", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5334, "text": "جب پانی طغیانی پر آیا تو ہم نے تم (لوگوں) کو کشتی میں سوار کرلیا", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5335, "text": "تاکہ اس کو تمہارے لئے یادگار بنائیں اور یاد رکھنے والے کان اسے یاد رکھیں", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5336, "text": "تو جب صور میں ایک (بار) پھونک مار دی جائے گی", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5337, "text": "اور زمین اور پہاڑ دونوں اٹھا لئے جائیں گے۔ پھر ایک بارگی توڑ پھوڑ کر برابر کردیئے جائیں گے", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5338, "text": "تو اس روز ہو پڑنے والی (یعنی قیامت) ہو پڑے گی", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5339, "text": "اور آسمان پھٹ جائے گا تو وہ اس دن کمزور ہوگا", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5340, "text": "اور فرشتے اس کے کناروں پر (اُتر آئیں گے) اور تمہارے پروردگار کے عرش کو اس روز آٹھ فرشتے اپنے سروں پر اُٹھائے ہوں گے", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5341, "text": "اس روز تم (سب لوگوں کے سامنے) پیش کئے جاؤ گے اور تمہاری کوئی پوشیدہ بات چھپی نہ رہے گی", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5342, "text": "تو جس کا (اعمال) نامہ اس کے داہنے ہاتھ میں دیا جائے گا وہ (دوسروں سے) کہے گا کہ لیجیئے میرا نامہ (اعمال) پڑھیئے", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5343, "text": "مجھے یقین تھا کہ مجھ کو میرا حساب (کتاب) ضرور ملے گا", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5344, "text": "پس وہ (شخص) من مانے عیش میں ہوگا", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5345, "text": "(یعنی) اونچے (اونچے محلوں) کے باغ میں", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5346, "text": "جن کے میوے جھکے ہوئے ہوں گے", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5347, "text": "جو (عمل) تم ایام گزشتہ میں آگے بھیج چکے ہو اس کے صلے میں مزے سے کھاؤ اور پیو", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5348, "text": "اور جس کا نامہ (اعمال) اس کے بائیں ہاتھ میں یاد جائے گا وہ کہے گا اے کاش مجھ کو میرا (اعمال) نامہ نہ دیا جاتا", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5349, "text": "اور مجھے معلوم نہ ہو کہ میرا حساب کیا ہے", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5350, "text": "اے کاش موت (ابد الاآباد کے لئے میرا کام) تمام کرچکی ہوتی", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5351, "text": "آج) میرا مال میرے کچھ بھی کام بھی نہ آیا", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5352, "text": "(ہائے) میری سلطنت خاک میں مل گئی", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5353, "text": "(حکم ہوگا کہ) اسے پکڑ لو اور طوق پہنا دو", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5354, "text": "پھر دوزخ کی آگ میں جھونک دو", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5355, "text": "پھر زنجیر سے جس کی ناپ ستر گز ہے جکڑ دو", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5356, "text": "یہ نہ تو خدائے جل شانہ پر ایمان لاتا تھا", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5357, "text": "اور نہ فقیر کے کھانا کھلانے پر آمادہ کرتا تھا", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5358, "text": "سو آج اس کا بھی یہاں کوئی دوستدار نہیں", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 568, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5359, "text": "اور نہ پیپ کے سوا (اس کے لئے) کھانا ہے", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 568, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5360, "text": "جس کو گنہگاروں کے سوا کوئی نہیں کھائے گا", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 568, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5361, "text": "تو ہم کو ان چیزوں کی قسم جو تم کو نظر آتی ہیں", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5362, "text": "اور ان کی جو نظر میں نہیں آتیں", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5363, "text": "کہ یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5364, "text": "اور یہ کسی شاعر کا کلام نہیں۔ مگر تم لوگ بہت ہی کم ایمان لاتے ہو", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5365, "text": "اور نہ کسی کاہن کے مزخرفات ہیں۔ لیکن تم لوگ بہت ہی کم فکر کرتے ہو", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5366, "text": "یہ تو) پروردگار عالم کا اُتارا (ہوا) ہے", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5367, "text": "اگر یہ پیغمبر ہماری نسبت کوئی بات جھوٹ بنا لاتے", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5368, "text": "تو ہم ان کا داہنا ہاتھ پکڑ لیتے", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5369, "text": "پھر ان کی رگ گردن کاٹ ڈالتے", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5370, "text": "پھر تم میں سے کوئی (ہمیں) اس سے روکنے والا نہ ہوتا", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5371, "text": "اور یہ (کتاب) تو پرہیزگاروں کے لئے نصیحت ہے", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5372, "text": "اور ہم جانتے ہیں کہ تم میں سے بعض اس کو جھٹلانے والے ہیں", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5373, "text": "نیز یہ کافروں کے لئے (موجب) حسرت ہے", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5374, "text": "اور کچھ شک نہیں کہ یہ برحق قابل یقین ہے", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5375, "text": "سو تم اپنے پروردگار عزوجل کے نام کی تنزیہ کرتے رہو", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 69, "name": "سُورَةُ الحَاقَّةِ", "englishName": "Al-Haaqqa", "englishNameTranslation": "The Reality", "revelationType": "Meccan", "numberOfAyahs": 52, "ayahs": [{"number": 5324, "text": "Al haaaqqah", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5325, "text": "Mal haaaqqah", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5326, "text": "Wa maaa adraaka mal haaaqqah", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5327, "text": "Kazzabat samoodu wa 'Aadum bil qaari'ah", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5328, "text": "Fa-ammaa Samoodu fauhlikoo bittaaghiyah", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5329, "text": "Wa ammaa 'Aadun fa uhlikoo bireehin sarsarin 'aatiyah", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5330, "text": "Sakhkharahaa 'alaihim sab'a la yaalinw wa samaaniyata ayyaamin husooman fataral qawma feehaa sar'aa ka annahum a'jaazu nakhlin khaawiyah", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5331, "text": "Fahal taraa lahum mim baaqiyah", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 566, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5332, "text": "Wa jaaa'a Firawnu wa man qablahoo wal mu'tafikaatu bilhaati'ah", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5333, "text": "Fa'ansaw Rasoola Rabbihim fa akhazahum akhzatar raabiyah", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5334, "text": "Innaa lammaa taghal maaa'u hamalnaakum fil jaariyah", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5335, "text": "Linaj'alahaa lakum tazki ratanw-wa ta'iyahaa unzununw waa'iyah", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5336, "text": "Fa izaa nufikha fis soori nafkhatunw waahidah", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5337, "text": "Wa humilatil ardu wal jibaalu fadukkataa dakkatanw waahidah", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5338, "text": "Fa yawma'izinw waqa'atil waaqi'ah", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5339, "text": "Wanshaqqatis samaaa'u fahiya yawma 'izinw-waahiyah", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5340, "text": "Wal malaku 'alaaa arjaaa'ihaa; wa yahmilu 'Arsha Rabbika fawqahum yawma'izin samaaniyah", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5341, "text": "Yawma'izin tu'radoona laa takhfaa min kum khaafiyah", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5342, "text": "Fa ammaa man ootiya kitaabahoo biyameenihee fa yaqoolu haaa'umuq ra'oo kitaabiyah", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5343, "text": "Innee zannantu annee mulaaqin hisaabiyah", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5344, "text": "Fahuwa fee 'eeshatir raadiyah", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5345, "text": "Fee jannnatin 'aaliyah", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5346, "text": "Qutoofuhaa daaniyah", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5347, "text": "Kuloo washraboo haneee'am bimaaa aslaftum fil ayyaamil khaliyah", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5348, "text": "Wa ammaa man ootiya kitaabahoo bishimaalihee fa yaqoolu yaalaitanee lam oota kitaaabiyah", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5349, "text": "Wa lam adri maa hisaabiyah", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5350, "text": "Yaa laitahaa kaanatil qaadiyah", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5351, "text": "Maaa aghnaa 'annee maaliyah", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5352, "text": "Halaka 'annee sultaaniyah", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5353, "text": "Khuzoohu faghullooh", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5354, "text": "Summal Jaheema sallooh", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5355, "text": "Summa fee silsilatin zar'uhaa sab'oona ziraa'an faslukooh", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5356, "text": "Innahoo kaana laa yu'minubillaahil 'Azeem", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5357, "text": "wa laa yahuddu 'alaa ta'aamil miskeen", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 567, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5358, "text": "Falaysa lahul yawma haahunaa hameem", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 568, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5359, "text": "Wa laa ta'aamun illaa min ghisleen", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 568, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5360, "text": "Laa yaakuluhooo illal khati'oon", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 568, "ruku": 500, "hizbQuarter": 227, "sajda": false}, {"number": 5361, "text": "Falaaa uqsimu bimaa tubsiroon", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5362, "text": "Wa maa laa tubsiroon", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5363, "text": "Innahoo laqawlu Rasoolin kareem", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5364, "text": "Wa ma huwa biqawli shaa'ir; qaleelam maa tu'minoon", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5365, "text": "Wa laa biqawli kaahin; qaleelam maa tazakkaroon", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5366, "text": "Tanzeelum mir rabbil 'aalameen", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5367, "text": "Wa law taqawwala 'alainaa ba'dal aqaaweel", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5368, "text": "La-akhaznaa minhu bilyameen", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5369, "text": "Summa laqata'naa minhul wateen", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5370, "text": "Famaa minkum min ahadin'anhu haajizeen", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5371, "text": "Wa innahoo latazkiratul lilmuttaqeen", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5372, "text": "Wa inna lana'lamu anna minkum mukazzibeen", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5373, "text": "Wa innahu lahasratun 'alal kaafireen", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5374, "text": "Wa innahoo lahaqqul yaqeen", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}, {"number": 5375, "text": "Fasbbih bismi Rabbikal 'Azeem", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 568, "ruku": 501, "hizbQuarter": 227, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]