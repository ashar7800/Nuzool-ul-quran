[{"number": 86, "name": "سُورَةُ الطَّارِقِ", "englishName": "At-Taariq", "englishNameTranslation": "The Morning Star", "revelationType": "Meccan", "numberOfAyahs": 17, "ayahs": [{"number": 5932, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5933, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5934, "text": "ٱلنَّجْمُ ٱلثَّاقِبُ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5935, "text": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5936, "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5937, "text": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5938, "text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5939, "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5940, "text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5941, "text": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5942, "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5943, "text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5944, "text": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5945, "text": "وَمَا هُوَ بِٱلْهَزْلِ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5946, "text": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5947, "text": "وَأَكِيدُ كَيْدًۭا", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5948, "text": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 86, "name": "سُورَةُ الطَّارِقِ", "englishName": "At-Taariq", "englishNameTranslation": "The Morning Star", "revelationType": "Meccan", "numberOfAyahs": 17, "ayahs": [{"number": 5932, "text": "آسمان اور رات کے وقت آنے والے کی قسم", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5933, "text": "اور تم کو کیا معلوم کہ رات کے وقت آنے والا کیا ہے", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5934, "text": "وہ تارا ہے چمکنے والا", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5935, "text": "کہ کوئی متنفس نہیں جس پر نگہبان مقرر نہیں", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5936, "text": "تو انسان کو دیکھنا چاہئے کہ وہ کاہے سے پیدا ہوا ہے", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5937, "text": "وہ اچھلتے ہوئے پانی سے پیدا ہوا ہے", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5938, "text": "جو پیٹھ اور سینے کے بیچ میں سے نکلتا ہے", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5939, "text": "بےشک خدا اس کے اعادے (یعنی پھر پیدا کرنے) پر قادر ہے", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5940, "text": "جس دن دلوں کے بھید جانچے جائیں گے", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5941, "text": "تو انسان کی کچھ پیش نہ چل سکے گی اور نہ کوئی اس کا مددگار ہو گا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5942, "text": "آسمان کی قسم جو مینہ برساتا ہے", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5943, "text": "اور زمین کی قسم جو پھٹ جاتی ہے", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5944, "text": "کہ یہ کلام (حق کو باطل سے) جدا کرنے والا ہے", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5945, "text": "اور بیہودہ بات نہیں ہے", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5946, "text": "یہ لوگ تو اپنی تدبیروں میں لگ رہے ہیں", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5947, "text": "اور ہم اپنی تدبیر کر رہے ہیں", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5948, "text": "تو تم کافروں کو مہلت دو بس چند روز ہی مہلت دو", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 86, "name": "سُورَةُ الطَّارِقِ", "englishName": "At-Taariq", "englishNameTranslation": "The Morning Star", "revelationType": "Meccan", "numberOfAyahs": 17, "ayahs": [{"number": 5932, "text": "Wassamaaa'i wattaariq", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5933, "text": "Wa maaa adraaka mattaariq", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5934, "text": "Annajmus saaqib", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5935, "text": "In kullu nafsil lammaa 'alaihaa haafiz", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5936, "text": "Fal yanzuril insaanu mimma khuliq", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5937, "text": "Khuliqa mim maaa'in daafiq", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5938, "text": "Yakhruju mim bainissulbi wat taraaa'ib", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5939, "text": "Innahoo 'alaa raj'ihee laqaadir", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5940, "text": "Yawma tublas saraaa'ir", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5941, "text": "Famaa lahoo min quwwatinw wa laa naasir", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5942, "text": "Wassamaaa'i zaatir raj'", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5943, "text": "Wal ardi zaatis sad'", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5944, "text": "Innahoo laqawlun fasl", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5945, "text": "Wa maa huwa bil hazl", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5946, "text": "Innahum yakeedoona kaidaa", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5947, "text": "Wa akeedu kaidaa", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}, {"number": 5948, "text": "Famahhilil kaafireena amhilhum ruwaidaa", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 591, "ruku": 528, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]