[{"number": 77, "name": "سُورَةُ المُرۡسَلَاتِ", "englishName": "Al-Mursalaat", "englishNameTranslation": "The Emissaries", "revelationType": "Meccan", "numberOfAyahs": 50, "ayahs": [{"number": 5623, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5624, "text": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5625, "text": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5626, "text": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5627, "text": "فَٱلْمُلْقِيَٰتِ ذِكْرًا", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5628, "text": "عُذْرًا أَوْ نُذْرًا", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5629, "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5630, "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5631, "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5632, "text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5633, "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5634, "text": "لِأَىِّ يَوْمٍ أُجِّلَتْ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5635, "text": "لِيَوْمِ ٱلْفَصْلِ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5636, "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5637, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5638, "text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5639, "text": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5640, "text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5641, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5642, "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5643, "text": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5644, "text": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5645, "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5646, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5647, "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5648, "text": "أَحْيَآءًۭ وَأَمْوَٰتًۭا", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5649, "text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5650, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5651, "text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5652, "text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5653, "text": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5654, "text": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5655, "text": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5656, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5657, "text": "هَٰذَا يَوْمُ لَا يَنطِقُونَ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5658, "text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5659, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5660, "text": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5661, "text": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5662, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5663, "text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5664, "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5665, "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5666, "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5667, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5668, "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5669, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5670, "text": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5671, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5672, "text": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 77, "name": "سُورَةُ المُرۡسَلَاتِ", "englishName": "Al-Mursalaat", "englishNameTranslation": "The Emissaries", "revelationType": "Meccan", "numberOfAyahs": 50, "ayahs": [{"number": 5623, "text": "ہواؤں کی قسم جو نرم نرم چلتی ہیں", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5624, "text": "پھر زور پکڑ کر جھکڑ ہو جاتی ہیں", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5625, "text": "اور (بادلوں کو) پھاڑ کر پھیلا دیتی ہیں", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5626, "text": "پھر ان کو پھاڑ کر جدا جدا کر دیتی ہیں", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5627, "text": "پھر فرشتوں کی قسم جو وحی لاتے ہیں", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5628, "text": "تاکہ عذر (رفع) کردیا جائے یا ڈر سنا دیا جائے", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5629, "text": "کہ جس بات کا تم سے وعدہ کیا جاتا ہے وہ ہو کر رہے گی", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5630, "text": "جب تاروں کی چمک جاتی رہے", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5631, "text": "اور جب آسمان پھٹ جائے", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5632, "text": "اور جب پہاڑ اُڑے اُڑے پھریں", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5633, "text": "اور جب پیغمبر فراہم کئے جائیں", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5634, "text": "بھلا (ان امور میں) تاخیر کس دن کے لئے کی گئی؟", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5635, "text": "فیصلے کے دن کے لئے", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5636, "text": "اور تمہیں کیا خبر کہ فیصلے کا دن کیا ہے؟", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5637, "text": "اس دن جھٹلانے والوں کے لئے خرابی ہے", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5638, "text": "کیا ہم نے پہلے لوگوں کو ہلاک نہیں کر ڈالا", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5639, "text": "پھر ان پچھلوں کو بھی ان کے پیچھے بھیج دیتے ہیں", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5640, "text": "ہم گنہگاروں کے ساتھ ایسا ہی کیا کرتے ہیں", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5641, "text": "اس دن جھٹلانے والوں کی خرابی ہے", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5642, "text": "کیا ہم نے تم کو حقیر پانی سے نہیں پیدا کیا؟", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5643, "text": "اس کو ایک محفوظ جگہ میں رکھا", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5644, "text": "ایک وقت معین تک", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5645, "text": "پھر اندازہ مقرر کیا اور ہم کیا ہی خوب اندازہ مقرر کرنے والے ہیں", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5646, "text": "اس دن جھٹلانے والوں کی خرابی ہے", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5647, "text": "کیا ہم نے زمین کو سمیٹنے والی نہیں بنایا", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5648, "text": "یعنی) زندوں اور مردوں کو", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5649, "text": "(بنایا) اور اس پر اونچے اونچے پہاڑ رکھ دیئے اور تم لوگوں کو میٹھا پانی پلایا", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5650, "text": "اس دن جھٹلانے والوں کی خرابی ہے", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5651, "text": "جس چیز کو تم جھٹلایا کرتے تھے۔ (اب) اس کی طرف چلو", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5652, "text": "(یعنی) اس سائے کی طرف چلو جس کی تین شاخیں ہیں", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5653, "text": "نہ ٹھنڈی چھاؤں اور نہ لپٹ سے بچاؤ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5654, "text": "اس سے (آگ کی اتنی اتنی بڑی) چنگاریاں اُڑتی ہیں جیسے محل", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5655, "text": "گویا زرد رنگ کے اونٹ ہیں", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5656, "text": "اس دن جھٹلانے والوں کی خرابی ہے", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5657, "text": "یہ وہ دن ہے کہ (لوگ) لب تک نہ ہلا سکیں گے", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5658, "text": "اور نہ ان کو اجازت دی جائے گی کہ عذر کرسکیں", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5659, "text": "اس دن جھٹلانے والوں کی خرابی ہے", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5660, "text": "یہی فیصلے کا دن ہے (جس میں) ہم نے تم کو اور پہلے لوگوں کو جمع کیا ہے", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5661, "text": "اگر تم کو کوئی داؤں آتا ہو تو مجھ سے کر لو", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5662, "text": "اس دن جھٹلانے والوں کی خرابی ہے", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5663, "text": "بےشک پرہیزگار سایوں اور چشموں میں ہوں گے", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5664, "text": "اور میؤوں میں جو ان کو مرغوب ہوں", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5665, "text": "اور جو عمل تم کرتے رہے تھے ان کے بدلے میں مزے سے کھاؤ اور پیو", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5666, "text": "ہم نیکو کاروں کو ایسا ہی بدلہ دیا کرتے ہیں", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5667, "text": "اس دن جھٹلانے والوں کی خرابی ہوگی", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5668, "text": "(اے جھٹلانے والو!) تم کسی قدر کھا لو اور فائدے اُٹھا لو تم بےشک گنہگار ہو", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5669, "text": "اس دن جھٹلانے والوں کی خرابی ہے", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5670, "text": "اور جب ان سے کہا جاتا ہے کہ (خدا کے آگے) جھکو تو جھکتے نہیں", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5671, "text": "اس دن جھٹلانے والوں کی خرابی ہے", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5672, "text": "اب اس کے بعد یہ کون سی بات پر ایمان لائیں گے؟", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 77, "name": "سُورَةُ المُرۡسَلَاتِ", "englishName": "Al-Mursalaat", "englishNameTranslation": "The Emissaries", "revelationType": "Meccan", "numberOfAyahs": 50, "ayahs": [{"number": 5623, "text": "Wal mursalaati'urfaa", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5624, "text": "Fal'aasifaati 'asfaa", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5625, "text": "Wannaashiraati nashraa", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5626, "text": "Falfaariqaati farqaa", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5627, "text": "Falmulqiyaati zikra", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5628, "text": "'Uzran aw nuzraa", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5629, "text": "Innamaa too'adoona lawaaqi'", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5630, "text": "Fa izam nujoomu tumisat", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5631, "text": "Wa izas samaaa'u furijat", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5632, "text": "Wa izal jibaalu nusifat", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5633, "text": "Wa izar Rusulu uqqitat", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5634, "text": "Li ayyi yawmin ujjilat", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5635, "text": "Li yawmil Fasl", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5636, "text": "Wa maaa adraaka maa yawmul fasl", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5637, "text": "Wailuny yawma 'izillilmukazzibeen", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5638, "text": "Alam nuhlikil awwaleen", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5639, "text": "Summa nutbi'uhumul aakhireen", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5640, "text": "Kazzlika naf'alu bilmujrimeen", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5641, "text": "Wailunw yawma 'izil lil mukazzibeen", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5642, "text": "Alam nakhlukkum mimmaaa'im maheen", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5643, "text": "Faja'alnaahu fee qaraarim makeen", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5644, "text": "Illaa qadrim ma'loom", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5645, "text": "Faqadarnaa fani'mal qaadiroon", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5646, "text": "Wailuny yawma 'izil lilmukazzibeen", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5647, "text": "Alam naj'alil arda kifaataa", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5648, "text": "Ahyaaa'anw wa amwaataa", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5649, "text": "Wa ja'alnaa feehaa rawaasiya shaamikhaatinw wa asqainaakum maaa'an furaataa", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5650, "text": "Wailuny yawma 'izil lilmukazzibeen", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5651, "text": "Intaliqooo ilaa maa kuntum bihee tukazziboon", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5652, "text": "Intaliqooo ilaa zillin zee salaasi shu'ab", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5653, "text": "Laa zaleelinw wa laa yughnee minal lahab", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5654, "text": "Innahaa tarmee bishararin kalqasr", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5655, "text": "Ka annahoo jimaalatun sufr", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5656, "text": "Wailuny yawma 'izil lilmukazibeen", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5657, "text": "Haazaa yawmu laa uantiqoon", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5658, "text": "Wa laa yu'zanu lahum fa ya'taziroon", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5659, "text": "Wailunw yawma 'izil lilmukazzibeen", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5660, "text": "Haaza yawmul fasli jama 'naakum wal awwaleen", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5661, "text": "Fa in kaana lakum kaidun fakeedoon", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5662, "text": "Wailuny yawma'izil lilmukazzibeen", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5663, "text": "Innal muttaqeena fee zilaalinw wa 'uyoon", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5664, "text": "Wa fawaakiha mimmaa yastahoon", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5665, "text": "Kuloo washraboo haneee 'am bimaa kuntum ta'maloon", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5666, "text": "Innaa kazaalika najzil muhsineen", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5667, "text": "Wailuny yawma 'izil lilmuzkazzibeen", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5668, "text": "Kuloo wa tamatta'oo qaleelan innakum mujrimoon", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5669, "text": "Wailunny yawma 'izil lilmukazzibeen", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5670, "text": "Wa izaa qeela lahumur ka'oo aa yarka'oon", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5671, "text": "Wailunny yawma 'izil lilmukazzibeen", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5672, "text": "Fabi ayyi hadeesim ba'dahoo yu'minoon", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]