[{"number": 84, "name": "سُورَةُ الانشِقَاقِ", "englishName": "Al-Inshiqaaq", "englishNameTranslation": "The Splitting Open", "revelationType": "Meccan", "numberOfAyahs": 25, "ayahs": [{"number": 5885, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5886, "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5887, "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5888, "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5889, "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5890, "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5891, "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5892, "text": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5893, "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5894, "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5895, "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5896, "text": "وَيَصْلَىٰ سَعِيرًا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5897, "text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5898, "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5899, "text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5900, "text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5901, "text": "وَٱلَّيْلِ وَمَا وَسَقَ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5902, "text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5903, "text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5904, "text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5905, "text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": {"id": 14, "recommended": true, "obligatory": false}}, {"number": 5906, "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5907, "text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5908, "text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5909, "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 84, "name": "سُورَةُ الانشِقَاقِ", "englishName": "Al-Inshiqaaq", "englishNameTranslation": "The Splitting Open", "revelationType": "Meccan", "numberOfAyahs": 25, "ayahs": [{"number": 5885, "text": "جب آسمان پھٹ جائے گا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5886, "text": "اور اپنے پروردگار کا فرمان بجا لائے گا اور اسے واجب بھی یہ ہی ہے", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5887, "text": "اور جب زمین ہموار کر دی جائے گی", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5888, "text": "جو کچھ اس میں ہے اسے نکال کر باہر ڈال دے گی اور (بالکل) خالی ہو جائے گی", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5889, "text": "اور اپنے پروردگار کے ارشاد کی تعمیل کرے گی اور اس کو لازم بھی یہی ہے (تو قیامت قائم ہو جائے گی)", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5890, "text": "اے انسان! تو اپنے پروردگار کی طرف (پہنچنے میں) خوب کوشِش کرتا ہے سو اس سے جا ملے گا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5891, "text": "تو جس کا نامہٴ (اعمال) اس کے داہنے ہاتھ میں دیا جائے گا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5892, "text": "اس سے حساب آسان لیا جائے گا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5893, "text": "اور وہ اپنے گھر والوں میں خوش خوش آئے گا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5894, "text": "اور جس کا نامہٴ (اعمال) اس کی پیٹھ کے پیچھے سے دیا جائے گا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5895, "text": "وہ موت کو پکارے گا", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5896, "text": "اور وہ دوزخ میں داخل ہو گا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5897, "text": "یہ اپنے اہل (و عیال) میں مست رہتا تھا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5898, "text": "اور خیال کرتا تھا کہ (خدا کی طرف) پھر کر نہ جائے گا", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5899, "text": "ہاں ہاں۔ اس کا پروردگار اس کو دیکھ رہا تھا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5900, "text": "ہمیں شام کی سرخی کی قسم", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5901, "text": "اور رات کی اور جن چیزوں کو وہ اکٹھا کر لیتی ہے ان کی", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5902, "text": "اور چاند کی جب کامل ہو جائے", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5903, "text": "کہ تم درجہ بدرجہ (رتبہٴ اعلیٰ پر) چڑھو گے", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5904, "text": "تو ان لوگوں کو کیا ہوا ہے کہ ایمان نہیں لاتے", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5905, "text": "اور جب ان کے سامنے قرآن پڑھا جاتا ہے تو سجدہ نہیں کرتے", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": {"id": 14, "recommended": true, "obligatory": false}}, {"number": 5906, "text": "بلکہ کافر جھٹلاتے ہیں", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5907, "text": "اور خدا ان باتوں کو جو یہ اپنے دلوں میں چھپاتے ہیں خوب جانتا ہے", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5908, "text": "تو ان کو دکھ دینے والے عذاب کی خبر سنا دو", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5909, "text": "ہاں جو لوگ ایمان لائے اور نیک عمل کرتے رہے ان کے لیے بےانتہا اجر ہے", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 84, "name": "سُورَةُ الانشِقَاقِ", "englishName": "Al-Inshiqaaq", "englishNameTranslation": "The Splitting Open", "revelationType": "Meccan", "numberOfAyahs": 25, "ayahs": [{"number": 5885, "text": "Izas samaaa'un shaqqat", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5886, "text": "Wa azinat li Rabbihaa wa huqqat", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5887, "text": "Wa izal ardu muddat", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5888, "text": "Wa alqat maa feehaa wa takhallat", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5889, "text": "Wa azinat li Rabbihaa wa huqqat", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5890, "text": "Yaaa ayyuhal insaanu innaka kaadihun ilaa Rabbika kad han famulaaqeeh", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5891, "text": "Fa ammaa man ootiya kitaabahoo biyameenih", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5892, "text": "Fasawfa yuhaasabu hi saabai yaseeraa", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5893, "text": "Wa yanqalibu ilaaa ahlihee masrooraa", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5894, "text": "Wa ammaa man ootiya kitaabahoo waraaa'a zahrih", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5895, "text": "Fasawfa yad'oo subooraa", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5896, "text": "Wa yaslaa sa'eeraa", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5897, "text": "Innahoo kaana feee ahlihee masrooraa", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5898, "text": "Innahoo zanna al lai yahoor", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5899, "text": "Balaaa inna Rabbahoo kaana bihee baseeraa", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5900, "text": "Falaaa uqsimu bishshafaq", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5901, "text": "Wallaili wa maa wasaq", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5902, "text": "Walqamari izat tasaq", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5903, "text": "Latarkabunna tabaqan 'an tabaq", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5904, "text": "Famaa lahum laa yu'minoon", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5905, "text": "Wa izaa quri'a 'alaihimul Quraanu laa yasjudoon", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": {"id": 14, "recommended": true, "obligatory": false}}, {"number": 5906, "text": "Balil lazeena kafaroo yukazziboon", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5907, "text": "Wallaahu a'lamu bimaa yoo'oon", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5908, "text": "Fabashshirhum bi'azaabin aleem", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5909, "text": "Illal lazeena aamanoo wa 'amilus saalihaati lahum ajrun ghairu mamnoon", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]