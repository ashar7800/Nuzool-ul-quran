[{"number": 79, "name": "سُورَةُ النَّازِعَاتِ", "englishName": "An-Naazi'aat", "englishNameTranslation": "Those who drag forth", "revelationType": "Meccan", "numberOfAyahs": 46, "ayahs": [{"number": 5713, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5714, "text": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5715, "text": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5716, "text": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5717, "text": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5718, "text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5719, "text": "تَتْبَعُهَا ٱلرَّادِفَةُ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5720, "text": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5721, "text": "أَبْصَٰرُهَا خَٰشِعَةٌۭ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5722, "text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5723, "text": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5724, "text": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5725, "text": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5726, "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5727, "text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5728, "text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5729, "text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5730, "text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5731, "text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5732, "text": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5733, "text": "فَكَذَّبَ وَعَصَىٰ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5734, "text": "ثُمَّ أَدْبَرَ يَسْعَىٰ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5735, "text": "فَحَشَرَ فَنَادَىٰ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5736, "text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5737, "text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5738, "text": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5739, "text": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5740, "text": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5741, "text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5742, "text": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5743, "text": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5744, "text": "وَٱلْجِبَالَ أَرْسَىٰهَا", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5745, "text": "مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5746, "text": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5747, "text": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5748, "text": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5749, "text": "فَأَمَّا مَن طَغَىٰ", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5750, "text": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5751, "text": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5752, "text": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5753, "text": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ", "numberInSurah": 41, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5754, "text": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا", "numberInSurah": 42, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5755, "text": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ", "numberInSurah": 43, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5756, "text": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ", "numberInSurah": 44, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5757, "text": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا", "numberInSurah": 45, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5758, "text": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا", "numberInSurah": 46, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 79, "name": "سُورَةُ النَّازِعَاتِ", "englishName": "An-Naazi'aat", "englishNameTranslation": "Those who drag forth", "revelationType": "Meccan", "numberOfAyahs": 46, "ayahs": [{"number": 5713, "text": "ان (فرشتوں) کی قسم جو ڈوب کر کھینچ لیتے ہیں", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5714, "text": "اور ان کی جو آسانی سے کھول دیتے ہیں", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5715, "text": "اور ان کی جو تیرتے پھرتے ہیں", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5716, "text": "پھر لپک کر آگے بڑھتے ہیں", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5717, "text": "پھر (دنیا کے) کاموں کا انتظام کرتے ہیں", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5718, "text": "(کہ وہ دن آ کر رہے گا) جس دن زمین کو بھونچال آئے گا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5719, "text": "پھر اس کے پیچھے اور (بھونچال) آئے گا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5720, "text": "اس دن (لوگوں) کے دل خائف ہو رہے ہوں گے", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5721, "text": "اور آنکھیں جھکی ہوئی", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5722, "text": "(کافر) کہتے ہیں کیا ہم الٹے پاؤں پھر لوٹ جائیں گے", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5723, "text": "بھلا جب ہم کھوکھلی ہڈیاں ہو جائیں گے (تو پھر زندہ کئے جائیں گے)", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5724, "text": "کہتے ہیں کہ یہ لوٹنا تو (موجب) زیاں ہے", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5725, "text": "وہ تو صرف ایک ڈانٹ ہوگی", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5726, "text": "اس وقت وہ (سب) میدان (حشر) میں آ جمع ہوں گے", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5727, "text": "بھلا تم کو موسیٰ کی حکایت پہنچی ہے", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5728, "text": "جب اُن کے پروردگار نے ان کو پاک میدان (یعنی) طویٰ میں پکارا", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5729, "text": "(اور حکم دیا) کہ فرعون کے پاس جاؤ وہ سرکش ہو رہا ہے", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5730, "text": "اور (اس سے) کہو کہ کیا تو چاہتا ہے کہ پاک ہو جائے؟", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5731, "text": "اور میں تجھے تیرے پروردگار کا رستہ بتاؤں تاکہ تجھ کو خوف (پیدا) ہو", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5732, "text": "غرض انہوں نے اس کو بڑی نشانی دکھائی", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5733, "text": "مگر اس نے جھٹلایا اور نہ مانا", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5734, "text": "پھر لوٹ گیا اور تدبیریں کرنے لگا", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5735, "text": "اور (لوگوں کو) اکٹھا کیا اور پکارا", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5736, "text": "کہنے لگا کہ تمہارا سب سے بڑا مالک میں ہوں", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5737, "text": "تو خدا نے اس کو دنیا اور آخرت (دونوں) کے عذاب میں پکڑ لیا", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5738, "text": "جو شخص (خدا سے) ڈر رکھتا ہے اس کے لیے اس (قصے) میں عبرت ہے", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5739, "text": "بھلا تمہارا بنانا آسان ہے یا آسمان کا؟ اسی نے اس کو بنایا", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5740, "text": "اس کی چھت کو اونچا کیا اور پھر اسے برابر کر دیا", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5741, "text": "اور اسی نے رات کو تاریک بنایا اور (دن کو) دھوپ نکالی", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5742, "text": "اور اس کے بعد زمین کو پھیلا دیا", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5743, "text": "اسی نے اس میں سے اس کا پانی نکالا اور چارا اگایا", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5744, "text": "اور اس پر پہاڑوں کابوجھ رکھ دیا", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5745, "text": "یہ سب کچھ تمہارے اور تمہارے چارپایوں کے فائدے کے لیے (کیا)", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5746, "text": "تو جب بڑی آفت آئے گی", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5747, "text": "اس دن انسان اپنے کاموں کو یاد کرے گا", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5748, "text": "اور دوزخ دیکھنے والے کے سامنے نکال کر رکھ دی جائے گی", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5749, "text": "تو جس نے سرکشی کی", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5750, "text": "اور دنیا کی زندگی کو مقدم سمجھا", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5751, "text": "اس کا ٹھکانہ دوزخ ہے", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5752, "text": "اور جو اپنے پروردگار کے سامنے کھڑے ہونے سے ڈرتا اور جی کو خواہشوں سے روکتا رہا", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5753, "text": "اس کا ٹھکانہ بہشت ہے", "numberInSurah": 41, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5754, "text": "(اے پیغمبر، لوگ) تم سے قیامت کے بارے میں پوچھتے ہیں کہ اس کا وقوع کب ہو گا؟", "numberInSurah": 42, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5755, "text": "سو تم اس کے ذکر سے کس فکر میں ہو", "numberInSurah": 43, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5756, "text": "اس کا منتہا (یعنی واقع ہونے کا وقت) تمہارے پروردگار ہی کو (معلوم ہے)", "numberInSurah": 44, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5757, "text": "جو شخص اس سے ڈر رکھتا ہے تم تو اسی کو ڈر سنانے والے ہو", "numberInSurah": 45, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5758, "text": "جب وہ اس کو دیکھیں گے (تو ایسا خیال کریں گے) کہ گویا (دنیا میں صرف) ایک شام یا صبح رہے تھے", "numberInSurah": 46, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 79, "name": "سُورَةُ النَّازِعَاتِ", "englishName": "An-Naazi'aat", "englishNameTranslation": "Those who drag forth", "revelationType": "Meccan", "numberOfAyahs": 46, "ayahs": [{"number": 5713, "text": "Wan naazi 'aati gharqa", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5714, "text": "Wan naa shi taati nashta", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5715, "text": "Wass saabi-haati sabha", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5716, "text": "Fass saabi qaati sabqa", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5717, "text": "Fal mu dab-bi raati amra", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5718, "text": "Yawma tarjufur raajifa", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5719, "text": "Tatba'u har raadifa", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5720, "text": "Quloobuny-yau maaiziw-waaji-fa", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5721, "text": "Absaa ruhaa khashi'ah", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5722, "text": "Ya qoo loona a-inna lamar doo doona fil haafirah", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5723, "text": "Aizaa kunna 'izaa man-nakhirah", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5724, "text": "Qaalu tilka izan karratun khaasirah.", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5725, "text": "Fa inna ma hiya zajratuw-waahida", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5726, "text": "Faizaa hum biss saahirah", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5727, "text": "Hal ataaka hadeethu Musaa", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5728, "text": "Iz nadaahu rabbuhu bil waadil-muqad dasi tuwa", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5729, "text": "Izhab ilaa fir'auna innahu taghaa.", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5730, "text": "Faqul hal laka ilaa-an tazakka.", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5731, "text": "Wa ahdi yaka ila rabbika fatakh sha", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5732, "text": "Fa araahul-aayatal kubra.", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5733, "text": "Fa kazzaba wa asaa.", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5734, "text": "Thumma adbara yas'aa.", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5735, "text": "Fa hashara fanada.", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5736, "text": "Faqala ana rabbu kumul-a'laa.", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5737, "text": "Fa-akha zahul laahu nakalal aakhirati wal-oola.", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5738, "text": "Inna fee zaalika la'ibratal limaiy-yaksha", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5739, "text": "A-antum a shaddu khalqan amis samaa-u banaaha.", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5740, "text": "Raf'a sam kaha fasaw waaha", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5741, "text": "Wa aghtasha lailaha wa akhraja duhaaha.", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5742, "text": "Wal arda b'ada zaalika dahaaha.", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5743, "text": "Akhraja minha maa-aha wa mar 'aaha.", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5744, "text": "Wal jibala arsaaha.", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5745, "text": "Mataa'al lakum wali an 'aamikum.", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5746, "text": "Fa-izaa jaaa'atit taaam matul kubraa.", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5747, "text": "Yauma Yata zakkarul insaanu ma sa'aa.", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5748, "text": "Wa burrizatil-jaheemu limany-yaraa.", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5749, "text": "Fa ammaa man taghaa.", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5750, "text": "Wa aasaral hayaatad dunyaa", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5751, "text": "Fa innal jaheema hiyal maawaa.", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5752, "text": "Wa ammaa man khaafa maqaama Rabbihee wa nahan nafsa 'anil hawaa", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5753, "text": "Fa innal jannata hiyal maawaa", "numberInSurah": 41, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5754, "text": "Yas'aloonaka 'anis saa'ati ayyaana mursaahaa", "numberInSurah": 42, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5755, "text": "Feema anta min zikraahaa", "numberInSurah": 43, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5756, "text": "Ilaa Rabbika muntahaa haa", "numberInSurah": 44, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5757, "text": "Innamaaa anta munziru maiy yakshaahaa", "numberInSurah": 45, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5758, "text": "Ka annahum Yawma yarawnahaa lam yalbasooo illaa 'ashiyyatan aw duhaahaa", "numberInSurah": 46, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]