[{"number": 55, "name": "سُورَةُ الرَّحۡمَٰن", "englishName": "Ar-Rahmaan", "englishNameTranslation": "The Beneficent", "revelationType": "Medinan", "numberOfAyahs": 78, "ayahs": [{"number": 4902, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4903, "text": "عَلَّمَ ٱلْقُرْءَانَ", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4904, "text": "خَلَقَ ٱلْإِنسَٰنَ", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4905, "text": "عَلَّمَهُ ٱلْبَيَانَ", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4906, "text": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4907, "text": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4908, "text": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4909, "text": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4910, "text": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4911, "text": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4912, "text": "فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4913, "text": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4914, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4915, "text": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4916, "text": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4917, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4918, "text": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4919, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4920, "text": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4921, "text": "بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4922, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4923, "text": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4924, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4925, "text": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4926, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4927, "text": "كُلُّ مَنْ عَلَيْهَا فَانٍۢ", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4928, "text": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4929, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4930, "text": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4931, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4932, "text": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4933, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4934, "text": "يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍۢ", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4935, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4936, "text": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌۭ مِّن نَّارٍۢ وَنُحَاسٌۭ فَلَا تَنتَصِرَانِ", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4937, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4938, "text": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةًۭ كَٱلدِّهَانِ", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4939, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4940, "text": "فَيَوْمَئِذٍۢ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌۭ وَلَا جَآنٌّۭ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4941, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4942, "text": "يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4943, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4944, "text": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4945, "text": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍۢ", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4946, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4947, "text": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4948, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4949, "text": "ذَوَاتَآ أَفْنَانٍۢ", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4950, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4951, "text": "فِيهِمَا عَيْنَانِ تَجْرِيَانِ", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4952, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4953, "text": "فِيهِمَا مِن كُلِّ فَٰكِهَةٍۢ زَوْجَانِ", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4954, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4955, "text": "مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍۢ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍۢ", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4956, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4957, "text": "فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ", "numberInSurah": 56, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4958, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 57, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4959, "text": "كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ", "numberInSurah": 58, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4960, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 59, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4961, "text": "هَلْ جَزَآءُ ٱلْإِحْسَٰنِ إِلَّا ٱلْإِحْسَٰنُ", "numberInSurah": 60, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4962, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 61, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4963, "text": "وَمِن دُونِهِمَا جَنَّتَانِ", "numberInSurah": 62, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4964, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 63, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4965, "text": "مُدْهَآمَّتَانِ", "numberInSurah": 64, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4966, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 65, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4967, "text": "فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ", "numberInSurah": 66, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4968, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 67, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4969, "text": "فِيهِمَا فَٰكِهَةٌۭ وَنَخْلٌۭ وَرُمَّانٌۭ", "numberInSurah": 68, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4970, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 69, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4971, "text": "فِيهِنَّ خَيْرَٰتٌ حِسَانٌۭ", "numberInSurah": 70, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4972, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 71, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4973, "text": "حُورٌۭ مَّقْصُورَٰتٌۭ فِى ٱلْخِيَامِ", "numberInSurah": 72, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4974, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 73, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4975, "text": "لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ", "numberInSurah": 74, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4976, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 75, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4977, "text": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍۢ وَعَبْقَرِىٍّ حِسَانٍۢ", "numberInSurah": 76, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4978, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ", "numberInSurah": 77, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4979, "text": "تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ", "numberInSurah": 78, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 55, "name": "سُورَةُ الرَّحۡمَٰن", "englishName": "Ar-Rahmaan", "englishNameTranslation": "The Beneficent", "revelationType": "Medinan", "numberOfAyahs": 78, "ayahs": [{"number": 4902, "text": "(خدا جو) نہایت مہربان", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4903, "text": "اسی نے قرآن کی تعلیم فرمائی", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4904, "text": "اسی نے انسان کو پیدا کیا", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4905, "text": "اسی نے اس کو بولنا سکھایا", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4906, "text": "سورج اور چاند ایک حساب مقرر سے چل رہے ہیں", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4907, "text": "اور بوٹیاں اور درخت سجدہ کر رہے ہیں", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4908, "text": "اور اسی نے آسمان کو بلند کیا اور ترازو قائم کی", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4909, "text": "کہ ترازو (سے تولنے) میں حد سے تجاوز نہ کرو", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4910, "text": "اور انصاف کے ساتھ ٹھیک تولو۔ اور تول کم مت کرو", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4911, "text": "اور اسی نے خلقت کے لئے زمین بچھائی", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4912, "text": "اس میں میوے اور کھجور کے درخت ہیں جن کے خوشوں پر غلاف ہوتے ہیں", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4913, "text": "اور اناج جس کے ساتھ بھس ہوتا ہے اور خوشبودار پھول", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4914, "text": "تو (اے گروہ جن وانس) تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4915, "text": "اسی نے انسان کو ٹھیکرے کی طرح کھنکھناتی مٹی سے بنایا", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4916, "text": "اور جنات کو آگ کے شعلے سے پیدا کیا", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4917, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4918, "text": "وہی دونوں مشرقوں اور دونوں مغربوں کا مالک (ہے)", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4919, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4920, "text": "اسی نے دو دریا رواں کئے جو آپس میں ملتے ہیں", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4921, "text": "دونوں میں ایک آڑ ہے کہ (اس سے) تجاوز نہیں کرسکتے", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4922, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4923, "text": "دونوں دریاؤں سے موتی اور مونگے نکلتے ہیں", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4924, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4925, "text": "اور جہاز بھی اسی کے ہیں جو دریا میں پہاڑوں کی طرح اونچے کھڑے ہوتے ہیں", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4926, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4927, "text": "جو (مخلوق) زمین پر ہے سب کو فنا ہونا ہے", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4928, "text": "اور تمہارے پروردگار ہی کی ذات (بابرکات) جو صاحب جلال وعظمت ہے باقی رہے گی", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4929, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4930, "text": "آسمان اور زمین میں جتنے لوگ ہیں سب اسی سے مانگتے ہیں۔ وہ ہر روز کام میں مصروف رہتا ہے", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4931, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4932, "text": "اے دونوں جماعتو! ہم عنقریب تمہاری طرف متوجہ ہوتے ہیں", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4933, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4934, "text": "اے گروہِ جن وانس اگر تمہیں قدرت ہو کہ آسمان اور زمین کے کناروں سے نکل جاؤ تو نکل جاؤ۔ اور زور کے سوا تم نکل سکنے ہی کے نہیں", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4935, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4936, "text": "تم پر آگ کے شعلے اور دھواں چھوڑ دیا جائے گا تو پھر تم مقابلہ نہ کرسکو گے", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4937, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4938, "text": "پھر جب آسمان پھٹ کر تیل کی تلچھٹ کی طرح گلابی ہوجائے گا (تو) وہ کیسا ہولناک دن ہوگا", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4939, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4940, "text": "اس روز نہ تو کسی انسان سے اس کے گناہوں کے بارے میں پرسش کی جائے گی اور نہ کسی جن سے", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4941, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4942, "text": "گنہگار اپنے چہرے ہی سے پہچان لئے جائیں گے تو پیشانی کے بالوں اور پاؤں سے پکڑ لئے جائیں گے", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4943, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4944, "text": "یہی وہ جہنم ہے جسے گنہگار لوگ جھٹلاتے تھے", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4945, "text": "وہ دوزخ اور کھولتے ہوئے گرم پانی کے درمیان گھومتے پھریں گے", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4946, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4947, "text": "اور جو شخص اپنے پروردگار کے سامنے کھڑے ہونے سے ڈرا اس کے لئے دو باغ ہیں", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4948, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4949, "text": "ان دونوں میں بہت سی شاخیں (یعنی قسم قسم کے میووں کے درخت ہیں)", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4950, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4951, "text": "ان میں دو چشمے بہہ رہے ہیں", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4952, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4953, "text": "ان میں سب میوے دو دو قسم کے ہیں", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4954, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4955, "text": "(اہل جنت) ایسے بچھونوں پر جن کے استرا طلس کے ہیں تکیہ لگائے ہوئے ہوں گے۔ اور دونوں باغوں کے میوے قریب (جھک رہے) ہیں", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4956, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4957, "text": "ان میں نیچی نگاہ والی عورتیں ہیں جن کو اہل جنت سے پہلے نہ کسی انسان نے ہاتھ لگایا اور نہ کسی جن نے", "numberInSurah": 56, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4958, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 57, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4959, "text": "گویا وہ یاقوت اور مرجان ہیں", "numberInSurah": 58, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4960, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 59, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4961, "text": "نیکی کا بدلہ نیکی کے سوا کچھ نہیں ہے", "numberInSurah": 60, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4962, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 61, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4963, "text": "اور ان باغوں کے علاوہ دو باغ اور ہیں", "numberInSurah": 62, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4964, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 63, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4965, "text": "دونوں خوب گہرے سبز", "numberInSurah": 64, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4966, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 65, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4967, "text": "ان میں دو چشمے ابل رہے ہیں", "numberInSurah": 66, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4968, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 67, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4969, "text": "ان میں میوے اور کھجوریں اور انار ہیں", "numberInSurah": 68, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4970, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 69, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4971, "text": "ان میں نیک سیرت (اور) خوبصورت عورتیں ہیں", "numberInSurah": 70, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4972, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 71, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4973, "text": "(وہ) حوریں (ہیں جو) خیموں میں مستور (ہیں)", "numberInSurah": 72, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4974, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 73, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4975, "text": "ان کو اہل جنت سے پہلے نہ کسی انسان نے ہاتھ لگایا اور نہ کسی جن نے", "numberInSurah": 74, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4976, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 75, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4977, "text": "سبز قالینوں اور نفیس مسندوں پر تکیہ لگائے بیٹھے ہوں گے", "numberInSurah": 76, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4978, "text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟", "numberInSurah": 77, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4979, "text": "(اے محمدﷺ) تمہارا پروردگار جو صاحب جلال وعظمت ہے اس کا نام بڑا بابرکت ہے", "numberInSurah": 78, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 55, "name": "سُورَةُ الرَّحۡمَٰن", "englishName": "Ar-Rahmaan", "englishNameTranslation": "The Beneficent", "revelationType": "Medinan", "numberOfAyahs": 78, "ayahs": [{"number": 4902, "text": "Ar Rahmaan", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4903, "text": "'Allamal Quran", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4904, "text": "Khalaqal insaan", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4905, "text": "'Allamalhul bayaan", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4906, "text": "Ashshamsu walqamaru bihusbaan", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4907, "text": "Wannajmu washshajaru yasjudan", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4908, "text": "Wassamaaa'a rafa'ahaa wa wada'al Meezan", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4909, "text": "Allaa tatghaw fil meezaan", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4910, "text": "Wa aqeemul wazna bilqisti wa laa tukhsirul meezaan", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4911, "text": "Wal arda wada'ahaa lilanaame", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4912, "text": "Feehaa faakihatunw wan nakhlu zaatul akmaam", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4913, "text": "Walhabbu zul 'asfi war Raihaanu", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4914, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4915, "text": "Khalaqal insaana min salsaalin kalfakhkhaari", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4916, "text": "Wa khalaqal jaaan mim maarijim min naar", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4917, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 531, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4918, "text": "Rabbul mashriqayni wa Rabbul maghribayni", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4919, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4920, "text": "Marajal bahrayni yalta qiyaani", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4921, "text": "Bainahumaa barzakhul laa yabghiyaan", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4922, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4923, "text": "Yakhruju minhumal lu 'lu u wal marjaanu", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4924, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4925, "text": "Wa lahul jawaaril mun sha'aatu fil bahri kal a'laam", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4926, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 532, "ruku": 466, "hizbQuarter": 213, "sajda": false}, {"number": 4927, "text": "Kullu man 'alaihaa faan", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4928, "text": "Wa yabqaa wajhu rabbika zul jalaali wal ikraam", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4929, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4930, "text": "Yas'aluhoo man fissamaawaati walard; kulla ywmin huwa fee shaan", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4931, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4932, "text": "Sanafrughu lakum ayyuhas saqalaan", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4933, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4934, "text": "Yaa ma'sharal jinni wal insi inis tata'tum an tanfuzoo min aqtaaris samaawaati wal ardi fanfuzoo; laa tanfuzoona illaa bisultaan", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4935, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4936, "text": "Yursalu 'alaikumaa shuwaazum min naarifiw-wa nuhaasun falaa tantasiraan", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4937, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4938, "text": "Fa-izan shaqqatis samaaa'u fakaanat wardatan kaddihaan", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4939, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4940, "text": "Fa-yawma'izil laa yus'alu 'an zambiheee insunw wa laa jaann", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4941, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 532, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4942, "text": "Yu'raful mujrimoona biseemaahum fa'yu'khazu binna waasi wal aqdaam", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4943, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4944, "text": "Haazihee jahannamul latee yukazzibu bihal mujrimoon", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4945, "text": "Yatoofoona bainahaa wa baina hameemim aan", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4946, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 533, "ruku": 467, "hizbQuarter": 213, "sajda": false}, {"number": 4947, "text": "Wa liman khaafa maqaama rabbihee jannataan", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4948, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4949, "text": "Zawaataaa afnaan", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4950, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4951, "text": "Feehimaa 'aynaani tajriyaan", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4952, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4953, "text": "Feehimaa min kulli faakihatin zawjaan", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4954, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4955, "text": "Muttaki'eena 'alaa furushim bataaa'inuhaa min istabraq; wajanal jannataini daan", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4956, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4957, "text": "Feehinna qaasiratut tarfi lam yatmishunna insun qablahum wa laa jaaann", "numberInSurah": 56, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4958, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 57, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4959, "text": "ka annahunnal yaaqootu wal marjaan", "numberInSurah": 58, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4960, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 59, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4961, "text": "Hal jazaaa'ul ihsaani illal ihsaan", "numberInSurah": 60, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4962, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 61, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4963, "text": "Wa min doonihimaa jannataan", "numberInSurah": 62, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4964, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 63, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4965, "text": "Mudhaaammataan", "numberInSurah": 64, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4966, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 65, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4967, "text": "Feehimaa 'aynaani nad daakhataan", "numberInSurah": 66, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4968, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 67, "juz": 27, "manzil": 7, "page": 533, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4969, "text": "Feehimaa faakihatunw wa nakhlunw wa rummaan", "numberInSurah": 68, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4970, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 69, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4971, "text": "Feehinna khairaatun hisaan", "numberInSurah": 70, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4972, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 71, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4973, "text": "Hoorum maqsooraatun fil khiyaam", "numberInSurah": 72, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4974, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 73, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4975, "text": "Lam yatmis hunna insun qablahum wa laa jaaann", "numberInSurah": 74, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4976, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 75, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4977, "text": "Muttaki'eena 'alaa rafratin khudrinw wa 'abqariyyin hisaan", "numberInSurah": 76, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4978, "text": "Fabi ayyi aalaaa'i Rabbikumaa tukazzibaan.", "numberInSurah": 77, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}, {"number": 4979, "text": "Tabaarakasmu Rabbika Zil-Jalaali wal-Ikraam", "numberInSurah": 78, "juz": 27, "manzil": 7, "page": 534, "ruku": 468, "hizbQuarter": 213, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]