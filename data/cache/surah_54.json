[{"number": 54, "name": "سُورَةُ القَمَرِ", "englishName": "Al-Qamar", "englishNameTranslation": "The Moon", "revelationType": "Meccan", "numberOfAyahs": 55, "ayahs": [{"number": 4847, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4848, "text": "وَإِن يَرَوْا۟ ءَايَةًۭ يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌۭ مُّسْتَمِرٌّۭ", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4849, "text": "وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍۢ مُّسْتَقِرٌّۭ", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4850, "text": "وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4851, "text": "حِكْمَةٌۢ بَٰلِغَةٌۭ ۖ فَمَا تُغْنِ ٱلنُّذُرُ", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4852, "text": "فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍۢ نُّكُرٍ", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4853, "text": "خُشَّعًا أَبْصَٰرُهُمْ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ كَأَنَّهُمْ جَرَادٌۭ مُّنتَشِرٌۭ", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4854, "text": "مُّهْطِعِينَ إِلَى ٱلدَّاعِ ۖ يَقُولُ ٱلْكَٰفِرُونَ هَٰذَا يَوْمٌ عَسِرٌۭ", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4855, "text": "۞ كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍۢ فَكَذَّبُوا۟ عَبْدَنَا وَقَالُوا۟ مَجْنُونٌۭ وَٱزْدُجِرَ", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4856, "text": "فَدَعَا رَبَّهُۥٓ أَنِّى مَغْلُوبٌۭ فَٱنتَصِرْ", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4857, "text": "فَفَتَحْنَآ أَبْوَٰبَ ٱلسَّمَآءِ بِمَآءٍۢ مُّنْهَمِرٍۢ", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4858, "text": "وَفَجَّرْنَا ٱلْأَرْضَ عُيُونًۭا فَٱلْتَقَى ٱلْمَآءُ عَلَىٰٓ أَمْرٍۢ قَدْ قُدِرَ", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4859, "text": "وَحَمَلْنَٰهُ عَلَىٰ ذَاتِ أَلْوَٰحٍۢ وَدُسُرٍۢ", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4860, "text": "تَجْرِى بِأَعْيُنِنَا جَزَآءًۭ لِّمَن كَانَ كُفِرَ", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4861, "text": "وَلَقَد تَّرَكْنَٰهَآ ءَايَةًۭ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4862, "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4863, "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4864, "text": "كَذَّبَتْ عَادٌۭ فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4865, "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ رِيحًۭا صَرْصَرًۭا فِى يَوْمِ نَحْسٍۢ مُّسْتَمِرٍّۢ", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4866, "text": "تَنزِعُ ٱلنَّاسَ كَأَنَّهُمْ أَعْجَازُ نَخْلٍۢ مُّنقَعِرٍۢ", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4867, "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4868, "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4869, "text": "كَذَّبَتْ ثَمُودُ بِٱلنُّذُرِ", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4870, "text": "فَقَالُوٓا۟ أَبَشَرًۭا مِّنَّا وَٰحِدًۭا نَّتَّبِعُهُۥٓ إِنَّآ إِذًۭا لَّفِى ضَلَٰلٍۢ وَسُعُرٍ", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4871, "text": "أَءُلْقِىَ ٱلذِّكْرُ عَلَيْهِ مِنۢ بَيْنِنَا بَلْ هُوَ كَذَّابٌ أَشِرٌۭ", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4872, "text": "سَيَعْلَمُونَ غَدًۭا مَّنِ ٱلْكَذَّابُ ٱلْأَشِرُ", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4873, "text": "إِنَّا مُرْسِلُوا۟ ٱلنَّاقَةِ فِتْنَةًۭ لَّهُمْ فَٱرْتَقِبْهُمْ وَٱصْطَبِرْ", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4874, "text": "وَنَبِّئْهُمْ أَنَّ ٱلْمَآءَ قِسْمَةٌۢ بَيْنَهُمْ ۖ كُلُّ شِرْبٍۢ مُّحْتَضَرٌۭ", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4875, "text": "فَنَادَوْا۟ صَاحِبَهُمْ فَتَعَاطَىٰ فَعَقَرَ", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4876, "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4877, "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ صَيْحَةًۭ وَٰحِدَةًۭ فَكَانُوا۟ كَهَشِيمِ ٱلْمُحْتَظِرِ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4878, "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4879, "text": "كَذَّبَتْ قَوْمُ لُوطٍۭ بِٱلنُّذُرِ", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4880, "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ حَاصِبًا إِلَّآ ءَالَ لُوطٍۢ ۖ نَّجَّيْنَٰهُم بِسَحَرٍۢ", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4881, "text": "نِّعْمَةًۭ مِّنْ عِندِنَا ۚ كَذَٰلِكَ نَجْزِى مَن شَكَرَ", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4882, "text": "وَلَقَدْ أَنذَرَهُم بَطْشَتَنَا فَتَمَارَوْا۟ بِٱلنُّذُرِ", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4883, "text": "وَلَقَدْ رَٰوَدُوهُ عَن ضَيْفِهِۦ فَطَمَسْنَآ أَعْيُنَهُمْ فَذُوقُوا۟ عَذَابِى وَنُذُرِ", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4884, "text": "وَلَقَدْ صَبَّحَهُم بُكْرَةً عَذَابٌۭ مُّسْتَقِرٌّۭ", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4885, "text": "فَذُوقُوا۟ عَذَابِى وَنُذُرِ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4886, "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4887, "text": "وَلَقَدْ جَآءَ ءَالَ فِرْعَوْنَ ٱلنُّذُرُ", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4888, "text": "كَذَّبُوا۟ بِـَٔايَٰتِنَا كُلِّهَا فَأَخَذْنَٰهُمْ أَخْذَ عَزِيزٍۢ مُّقْتَدِرٍ", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4889, "text": "أَكُفَّارُكُمْ خَيْرٌۭ مِّنْ أُو۟لَٰٓئِكُمْ أَمْ لَكُم بَرَآءَةٌۭ فِى ٱلزُّبُرِ", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4890, "text": "أَمْ يَقُولُونَ نَحْنُ جَمِيعٌۭ مُّنتَصِرٌۭ", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4891, "text": "سَيُهْزَمُ ٱلْجَمْعُ وَيُوَلُّونَ ٱلدُّبُرَ", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4892, "text": "بَلِ ٱلسَّاعَةُ مَوْعِدُهُمْ وَٱلسَّاعَةُ أَدْهَىٰ وَأَمَرُّ", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4893, "text": "إِنَّ ٱلْمُجْرِمِينَ فِى ضَلَٰلٍۢ وَسُعُرٍۢ", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4894, "text": "يَوْمَ يُسْحَبُونَ فِى ٱلنَّارِ عَلَىٰ وُجُوهِهِمْ ذُوقُوا۟ مَسَّ سَقَرَ", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4895, "text": "إِنَّا كُلَّ شَىْءٍ خَلَقْنَٰهُ بِقَدَرٍۢ", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4896, "text": "وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌۭ كَلَمْحٍۭ بِٱلْبَصَرِ", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4897, "text": "وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4898, "text": "وَكُلُّ شَىْءٍۢ فَعَلُوهُ فِى ٱلزُّبُرِ", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4899, "text": "وَكُلُّ صَغِيرٍۢ وَكَبِيرٍۢ مُّسْتَطَرٌ", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4900, "text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَنَهَرٍۢ", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4901, "text": "فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍۢ مُّقْتَدِرٍۭ", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 54, "name": "سُورَةُ القَمَرِ", "englishName": "Al-Qamar", "englishNameTranslation": "The Moon", "revelationType": "Meccan", "numberOfAyahs": 55, "ayahs": [{"number": 4847, "text": "قیامت قریب آ پہنچی اور چاند شق ہوگیا", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4848, "text": "اور اگر (کافر) کوئی نشانی دیکھتے ہیں تو منہ پھیر لیتے ہیں اور کہتے ہیں کہ یہ ایک ہمیشہ کا جادو ہے", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4849, "text": "اور انہوں نے جھٹلایا اور اپنی خواہشوں کی پیروی کی اور ہر کام کا وقت مقرر ہے", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4850, "text": "اور ان کو ایسے حالات (سابقین) پہنچ چکے ہیں جن میں عبرت ہے", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4851, "text": "اور کامل دانائی (کی کتاب بھی) لیکن ڈرانا ان کو کچھ فائدہ نہیں دیتا", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4852, "text": "تو تم بھی ان کی کچھ پروا نہ کرو۔ جس دن بلانے والا ان کو ایک ناخوش چیز کی طرف بلائے گا", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4853, "text": "تو آنکھیں نیچی کئے ہوئے قبروں سے نکل پڑیں گے گویا بکھری ہوئی ٹڈیاں", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4854, "text": "اس بلانے والے کی طرف دوڑتے جاتے ہوں گے۔ کافر کہیں گے یہ دن بڑا سخت ہے", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4855, "text": "ان سے پہلے نوحؑ کی قوم نے بھی تکذیب کی تھی تو انہوں نے ہمارے بندے کو جھٹلایا اور کہا کہ دیوانہ ہے اور انہیں ڈانٹا بھی", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4856, "text": "تو انہوں نے اپنے پروردگار سے دعا کی کہ (بار الٓہا) میں (ان کے مقابلے میں) کمزور ہوں تو (ان سے) بدلہ لے", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4857, "text": "پس ہم نے زور کے مینہ سے آسمان کے دہانے کھول دیئے", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4858, "text": "اور زمین میں چشمے جاری کردیئے تو پانی ایک کام کے لئے جو مقدر ہوچکا تھا جمع ہوگیا", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4859, "text": "اور ہم نے نوحؑ کو ایک کشتی پر جو تختوں اور میخوں سے تیار کی گئی تھی سوار کرلیا", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4860, "text": "وہ ہماری آنکھوں کے سامنے چلتی تھی۔ (یہ سب کچھ) اس شخص کے انتقام کے لئے (کیا گیا) جس کو کافر مانتے نہ تھے", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4861, "text": "اور ہم نے اس کو ایک عبرت بنا چھوڑا تو کوئی ہے کہ سوچے سمجھے؟", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4862, "text": "سو (دیکھ لو کہ) میرا عذاب اور ڈرانا کیسا ہوا؟", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4863, "text": "اور ہم نے قرآن کو سمجھنے کے لئے آسان کردیا ہے تو کوئی ہے کہ سوچے سمجھے؟", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4864, "text": "عاد نے بھی تکذیب کی تھی سو (دیکھ لو کہ) میرا عذاب اور ڈرانا کیسا ہوا", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4865, "text": "ہم نے ان پر سخت منحوس دن میں آندھی چلائی", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4866, "text": "وہ لوگوں کو (اس طرح) اکھیڑے ڈالتی تھی گویا اکھڑی ہوئی کھجوروں کے تنے ہیں", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4867, "text": "سو (دیکھ لو کہ) میرا عذاب اور ڈرانا کیسا ہوا", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4868, "text": "اور ہم نے قرآن کو سمجھنے کے لئے آسان کردیا ہے تو کوئی ہے کہ سوچے سمجھے؟", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4869, "text": "ثمود نے بھی ہدایت کرنے والوں کو جھٹلایا", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4870, "text": "اور کہا کہ بھلا ایک آدمی جو ہم ہی میں سے ہے ہم اس کی پیروی کریں؟ یوں ہو تو ہم گمراہی اور دیوانگی میں پڑ گئے", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4871, "text": "کیا ہم سب میں سے اسی پر وحی نازل ہوئی ہے؟ (نہیں) بلکہ یہ جھوٹا خود پسند ہے", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4872, "text": "ان کو کل ہی معلوم ہوجائے گا کہ کون جھوٹا خود پسند ہے", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4873, "text": "(اے صالح) ہم ان کی آزمائش کے لئے اونٹنی بھیجنے والے ہیں تو تم ان کو دیکھتے رہو اور صبر کرو", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4874, "text": "اور ان کو آگاہ کردو کہ ان میں پانی کی باری مقرر کر دی گئی ہے۔ ہر (باری والے کو اپنی) باری پر آنا چاہیئے", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4875, "text": "تو ان لوگوں نے اپنے رفیق کو بلایا اور اس نے (اونٹنی کو پکڑ کر اس کی) کونچیں کاٹ ڈالیں", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4876, "text": "سو (دیکھ لو کہ) میرا عذاب اور ڈرانا کیسا ہوا", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4877, "text": "ہم نے ان پر (عذاب کے لئے) ایک چیخ بھیجی تو وہ ایسے ہوگئے جیسے باڑ والے کی سوکھی اور ٹوٹی ہوئی باڑ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4878, "text": "اور ہم نے قرآن کو سمجھنے کے لئے آسان کردیا ہے تو کوئی ہے کہ سوچے سمجھے؟", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4879, "text": "لوط کی قوم نے بھی ڈر سنانے والوں کو جھٹلایا تھا", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4880, "text": "تو ہم نے ان پر کنکر بھری ہوا چلائی مگر لوط کے گھر والے کہ ہم نے ان کو پچھلی رات ہی سے بچا لیا", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4881, "text": "اپنے فضل سے۔ شکر کرنے والوں کو ہم ایسا ہی بدلہ دیا کرتے ہیں", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4882, "text": "اور لوطؑ نے ان کو ہماری پکڑ سے ڈرایا بھی تھا مگر انہوں نے ڈرانے میں شک کیا", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4883, "text": "اور ان سے ان کے مہمانوں کو لے لینا چاہا تو ہم نے ان کی آنکھیں مٹا دیں سو (اب) میرے عذاب اور ڈرانے کے مزے چکھو", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4884, "text": "اور ان پر صبح سویرے ہی اٹل عذاب آ نازل ہوا", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4885, "text": "تو اب میرے عذاب اور ڈرانے کے مزے چکھو", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4886, "text": "اور ہم نے قرآن کو سمجھنے کے لئے آسان کردیا ہے تو کوئی ہے کہ سوچے سمجھے؟", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4887, "text": "اور قوم فرعون کے پاس بھی ڈر سنانے والے آئے", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4888, "text": "انہوں نے ہماری تمام نشانیوں کو جھٹلایا تو ہم نے ان کو اس طرح پکڑ لیا جس طرح ایک قوی اور غالب شخص پکڑ لیتا ہے", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4889, "text": "(اے اہل عرب) کیا تمہارے کافر ان لوگوں سے بہتر ہیں یا تمہارے لئے (پہلی) کتابوں میں کوئی فارغ خطی لکھ دی گئی ہے", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4890, "text": "کیا یہ لوگ کہتے ہیں کہ ہماری جماعت بڑی مضبوط ہے", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4891, "text": "عنقریب یہ جماعت شکست کھائے گی اور یہ لوگ پیٹھ پھیر کر بھاگ جائیں گے", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4892, "text": "ان کے وعدے کا وقت تو قیامت ہے اور قیامت بڑی سخت اور بہت تلخ ہے", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4893, "text": "بےشک گنہگار لوگ گمراہی اور دیوانگی میں (مبتلا) ہیں", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4894, "text": "اس روز منہ کے بل دوزخ میں گھسیٹے جائیں گے اب آگ کا مزہ چکھو", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4895, "text": "ہم نے ہر چیز اندازہٴ مقرر کے ساتھ پیدا کی ہے", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4896, "text": "اور ہمارا حکم تو آنکھ کے جھپکنے کی طرح ایک بات ہوتی ہے", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4897, "text": "اور ہم تمہارے ہم مذہبوں کو ہلاک کرچکے ہیں تو کوئی ہے کہ سوچے سمجھے؟", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4898, "text": "اور جو کچھ انہوں نے کیا، (ان کے) اعمال ناموں میں (مندرج) ہے", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4899, "text": "(یعنی) ہر چھوٹا اور بڑا کام لکھ دیا گیا ہے", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4900, "text": "جو پرہیزگار ہیں وہ باغوں اور نہروں میں ہوں گے", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4901, "text": "(یعنی) پاک مقام میں ہر طرح کی قدرت رکھنے والے بادشاہ کی بارگاہ میں", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 54, "name": "سُورَةُ القَمَرِ", "englishName": "Al-Qamar", "englishNameTranslation": "The Moon", "revelationType": "Meccan", "numberOfAyahs": 55, "ayahs": [{"number": 4847, "text": "Iqtarabatis Saa'atu wsan shaqqal qamar", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4848, "text": "Wa iny yaraw aayatany yu'ridoo wa yaqooloo sihrum mustamirr", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4849, "text": "Wa kazzaboo wattaba'ooo ahwaaa'ahum; wa kullu amrim mustaqirr", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4850, "text": "Wa laqad jaaa'ahum minal ambaaa'i maa feehi muzdajar", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4851, "text": "Hikmatum baalighatun famaa tughnin nuzur", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4852, "text": "Fatawalla 'anhum; yawma yad'ud daa'i ilaa shai 'in nukur", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4853, "text": "khushsha'an absaaruhum yakrujoona minal ajdaasi ka annahum jaraadum muntashir", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4854, "text": "Muhti'eena ilad daa'i yaqoolul kafiroona haazaa yawmun 'asir", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4855, "text": "Kazzabat qablahum qawmu Noohin fakazzaboo 'abdanaa wa qaaloo majnoo nunw wazdujir", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4856, "text": "Fada'aa Rabbahooo annee maghloobun fantasir", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4857, "text": "Fafatahnaaa abwaabas sa maaa'i bimaa'im munhamir", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4858, "text": "Wa fajjamal arda 'uyoonan faltaqal maaa'u 'alaaa amrin qad qudir", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4859, "text": "Wa hamalnaahu 'alaa zaati alwaahinw wa dusur", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4860, "text": "Tajree bi a'yuninaa jazaaa 'al liman kaana kufir", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4861, "text": "Wa laqat taraknaahaad aayatan fahal mim muddakir", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4862, "text": "Fakaifa kaana 'azaabee wa nuzur", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4863, "text": "Wa laqad yassamal Quraana liz zikri fahal mimmuddakir", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4864, "text": "Kazzabat 'Aadun fakaifa kaana 'azaabee wa nuzur", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4865, "text": "Innaa arsalnaa 'alaihim reehan sarsaran fee Yawmi nahsim mustamirr", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4866, "text": "Tanzi;un naasa ka anna huma'jaazu nakhlim munqa'ir", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4867, "text": "'Fakaifa kaana 'azaabee wa nuzur", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4868, "text": "Wa laqad yassamal Quraana liz zikri fahal mim muddakir", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4869, "text": "Kazzabat Samoodu binnuzur", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4870, "text": "Faqaalooo a-basharam minnaa waahidan nattabi'uhooo innaa izal lafee dalaalinw wa su'ur", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4871, "text": "'A-ulqiyaz zikru 'alaihi mim baininaa bal huwa kazzaabun ashir", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4872, "text": "Sa-ya'lamoona ghadam manil kazzaabul ashir", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4873, "text": "Innaa mursilun naaqati fitnatal lahum fartaqibhum wastabir", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4874, "text": "Wa nabbi'hum annal maaa'a qismatum bainahum kullu shirbim muhtadar", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4875, "text": "Fanaadaw saahibahum fata'aataa fa'aqar", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4876, "text": "Fakaifa kaana 'azaabee wa nuzur", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4877, "text": "Innaaa arsalnaa 'alaihim saihatanw waahidatan fakaano kahasheemil muhtazir", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4878, "text": "Wa laqad yassarnal quraana liz zikri fahal mim muddakir", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4879, "text": "Kazzabat qawmu lootim binnuzur", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4880, "text": "Innaa arsalnaa 'alaihim haasiban illaaa aala Loot najjainaahum bisahar", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4881, "text": "Ni'matam min 'indinaa; kazaalika najzee man shakar", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4882, "text": "Wa laqad anzarahum batshatanaa fatamaaraw binnuzur", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4883, "text": "Wa laqad raawadoohu 'andaifee fatamasnaaa a'yunahum fazooqoo 'azaabee wa nuzur", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4884, "text": "Wa laqad sabbahahum bukratan 'azaabum mustaqirr", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4885, "text": "Fazooqoo 'azaabee wa nuzur", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4886, "text": "Wa laqad yassarnal Quraana liz zikri fahal mim muddakir", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4887, "text": "Wa laqad jaaa'a Aala Fir'awnan nuzur", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4888, "text": "Kazzaboo bi Aayaatinaa kullihaa fa akhaznaahum akhza 'azeezim muqtadir", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4889, "text": "Akuffaarukum khairum min ulaaa'ikum am lakum baraaa'atun fiz Zubur", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4890, "text": "Am yaqooloona nahnu jamee'um muntasir", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4891, "text": "Sa yuhzamul jam'u wa yuwalloonad dubur", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4892, "text": "Balis Saa'atu maw'iduhum was Saa'atu adhaa wa amarr", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4893, "text": "Innal mujrimeena fee dalaalinw wa su'ur", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4894, "text": "Yawma yushaboona fin Naari'alaa wujoohimim zooqoo massa saqar", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4895, "text": "Innaa kulla shai'in khalaqnaahu biqadar", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4896, "text": "Wa maaa amrunaaa illaa waahidatun kalamhim bilbasar", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4897, "text": "Wa laqad ahlaknaaa ashyaa'akum fahal mim muddakir", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4898, "text": "Wa kullu shai'in fa'aloohu fiz Zubur", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4899, "text": "Wa kullu sagheerinw wa kabeerim mustatar", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4900, "text": "Innal muttaqeena fee jannaatinw wa nahar", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4901, "text": "Fee maq'adi sidqin 'inda Maleekim Muqtadir", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]