[{"number": 94, "name": "سُورَةُ الشَّرۡحِ", "englishName": "Ash-Sharh", "englishNameTranslation": "The Consolation", "revelationType": "Meccan", "numberOfAyahs": 8, "ayahs": [{"number": 6091, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6092, "text": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6093, "text": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6094, "text": "وَرَفَعْنَا لَكَ ذِكْرَكَ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6095, "text": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6096, "text": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6097, "text": "فَإِذَا فَرَغْتَ فَٱنصَبْ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6098, "text": "وَإِلَىٰ رَبِّكَ فَٱرْغَب", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 94, "name": "سُورَةُ الشَّرۡحِ", "englishName": "Ash-Sharh", "englishNameTranslation": "The Consolation", "revelationType": "Meccan", "numberOfAyahs": 8, "ayahs": [{"number": 6091, "text": "(اے محمدﷺ) کیا ہم نے تمہارا سینہ کھول نہیں دیا؟ (بےشک کھول دیا)", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6092, "text": "اور تم پر سے بوجھ بھی اتار دیا", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6093, "text": "جس نے تمہاری پیٹھ توڑ رکھی تھی", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6094, "text": "اور تمہارا ذکر بلند کیا", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6095, "text": "ہاں ہاں مشکل کے ساتھ آسانی بھی ہے", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6096, "text": "(اور) بے شک مشکل کے ساتھ آسانی ہے", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6097, "text": "تو جب فارغ ہوا کرو تو (عبادت میں) محنت کیا کرو", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6098, "text": "اور اپنے پروردگار کی طرف متوجہ ہو جایا کرو", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "ur.jalandhry", "language": "ur", "name": "جالندہری", "englishName": "Fateh Muhammad Jalandhry", "format": "text", "type": "translation", "direction": "rtl"}}, {"number": 94, "name": "سُورَةُ الشَّرۡحِ", "englishName": "Ash-Sharh", "englishNameTranslation": "The Consolation", "revelationType": "Meccan", "numberOfAyahs": 8, "ayahs": [{"number": 6091, "text": "Alam nashrah laka sadrak", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6092, "text": "Wa wa d'ana 'anka wizrak", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6093, "text": "Allazee anqada zahrak", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6094, "text": "Wa raf 'ana laka zikrak", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6095, "text": "Fa inna ma'al usri yusra", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6096, "text": "Inna ma'al 'usri yusra", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6097, "text": "Fa iza faragh ta fansab", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}, {"number": 6098, "text": "Wa ilaa rabbika far ghab", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 596, "ruku": 536, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "en.transliteration", "language": "en", "name": "Transliteration", "englishName": "English Transliteration", "format": "text", "type": "transliteration", "direction": "ltr"}}]